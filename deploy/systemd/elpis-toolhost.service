# deploy/systemd/elpis-toolhost.service — hôte d'outils (bacs Docker, fichiers, terminal, navigateur, Office) : gabarit rendu par « sudo ./elpis service install ».
[Unit]
Description=Elpis — toolhost
PartOf=@PREFIX@.target
After=network-online.target docker.service@AFTER_DB@
@WANTS_DB@

[Service]
Type=simple
@COMPTE@
# Jetons du navigateur des bacs : dossier d'exécution privé, vidé à l'arrêt, gardé d'une relance à l'autre.
RuntimeDirectory=@PREFIX@-toolhost
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
SyslogIdentifier=@PREFIX@-toolhost
WorkingDirectory=@WORKDIR@
@ENV@
@CLES@
Environment="ELPIS_RUNTIME_DIR=/run/@PREFIX@"
EnvironmentFile=-@ROOT@/.env
UnsetEnvironment=ELPIS_VAULT_KEY ELPIS_VAULT_KEY_PATH
InaccessiblePaths=-@VAULT_KEY_SYS@
InaccessiblePaths=-@VAULT_KEY_REPLI@
# Ni le secret de session ni la clé de chiffrement héritée : main et la console seuls s'en servent.
InaccessiblePaths=-@BASE@/.session_secret -@BASE@/.encryption_key
ExecStart=@EXEC@
# Relancé après SIGHUP (sortie 75) comme le core ; ses PTY sont tués à l'arrêt.
Restart=always
SuccessExitStatus=75
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

# Durcissement : ni espaces de noms, ni réglages du noyau, ni nom d'hôte protégés, ni setuid filtré (bubblewrap des aperçus Office monte un /proc neuf, essayé sous systemd), umask 022 (fichiers lus par le compte des bacs).
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/run/@PREFIX@
@RW@
ProtectHome=@PROTECT_HOME@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# 0022 sous un compte unique, 0007 en comptes séparés : le code pose lui-même les modes de ce qu'il partage avec les bacs.
UMask=@UMASK@
MemoryMax=50%
TasksMax=4096

[Install]
WantedBy=@PREFIX@.target
