[Unit]
Description=Elpis — hôte d'outils TS (MCP + sandbox + terminal + actifs)
After=network-online.target docker.service elpis-tools.service
Wants=network-online.target elpis-tools.service
Requires=docker.service

[Service]
Type=simple
User=elpis
WorkingDirectory=/opt/elpis
Environment=TOOLHOST_CONFIG=/opt/elpis/toolhost.json
Environment=TOOLHOST_LOG_LEVEL=info
Environment=ELPIS_RACINE=/opt/elpis
Environment=TOOLHOST_MCP_UPSTREAM=http://127.0.0.1:8767/mcp
ExecStart=/opt/elpis/node/bin/node --enable-source-maps --use-system-ca /opt/elpis/apps/toolhost/dist/main.mjs
Restart=always
SuccessExitStatus=75
RestartSec=3
# Les PTY et les sessions navigateur vivent dans CE processus : un seul ; ils sont fermés à l'arrêt.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
