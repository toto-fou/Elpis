[Unit]
Description=Elpis — elpis-tools (familles d'outils encore en Python, amont MCP de l'hôte d'outils)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# Familles relayées relues à chaque démarrage : relancé avec l'hôte (changement de familles_natives).
PartOf=elpis-toolhost.service

[Service]
Type=simple
User=elpis
WorkingDirectory=/opt/elpis
Environment=TOOLHOST_CONFIG=/opt/elpis/toolhost.json
Environment=ELPIS_RACINE=/opt/elpis
Environment=ELPIS_PYTHON=/opt/elpis/venv/bin/python
Environment=ELPIS_TOOLS_PORT=8767
# L'hôte lance server/local_mcp_server.py sur ses familles relayées, dans l'environnement de toolhost.json.
ExecStart=/opt/elpis/node/bin/node --enable-source-maps /opt/elpis/apps/toolhost/dist/main.mjs --elpis-tools
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
