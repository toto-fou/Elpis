#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# =============================================================================
#  elpis — configurer, lancer et diagnostiquer Elpis
# =============================================================================
#
#  ./elpis configure [options]   assistant par pages (LLM, cloud, HTTPS, RAG,
#                                sandbox, voix, base, compte admin) ; avec des
#                                options : sans assistant.  --yes = sans
#                                question ; --help = toutes les options
#  ./elpis start [--foreground]  démarre Qdrant, RAG, outils, app et admin (core
#                                Node, apps/core/dist/main.mjs) ; attend
#                                /api/health de main et admin (120 s au plus,
#                                ELPIS_ATTENTE_SANTE), sinon code non nul
#  ./elpis stop                  arrête les services lancés par « elpis start »
#                                (le core finit ses requêtes : 300 s au plus)
#  ./elpis restart               migrations en attente, puis stop et start
#  ./elpis status                état des services et des ports
#  ./elpis logs [SERVICE] [-f]   journaux (qdrant rag toolhost main admin)
#  ./elpis logs browser COMPTE [-f]  navigateur dans la sandbox du compte
#  ./elpis service install       services systemd (sudo), démarrage au boot
#  ./elpis service remove
#  ./elpis service print         affiche les unités sans rien installer
#  ./elpis doctor                diagnostic de l'installation
#  ./elpis backup [full|db|sandboxes|mcp]   sauvegarde dans backups/ (0600)
#  ./elpis upgrade [--no-backup] sauvegarde, git pull --ff-only, dépendances,
#                                core et hôte d'outils Node reconstruits,
#                                redémarrage (migrations au démarrage), doctor
#  ./elpis db info|check|transfer|use   base de données : état, test d'une
#                                cible, copie vers une base vide, choix du
#                                moteur (« ./elpis db use sqlite » = porte de
#                                sortie si le serveur de base est tombé)
#  sudo ./elpis vault setup      clé du coffre « Secrets » /etc/elpis/vault.key
#                                (0440, groupe de la clé du journal), jamais
#                                remplacée
#  ./elpis vault status          clé du coffre (source, kid) et secrets
#                                chiffrés par une autre clé
#  ./elpis vault rekey --from FICHIER   rechiffre avec la clé courante les
#                                secrets de l'ancienne clé FICHIER
#  ./elpis secret ls [--user COMPTE]   secrets du coffre : métadonnées seules
#  ./elpis audit verify [--from AAAA-MM-JJ] [--to AAAA-MM-JJ] [--key CHEMIN]
#                                vérifie le journal de sécurité : signatures,
#                                lignes manquantes, arrêts propres (0 = intègre)
# =============================================================================
set -uo pipefail
# « su » sans « - » garde le PATH de l'utilisateur, sans /usr/sbin ni /sbin :
# runuser, usermod… y seraient introuvables en root.
for d in /usr/local/sbin /usr/sbin /sbin; do
    case ":$PATH:" in *":$d:"*) ;; *) PATH="$PATH:$d" ;; esac
done
export PATH

ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$ROOT"
VENV="$ROOT/venv"
PY="$VENV/bin/python"
RUN_DIR="$ROOT/user_db/run"
LOG_DIR="$ROOT/logs"
SERVICES=(qdrant rag toolhost main admin)
# Services retirés : leurs unités systemd sont supprimées par « service install » et « service remove ».
SERVICES_RETIRES=(appmcp tools browser)
UNIT_PREFIX="elpis"
# Journal de sécurité (audit) et journal technique hors du dépôt (sudo ./elpis audit setup) ;
# ELPIS_PREFIXE_SYSTEME ne sert qu'aux essais (arborescence factice).
SYS_PREFIXE="${ELPIS_PREFIXE_SYSTEME:-}"
AUDIT_DIR_SYS="$SYS_PREFIXE/var/lib/elpis/audit"
AUDIT_KEY_SYS="$SYS_PREFIXE/etc/elpis/audit.key"
# Clé du coffre « Secrets » (sudo ./elpis vault setup), lue par le core (ELPIS_VAULT_KEY_PATH à défaut).
VAULT_KEY_SYS="$SYS_PREFIXE/etc/elpis/vault.key"
APPLOG_DIR_SYS="$SYS_PREFIXE/var/log/elpis"
GROUPE_JOURNAL="${ELPIS_GROUPE_JOURNAL:-elpis-journal}"
# Groupe de la clé de signature quand le groupe primaire du compte des services n'est pas le sien seul.
GROUPE_CLE="${ELPIS_GROUPE_CLE:-elpis-cle}"
NODE_DIR="$ROOT/node"
CORE_DIST="$ROOT/apps/core/dist"
HOTE_DIST="$ROOT/apps/toolhost/dist"
# shellcheck source=deploy/node/node.env
. "$ROOT/deploy/node/node.env"
# shellcheck source=deploy/prerequis-apt.sh
. "$ROOT/deploy/prerequis-apt.sh"
# shellcheck source=deploy/node/runtime.sh
. "$ROOT/deploy/node/runtime.sh"

MAIN_PORT=8001; ADMIN_PORT=8002; RAG_PORT=8000; MCP_PORT="${LOCAL_MCP_PORT:-8765}"
QDRANT_PORT=6333

info() { printf '\033[1;34m[elpis]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[ ok  ]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn ]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[err  ]\033[0m %s\n' "$*" >&2; exit 1; }
usage() { sed -n '/^#  \.\/elpis configure/,/^#                                lignes manquantes, arrêts propres/p' "$0" | sed 's/^# \{0,1\}//'; }

need_venv() { [ -x "$PY" ] || die "venv/ absent : lancez d'abord ./install.sh"; }
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3>&- 3<&-; return 0; }; return 1; }

# Node du core : ELPIS_NODE, sinon node/ (installé par install.sh), sinon celui du PATH.
node_bin() {
    if [ -n "${ELPIS_NODE:-}" ]; then echo "$ELPIS_NODE"
    elif [ -x "$NODE_DIR/bin/node" ]; then echo "$NODE_DIR/bin/node"
    else command -v node || echo node; fi
}
version_ge() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$2" ]; }
# Node 24.x, au moins NODE_MIN (shouldUpgradeCallback du relais WebSocket).
node_ok() {
    local v; v="$("$NODE" -v 2>/dev/null)" || return 1
    v="${v#v}"
    [ "${v%%.*}" = 24 ] && version_ge "$v" "$NODE_MIN"
}
need_core() {
    [ -f "$CORE_DIST/main.mjs" ] || die "Core non construit ($CORE_DIST/main.mjs absent) : ./install.sh, ou ./install.sh --offline <paquet de cette version>"
    node_ok || die "Node.js « $("$NODE" -v 2>/dev/null || echo "$NODE absent") » : le core demande Node 24.x, $NODE_MIN au moins (./install.sh installe $NODE_VERSION dans node/, ou ELPIS_NODE=chemin)."
}
# Commandes d'exploitation du core (sauvegarde…) : bundle construit et Node 24.
need_exploitation() {
    [ -f "$CORE_DIST/exploitation.mjs" ] || die "Core non construit ($CORE_DIST/exploitation.mjs absent) : ./install.sh, ou ./install.sh --offline <paquet de cette version>"
    node_ok || die "Node.js « $("$NODE" -v 2>/dev/null || echo "$NODE absent") » : le core demande Node 24.x, $NODE_MIN au moins (./install.sh installe $NODE_VERSION dans node/, ou ELPIS_NODE=chemin)."
}
# Commande d'exploitation du core (natif, migrations, empreinte, backup…), avec la configuration des services.
core_cmd() {
    local e=("ELPIS_RACINE=$ROOT")
    [ -n "${SANDBOX_DIR:-}" ] && e+=("APP_SANDBOX_DIR=$SANDBOX_DIR")
    env "${e[@]}" "$NODE" "$CORE_DIST/exploitation.mjs" "$@"
}
# lanceur QUESTION : réglage lu par le core dans config.json et l'environnement (exploitation.mjs lanceur) ; rien si le core n'est pas construit.
lanceur() {
    [ -f "$CORE_DIST/exploitation.mjs" ] || return 0
    ELPIS_RACINE="$ROOT" "${NODE:-$(node_bin)}" "$CORE_DIST/exploitation.mjs" lanceur "$1" 2>/dev/null \
        || warn "Le core ne répond pas pour « $1 » (bundle d'une autre version ? ./install.sh) : valeur par défaut."
}
# Autorités de confiance de .env : SSL_CERT_FILE avec un certificat, sinon un seul dossier SSL_CERT_DIR (--use-system-ca ne lit pas de liste) aux noms hachés.
ca_ok() {
    if [ -n "${SSL_CERT_FILE:-}" ]; then grep -q -- '-----BEGIN CERTIFICATE-----' "$SSL_CERT_FILE"; return; fi
    case "${SSL_CERT_DIR:-}" in *:*) return 1 ;; esac
    compgen -G "${SSL_CERT_DIR:-}/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].[0-9]*" >/dev/null
}

# =============================================================================
#  configure
# =============================================================================
cmd_configure() {
    need_venv
    # Sans option, dans un terminal : assistant par pages (deploy/wizard.py) —
    # toutes les réponses d'abord, puis application sans question. Avec des
    # options, ou sans terminal : deploy/configure.py directement
    # (« ./elpis configure --help »).
    if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
        local ans="$ROOT/user_db/run/configure-answers.json" rc
        mkdir -p "$ROOT/user_db/run" && chmod 700 "$ROOT/user_db" "$ROOT/user_db/run"
        (
            # Le fichier de réponses porte des secrets : supprimé quoi qu'il arrive.
            trap 'rm -f "$ans"' EXIT
            "$PY" "$ROOT/deploy/wizard.py" configure --out "$ans"
            rc=$?
            case $rc in
                0) "$PY" "$ROOT/deploy/configure.py" --answers "$ans" ;;
                1) info "Rien n'a été modifié." ;;
                *) exit 3 ;;
            esac
        )
        rc=$?
        [ "$rc" -ne 3 ] && return "$rc"
        warn "Assistant indisponible dans ce terminal : questions en lignes."
    fi
    "$PY" "$ROOT/deploy/configure.py" "$@"
}

# =============================================================================
#  Définition des services (commande, dossier, environnement)
# =============================================================================
_bind_default() {
    # Même règle que le core (apps/core/src/ecoute.ts) : HTTPS → 127.0.0.1 ;
    # config absente ou illisible → 127.0.0.1 ; security.listen « lan » →
    # 0.0.0.0, « local » → 127.0.0.1 ; clé absente (config d'avant le
    # réglage) → 0.0.0.0. Core non construit : 127.0.0.1.
    local h; h="$(lanceur ecoute)"
    case "$h" in 0.0.0.0|127.0.0.1) echo "$h" ;; *) echo 127.0.0.1 ;; esac
}

# HTTPS actif (frontal Caddy) ? Distinct du bind : « listen local » donne aussi
# 127.0.0.1 sans Caddy.
_https_enabled() { [ "$(lanceur https)" = oui ]; }

# svc_spec NOM → définit SPEC_DIR, SPEC_CMD (tableau), SPEC_ENV (tableau K=V), SPEC_LANCEUR (préfixe de relance, hors systemd)
svc_spec() {
    SPEC_DIR="$ROOT"; SPEC_CMD=(); SPEC_ENV=("PYTHONDONTWRITEBYTECODE=1"); SPEC_LANCEUR=()
    local mcp_url="http://127.0.0.1:${MCP_PORT}/mcp"
    case "$1" in
        qdrant)
            SPEC_DIR="$ROOT/rag_app/qdrant"
            SPEC_CMD=("$ROOT/rag_app/qdrant/qdrant" --config-path "$ROOT/rag_app/qdrant/config.yaml") ;;
        rag)
            # Extracteur : seul le core l'appelle, en local (RAG_HOST pour un core sur une autre machine).
            SPEC_DIR="$ROOT/rag_app"
            SPEC_ENV+=("RAG_STORE_DIR=$RAG_STORE" "RAG_CACHE_DIR=$RAG_CACHE" "RAG_SERVICE_TOKEN_FILE=$ROOT/user_db/.rag_service_token")
            SPEC_CMD=("$VENV/bin/uvicorn" app:app --host "${RAG_HOST:-127.0.0.1}" --port "$RAG_PORT") ;;
        toolhost)
            SPEC_ENV+=(LOCAL_MCP_TRANSPORT=streamable-http "LOCAL_MCP_HOST=${LOCAL_MCP_HOST:-127.0.0.1}"
                       "LOCAL_MCP_PORT=$MCP_PORT" "APP_SANDBOX_DIR=$SANDBOX_DIR" "CHART_CACHE_DIR=$CHART_DIR")
            # Rappels de l'hôte vers le core local (shell_job, identifiants git, PR, quota, notifications).
            SPEC_ENV+=("ELPIS_RACINE=$ROOT" "TOOLHOST_APP_URL=${TOOLHOST_APP_URL:-http://127.0.0.1:$MAIN_PORT}" APP_SERVICE=toolhost)
            SPEC_LANCEUR=(bash "$ROOT/deploy/node/relance.sh")
            SPEC_CMD=("$NODE" --enable-source-maps --use-system-ca "$HOTE_DIST/main.mjs") ;;
        main)
            SPEC_ENV+=(ENABLE_CLI=1 APP_MODE=main APP_SERVICE=main "ELPIS_RACINE=$ROOT" "LOCAL_MCP_URL=$mcp_url"
                       "APP_SANDBOX_DIR=$SANDBOX_DIR" "MAIN_INTERNAL_URL=http://127.0.0.1:$MAIN_PORT"
                       "CHART_CACHE_DIR=$CHART_DIR" "RAG_STORE_DIR=$RAG_STORE"
                       "ADMIN_PUBLIC_URL=${ADMIN_PUBLIC_URL:-http://localhost:$ADMIN_PORT/admin}")
            SPEC_LANCEUR=(bash "$ROOT/deploy/node/relance.sh")
            SPEC_CMD=("$NODE" --enable-source-maps --use-system-ca "$CORE_DIST/main.mjs") ;;
        admin)
            SPEC_ENV+=(APP_MODE=admin APP_SERVICE=admin "ELPIS_RACINE=$ROOT" "LOCAL_MCP_URL=$mcp_url"
                       "APP_SANDBOX_DIR=$SANDBOX_DIR" "MAIN_INTERNAL_URL=http://127.0.0.1:$MAIN_PORT"
                       "CHART_CACHE_DIR=$CHART_DIR" "RAG_STORE_DIR=$RAG_STORE" "MAIN_PUBLIC_URL=${MAIN_PUBLIC_URL:-http://localhost:$MAIN_PORT/}")
            SPEC_LANCEUR=(bash "$ROOT/deploy/node/relance.sh")
            SPEC_CMD=("$NODE" --enable-source-maps --use-system-ca "$CORE_DIST/main.mjs") ;;
        *) die "service inconnu : $1" ;;
    esac
    env_journaux "$1"
}

# Dossiers système du journal de sécurité et du journal technique, s'ils sont en place :
# root (unités systemd) ou compte qui peut y écrire (démarrage manuel). Sinon : repli dans le dépôt.
env_journaux() {
    case "$1" in main|admin|toolhost) ;; *) return 0 ;; esac
    local d v
    for v in "ELPIS_AUDIT_DIR=$AUDIT_DIR_SYS" "ELPIS_APP_LOG_DIR=$APPLOG_DIR_SYS"; do
        d="${v#*=}"
        if [ -d "$d" ] && { [ "$(id -u)" -eq 0 ] || [ -w "$d" ]; }; then SPEC_ENV+=("$v"); fi
    done
}

# Base PostgreSQL réglée sur cette machine (config.json / APP_DB_*).
_db_postgres_local() { [ "$(lanceur postgres-local)" = oui ]; }

# Sauvegarde distante active par scp ou rsync (config.json, backup.remote).
_sauvegarde_ssh() { [ "$(lanceur sauvegarde-ssh)" = oui ]; }

# Groupe de deploy/prerequis-apt.txt dont cette installation se sert.
apt_groupe_sert() {
    case "$1" in
        socle) return 0 ;;
        sandbox) command -v docker >/dev/null 2>&1 || command -v dockerd >/dev/null 2>&1 ;;
        apercus-office) command -v soffice >/dev/null 2>&1 ;;
        construction-hote) [ -d "$ROOT/node_modules" ] ;;
        https) _https_enabled ;;
        postgresql-local) _db_postgres_local ;;
        sauvegarde-distante) _sauvegarde_ssh ;;
        *) return 1 ;;
    esac
}

# Serveur de base sur CETTE machine (config.json / APP_DB_*) → son unité
# systemd, que main, admin et l'hôte d'outils attendent au démarrage.
_db_local_unit() { lanceur unite-base; }

# Migrations de mcp.json sans question (relais, familles manquantes, familles du compte servies en processus par le core).
migrer_mcp() { "$PY" "$ROOT/deploy/configure.py" --migrer-mcp || warn "mcp.json non migré : ./elpis configure"; }

svc_available() {
    case "$1" in
        qdrant)  [ -x "$ROOT/rag_app/qdrant/qdrant" ] ;;
        toolhost) [ -f "$HOTE_DIST/main.mjs" ] ;;
        main|admin) [ -f "$CORE_DIST/main.mjs" ] ;;
        *)       return 0 ;;
    esac
}

svc_port() {
    case "$1" in
        qdrant) echo "$QDRANT_PORT" ;; rag) echo "$RAG_PORT" ;; toolhost) echo "$MCP_PORT" ;;
        main) echo "$MAIN_PORT" ;; admin) echo "$ADMIN_PORT" ;;
    esac
}

# .env : surcharges locales facultatives (KEY=VALUE, une par ligne), puis les ports qui en dépendent.
# Lu comme des données, jamais sourcé : clé validée, valeur littérale (ni substitution ni commande), guillemets de bordure retirés.
charger_env() {
    [ -f "$ROOT/.env" ] || return 0
    local ligne cle val
    while IFS= read -r ligne || [ -n "$ligne" ]; do
        ligne="${ligne%$'\r'}"
        ligne="${ligne#"${ligne%%[![:space:]]*}"}"
        case "$ligne" in ''|'#'*) continue ;; esac
        ligne="${ligne#export[[:space:]]}"
        ligne="${ligne#"${ligne%%[![:space:]]*}"}"
        case "$ligne" in *=*) ;; *) continue ;; esac
        cle="${ligne%%=*}"; val="${ligne#*=}"
        cle="${cle%"${cle##*[![:space:]]}"}"
        [[ "$cle" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        val="${val#"${val%%[![:space:]]*}"}"
        val="${val%"${val##*[![:space:]]}"}"
        if [[ "$val" =~ ^\"([^\"]*)\"([[:space:]]+#.*)?$ ]] || [[ "$val" =~ ^\'([^\']*)\'([[:space:]]+#.*)?$ ]]; then
            val="${BASH_REMATCH[1]}"
        else
            val="${val%%[[:space:]]#*}"; val="${val%"${val##*[![:space:]]}"}"
        fi
        export "$cle=$val"
    done < "$ROOT/.env"
}

# Instance : config.json, .env, Node, écoute et dossiers, lus par le core (sans le venv).
charger_instance() {
    [ -f "$ROOT/config.json" ] || die "config.json absent : lancez ./elpis configure"
    charger_env
    NODE="$(node_bin)"
    BIND_DEFAULT="$(_bind_default)"
    SANDBOX_DIR="${APP_SANDBOX_DIR:-}"
    if [ -z "$SANDBOX_DIR" ] && [ -f "$CORE_DIST/exploitation.mjs" ]; then
        SANDBOX_DIR="$(core_cmd config SANDBOX_DIR 2>/dev/null)" \
            || die "Dossier des sandboxes illisible par le core (bundle d'une autre version, ou Node inutilisable) : ./install.sh, ou ./install.sh --offline <paquet de cette version>"
    fi
    [ -n "$SANDBOX_DIR" ] || SANDBOX_DIR="$ROOT/user_sandboxes"
    # Cache des graphiques : écrit par le core, relu par l'hôte d'outils ; un même dossier privé pour tous.
    CHART_DIR="${CHART_CACHE_DIR:-$RUN_DIR/charts}"
    mkdir -p "$SANDBOX_DIR" "$RUN_DIR" "$LOG_DIR" "$ROOT/user_db/logs"
    dossiers_rag
}

# Magasin du RAG (lu par le core et l'extracteur, le même pour les deux) et cache de l'extracteur, calculés par le core.
dossiers_rag() {
    RAG_STORE="${RAG_STORE_DIR:-}"; RAG_CACHE="${RAG_CACHE_DIR:-}"
    if [ -f "$CORE_DIST/exploitation.mjs" ]; then
        [ -n "$RAG_STORE" ] || RAG_STORE="$(core_cmd config RAG_STORE_DIR 2>/dev/null)" || RAG_STORE=""
        [ -n "$RAG_CACHE" ] || RAG_CACHE="$(core_cmd config RAG_CACHE_DIR 2>/dev/null)" || RAG_CACHE=""
    fi
    [ -n "$RAG_STORE" ] || RAG_STORE="$ROOT/user_db/rag"
    [ -n "$RAG_CACHE" ] || RAG_CACHE="${RAG_STORE%/}-cache"
    # Sous root (service install), jamais : un dossier créé par root serait illisible pour le compte des services.
    if [ "$(id -u)" -ne 0 ]; then mkdir -p -m 700 "$RAG_STORE" "$RAG_CACHE" 2>/dev/null || true; fi
}

# Services : le venv sert encore au RAG, au moteur Office de l'hôte d'outils et à l'installation.
load_runtime() {
    need_venv
    charger_instance
}

pid_of() { local f="$RUN_DIR/$1.pid"; [ -s "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null && cat "$f"; }

# PID à signaler, lu dans user_db/run (écrit par le compte des services) : nombre > 1 ; en root, processus du compte des services, du propriétaire du dépôt ou de COMPTES_ARRET, jamais de root.
pid_signalable() {
    local uid u
    [[ $1 =~ ^[0-9]{1,9}$ ]] && [ "$1" -gt 1 ] || return 1
    [ "$(id -u)" -eq 0 ] || return 0
    uid="$(awk '$1 == "Uid:" { print $2; exit }' "/proc/$1/status" 2>/dev/null)"
    [ -n "$uid" ] && [ "$uid" != 0 ] || return 1
    for u in $(compte_services) "$(stat -c %U -- "$ROOT")" ${COMPTES_ARRET:-}; do
        [ "$uid" = "$(id -u "$u" 2>/dev/null)" ] && return 0
    done
    return 1
}

systemd_active() { command -v systemctl >/dev/null && systemctl is-active --quiet "${UNIT_PREFIX}.target" 2>/dev/null; }
systemd_installed() { [ -f "/etc/systemd/system/${UNIT_PREFIX}.target" ]; }

wait_port() {
    local port="$1" n="${2:-40}"
    for _ in $(seq 1 "$n"); do port_open "$port" && return 0; sleep 0.5; done
    return 1
}

# attendre SERVICE SECONDES COMMANDE… : réussit dès que la commande réussit ; échoue au délai, ou dès que le service s'arrête.
attendre() {
    local s="$1" fin=$((SECONDS + $2)); shift 2
    until "$@" >/dev/null 2>&1; do
        { pid_of "$s" >/dev/null && [ "$SECONDS" -lt "$fin" ]; } || return 1
        sleep 0.5
    done
}

# Santé de main et admin (/api/health) sous ELPIS_ATTENTE_SANTE secondes (120) ; sinon la fin de leur journal et un code non nul.
attendre_sante() {
    local s port rc=0 fin=$((SECONDS + ${ELPIS_ATTENTE_SANTE:-120}))
    for s in main admin; do
        port="$(svc_port "$s")"
        attendre "$s" "$((fin - SECONDS))" curl --noproxy '*' -fsS -m 2 -o /dev/null "http://127.0.0.1:$port/api/health" && continue
        if pid_of "$s" >/dev/null; then
            warn "$s ne répond pas sur /api/health (port $port) après ${ELPIS_ATTENTE_SANTE:-120} s. Fin de son journal ($LOG_DIR/$s.log) :"
        else
            warn "$s s'est arrêté sans répondre sur /api/health (port $port). Fin de son journal ($LOG_DIR/$s.log) :"
        fi
        tail -n 20 "$LOG_DIR/$s.log" 2>/dev/null | sed 's/^/    /' >&2
        rc=1
    done
    [ "$rc" -eq 0 ] && ok "main et admin répondent (/api/health)."
    return "$rc"
}

# =============================================================================
#  start / stop / status / logs
# =============================================================================
# Journal d'un service hors systemd : au-delà de 64 Mio, renommé en .1 (3 anciens gardés) avant le démarrage.
tourner_journal() {
    local f="$1" i
    [ -f "$f" ] || return 0
    [ "$(stat -c %s "$f" 2>/dev/null || echo 0)" -gt $((64 * 1024 * 1024)) ] || return 0
    for i in 2 1; do [ -f "$f.$i" ] && mv -f "$f.$i" "$f.$((i + 1))"; done
    mv -f "$f" "$f.1"
}

cmd_start() {
    local foreground=0
    [ "${1:-}" = "--foreground" ] && foreground=1
    systemd_active && die "Les services systemd ${UNIT_PREFIX}.target tournent déjà (systemctl status ${UNIT_PREFIX}.target)."
    load_runtime
    need_core
    [ -f "$ROOT/deploy/node/relance.sh" ] || die "deploy/node/relance.sh absent (mise à jour incomplète) : ./install.sh, ou ./install.sh --offline <paquet de cette version>"
    migrer_mcp
    local s started=() retirer=()
    for s in "${SERVICES[@]}"; do
        if ! svc_available "$s"; then warn "$s non installé : ignoré."; continue; fi
        if pid_of "$s" >/dev/null; then info "$s tourne déjà (pid $(pid_of "$s"))."; continue; fi
        svc_spec "$s"
        tourner_journal "$LOG_DIR/$s.log"
        info "Démarrage de $s…"
        case "$s" in main|admin) retirer=() ;; *) retirer=(-u ELPIS_VAULT_KEY -u ELPIS_VAULT_KEY_PATH) ;; esac
        ( cd "$SPEC_DIR" && exec env ${retirer[@]+"${retirer[@]}"} "${SPEC_ENV[@]}" setsid ${SPEC_LANCEUR[@]+"${SPEC_LANCEUR[@]}"} "${SPEC_CMD[@]}" ) \
            >>"$LOG_DIR/$s.log" 2>&1 </dev/null &
        echo $! > "$RUN_DIR/$s.pid"
        started+=("$s")
        # Les suivants dépendent de Qdrant et de l'hôte d'outils : on les attend.
        case "$s" in
            qdrant|toolhost) attendre "$s" 20 port_open "$(svc_port "$s")" || warn "$s ne répond pas encore (voir ./elpis logs $s)." ;;
        esac
    done
    local rc=0
    attendre_sante || rc=1
    cmd_status
    local host="localhost"
    if _https_enabled; then
        info "Mode HTTPS : accès par le frontal Caddy (https://<hôte>/)."
    else
        info "Application : http://$host:$MAIN_PORT/   Administration : http://$host:$ADMIN_PORT/admin"
        [ "$BIND_DEFAULT" = "127.0.0.1" ] && info "Écoute locale (security.listen) : joignable depuis ce serveur seulement."
    fi
    if [ "$foreground" -eq 1 ]; then
        [ "$rc" -eq 0 ] || { cmd_stop; return 1; }
        trap 'cmd_stop; exit 0' INT TERM
        info "Premier plan : Ctrl-C arrête tout."
        while :; do sleep 5; done
    fi
    return "$rc"
}

# tuer_fils PID : SIGKILL aux groupes des fils directs (le core lancé par relance.sh a son propre groupe).
tuer_fils() {
    local c
    for c in $(cat /proc/"$1"/task/*/children 2>/dev/null || pgrep -P "$1" 2>/dev/null); do
        pid_signalable "$c" || continue
        kill -KILL -- "-$c" 2>/dev/null || kill -KILL "$c" 2>/dev/null
    done
}

# arreter SERVICE… : SIGTERM à chacun, attente commune (310 s si le core en est, 20 s sinon), SIGKILL au-delà.
arreter() {
    local s i n pid vivant attente=40 pids=() noms=()
    for s in "$@"; do
        pid="$(pid_of "$s")" || { rm -f "$RUN_DIR/$s.pid"; continue; }
        if ! pid_signalable "$pid"; then warn "$s : pid « $pid » de $RUN_DIR/$s.pid hors des comptes d'Elpis : non signalé (à vérifier)."; continue; fi
        info "Arrêt de $s (pid $pid)…"
        kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
        pids+=("$pid"); noms+=("$s")
        case "$s" in main|admin) attente=620 ;; esac
    done
    for (( n=1; n<=attente; n++ )); do
        vivant=0
        for pid in "${pids[@]}"; do kill -0 "$pid" 2>/dev/null && vivant=1; done
        [ "$vivant" -eq 1 ] || break
        [ "$n" -eq 20 ] && [ "$attente" -gt 40 ] && info "Le core finit ses requêtes en cours (300 s au plus)…"
        sleep 0.5
    done
    for i in "${!pids[@]}"; do
        pid="${pids[$i]}"
        case "${noms[$i]}" in main|admin) kill -0 "$pid" 2>/dev/null && tuer_fils "$pid" ;; esac
        kill -0 "$pid" 2>/dev/null && { kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null; }
        rm -f "$RUN_DIR/${noms[$i]}.pid"
    done
}

# Le core d'abord, main et admin ensemble : outils et RAG servent encore pendant qu'il finit.
cmd_stop() {
    local i s
    arreter main admin
    for (( i=${#SERVICES[@]}-1; i>=0; i-- )); do
        s="${SERVICES[$i]}"
        case "$s" in main|admin) ;; *) arreter "$s" ;; esac
    done
    arreter "${SERVICES_RETIRES[@]}"
    ok "Services arrêtés."
}

# Migrations de la base vues par le core : celles en attente s'appliquent au démarrage.
cmd_migrations() {
    local out rc
    [ -f "$CORE_DIST/exploitation.mjs" ] || { warn "Base : core non construit, migrations non vérifiées."; return 0; }
    out="$(core_cmd migrations 2>&1)"; rc=$?
    case "$rc" in
        0) info "Base : $out" ;;
        *) warn "Base : ${out:-vérification impossible}" ;;
    esac
    return 0
}

cmd_status() {
    local s pid port state
    charger_env
    if systemd_active; then info "Géré par systemd (${UNIT_PREFIX}.target)."; fi
    printf '  %-10s %-8s %-7s %s\n' SERVICE PID PORT ÉTAT
    for s in "${SERVICES[@]}"; do
        pid="$(pid_of "$s" || true)"; port="$(svc_port "$s")"
        if ! svc_available "$s"; then state="non installé"
        elif port_open "$port"; then state="à l'écoute"
        elif [ -n "$pid" ]; then state="démarrage…"
        else state="arrêté"; fi
        printf '  %-10s %-8s %-7s %s\n' "$s" "${pid:--}" "$port" "$state"
    done
}

cmd_logs() {
    local svc="" compte="" follow=0 a c
    for a in "$@"; do
        case "$a" in -f|--follow) follow=1 ;; *) if [ -z "$svc" ]; then svc="$a"; else compte="$a"; fi ;; esac
    done
    # ./elpis logs browser COMPTE : journal du service navigateur dans le bac du compte (le seul navigateur).
    if [ "$svc" = browser ]; then
        [ -n "$compte" ] || die "Le navigateur tourne dans la sandbox de chaque compte : ./elpis logs browser COMPTE [-f]."
        c="$(docker ps -q --filter "label=elpis.username=$compte" | head -n1)"
        [ -n "$c" ] || die "Aucun bac en marche pour le compte $compte."
        # Journal écrit dans le bac (hostile) : caractères de contrôle et séquences C1 retirés avant le terminal (tabulation et fin de ligne gardées).
        docker exec "$c" tail -n 50 $([ "$follow" -eq 1 ] && echo -F) /work/.elpis-browser/service.log \
            | LC_ALL=C sed -u -e 's/[\x00-\x08\x0b-\x1f\x7f]//g' -e 's/\xc2[\x80-\x9f]//g'
        exit "${PIPESTATUS[0]}"
    fi
    if systemd_active && [ -n "$svc" ]; then
        exec journalctl -u "${UNIT_PREFIX}-$svc" $([ "$follow" -eq 1 ] && echo -f)
    fi
    local files=()
    if [ -n "$svc" ]; then files=("$LOG_DIR/$svc.log"); else files=("$LOG_DIR"/*.log); fi
    [ -e "${files[0]}" ] || die "Aucun journal dans $LOG_DIR."
    if [ "$follow" -eq 1 ]; then exec tail -n 50 -F "${files[@]}"; else tail -n 50 "${files[@]}"; fi
}

# =============================================================================
#  service install / remove (systemd)
# =============================================================================
# _render_units DOSSIER UTILISATEUR → écrit les unités, remplit UNITS_WANTS
_render_units() {
    local unit_dir="$1" run_user="$2" s e w repli
    UNITS_WANTS=()
    load_runtime
    need_core
    local db_unit; db_unit="$(_db_local_unit)"
    repli="$(core_cmd config DB_PATH 2>/dev/null)"; repli="${repli:-$ROOT/user_db/app.db}"; repli="${repli%/*}/.vault.key"
    for s in "${SERVICES[@]}"; do
        svc_available "$s" || { warn "$s non installé : pas d'unité."; continue; }
        svc_spec "$s"
        {
            echo "[Unit]"
            echo "Description=Elpis — $s"
            echo "PartOf=${UNIT_PREFIX}.target"
            case "$s" in
                rag)        echo "After=${UNIT_PREFIX}-qdrant.service" ;;
                toolhost)   echo "After=network-online.target docker.service${db_unit:+ $db_unit}" ;;
                main|admin) echo "After=${UNIT_PREFIX}-toolhost.service ${UNIT_PREFIX}-rag.service caddy.service${db_unit:+ $db_unit}" ;;
            esac
            case "$s" in
                toolhost|main|admin) if [ -n "$db_unit" ]; then echo "Wants=$db_unit"; fi ;;
            esac
            echo
            echo "[Service]"
            echo "Type=simple"
            echo "User=$run_user"
            # Identifiant syslog du service (journald, rsyslog) au lieu de « node » ou « uvicorn ».
            echo "SyslogIdentifier=${UNIT_PREFIX}-$s"
            echo "WorkingDirectory=$SPEC_DIR"
            for e in "${SPEC_ENV[@]}"; do printf 'Environment="%s"\n' "$e"; done
            echo "EnvironmentFile=-$ROOT/.env"
            case "$s" in
                main|admin) ;;
                *) echo "UnsetEnvironment=ELPIS_VAULT_KEY ELPIS_VAULT_KEY_PATH"
                   echo "InaccessiblePaths=-$VAULT_KEY_SYS"
                   echo "InaccessiblePaths=-$repli" ;;
            esac
            printf 'ExecStart='; printf '%q ' "${SPEC_CMD[@]}"; echo
            # Core : relancé après SIGHUP (sortie 75, tenue pour un succès) ; 310 s = 300 s de générations + 5 s de fermeture forcée.
            # Hôte d'outils : relancé après SIGHUP (sortie 75) comme le core ; ses PTY sont tués à l'arrêt.
            case "$s" in
                main|admin|toolhost) echo "Restart=always"; echo "SuccessExitStatus=75" ;;
                *)       echo "Restart=on-failure" ;;
            esac
            echo "RestartSec=3"
            echo "KillMode=mixed"
            case "$s" in
                main|admin) echo "KillSignal=SIGTERM"; echo "TimeoutStopSec=310" ;;
                *)          echo "TimeoutStopSec=30" ;;
            esac
            echo
            echo "[Install]"
            echo "WantedBy=${UNIT_PREFIX}.target"
        } > "$unit_dir/${UNIT_PREFIX}-$s.service"
        UNITS_WANTS+=("${UNIT_PREFIX}-$s.service")
    done
    # Unités installées à côté : Caddy (apt, --with-caddy) quand HTTPS est
    # actif, moteur vocal local (deploy/voice). Démarrées et arrêtées avec
    # le reste, sans qu'on écrive leurs fichiers.
    local extra=()
    if _https_enabled && [ -f /lib/systemd/system/caddy.service ]; then extra+=(caddy.service); fi
    [ -f /etc/systemd/system/elpis-whisper.service ] && extra+=(elpis-whisper.service)
    [ -f /etc/systemd/system/elpis-tts.service ] && extra+=(elpis-tts.service)
    {
        echo "[Unit]"
        echo "Description=Elpis (tous les services)"
        echo "Wants=${UNITS_WANTS[*]} ${extra[*]}"
        echo "After=network-online.target"
        echo
        echo "[Install]"
        echo "WantedBy=multi-user.target"
    } > "$unit_dir/${UNIT_PREFIX}.target"
}

cmd_service() {
    local action="${1:-}" unit_dir=/etc/systemd/system s
    if [ "$action" = "print" ]; then
        local tmp; tmp="$(mktemp -d)"
        _render_units "$tmp" "${ELPIS_USER:-$(id -un)}"
        for s in "$tmp"/*; do echo "### $(basename "$s")"; cat "$s"; echo; done
        rm -rf "$tmp"
        return 0
    fi
    [ "$(id -u)" -eq 0 ] || die "Lancez avec sudo : sudo ./elpis service ${action:-install}"
    command -v systemctl >/dev/null || die "systemd absent."
    case "$action" in
        install)
            # Unités en place : leur compte reste celui par défaut, invite comprise ; ELPIS_USER (ou un nom tapé) pour en changer.
            local unite run_user ans ancien
            unite="$(compte_services)"
            run_user="${ELPIS_USER:-${unite:-${SUDO_USER:-}}}"
            if [ -z "${ELPIS_USER:-}" ] && [ -t 0 ]; then
                read -r -p "  Utilisateur qui fera tourner les services [${run_user:-?}] : " ans || ans=""
                run_user="${ans:-$run_user}"
            fi
            if [ -n "$unite" ] && [ "$run_user" != "$unite" ]; then info "Compte des services : $unite → $run_user."; fi
            [ -n "$run_user" ] && [ "$run_user" != root ] \
                || die "Utilisateur de service inconnu : lancez via sudo depuis votre compte, ou ELPIS_USER=nom."
            id "$run_user" >/dev/null 2>&1 || die "Utilisateur $run_user inexistant (créez-le, ou ELPIS_USER=nom)."
            # Il doit lire le dépôt et piloter Docker (sandbox).
            sudo -u "$run_user" test -r "$ROOT/config.json" \
                || die "$run_user ne peut pas lire $ROOT/config.json : choisissez le propriétaire du dépôt."
            if getent group docker >/dev/null && ! id -nG "$run_user" | tr ' ' '\n' | grep -qx docker; then
                warn "Le groupe docker équivaut à root sur l'hôte : $run_user en deviendra membre. Machine dédiée conseillée (SECURITY.md)."
                usermod -aG docker "$run_user" && info "$run_user ajouté au groupe docker."
            fi
            ancien="$unite $(stat -c %U -- "$AUDIT_DIR_SYS" 2>/dev/null)"
            audit_setup "$run_user" "$ancien" 0 \
                || warn "Journal de sécurité incomplet (voir ci-dessus) : sudo ./elpis audit setup une fois corrigé."
            _render_units "$unit_dir" "$run_user"
            for s in "${SERVICES[@]}" "${SERVICES_RETIRES[@]}"; do
                case " ${UNITS_WANTS[*]} " in *" ${UNIT_PREFIX}-$s.service "*) continue ;; esac
                [ -f "$unit_dir/${UNIT_PREFIX}-$s.service" ] || continue
                systemctl disable --now "${UNIT_PREFIX}-$s.service" >/dev/null 2>&1 || true
                rm -f "$unit_dir/${UNIT_PREFIX}-$s.service"
            done
            chown -R "$run_user" "$ROOT/user_db" "$LOG_DIR" 2>/dev/null || true
            install -d -m 700 -o "$run_user" "$RAG_STORE" "$RAG_CACHE" 2>/dev/null \
                || warn "Dossiers du RAG ($RAG_STORE, $RAG_CACHE) non préparés pour $run_user."
            systemctl daemon-reload
            systemctl enable "${UNITS_WANTS[@]}" "${UNIT_PREFIX}.target" >/dev/null
            # Les processus lancés à la main laisseraient les ports occupés ; le core peut prendre 300 s.
            COMPTES_ARRET="$ancien $run_user" cmd_stop || true
            if compgen -G "$ROOT/logs/audit/audit-*.jsonl" >/dev/null; then
                systemctl stop "${UNIT_PREFIX}.target" >/dev/null 2>&1 || true
                audit_deplacer "$run_user" || warn "Fichiers de logs/audit non déplacés (voir ci-dessus)."
            fi
            systemctl restart "${UNIT_PREFIX}.target"
            ok "Services installés et démarrés (utilisateur $run_user) : systemctl status ${UNIT_PREFIX}.target"
            ;;
        remove)
            systemctl disable --now "${UNIT_PREFIX}.target" >/dev/null 2>&1 || true
            for s in "${SERVICES[@]}" "${SERVICES_RETIRES[@]}"; do
                systemctl disable --now "${UNIT_PREFIX}-$s.service" >/dev/null 2>&1 || true
                rm -f "$unit_dir/${UNIT_PREFIX}-$s.service"
            done
            rm -f "$unit_dir/${UNIT_PREFIX}.target"
            systemctl daemon-reload
            ok "Services systemd retirés."
            ;;
        *) die "Usage : sudo ./elpis service install|remove   (ou ./elpis service print)" ;;
    esac
}

