# .env : surcharges locales facultatives (KEY=VALUE, une par ligne), puis les ports qui en dépendent.
# Lu comme des données, jamais sourcé : clé validée, valeur littérale (ni substitution ni commande), guillemets de bordure retirés.
charger_env() {
    ENV_PAIRES=(); ENV_CHARGE=1
    [ -f "$ROOT/.env" ] || return 0
    local ligne cle val
    while IFS= read -r ligne || [ -n "$ligne" ]; do
        ligne="${ligne%$'\r'}"
        ligne="${ligne#"${ligne%%[![:space:]]*}"}"
        case "$ligne" in ''|'#'*) continue ;; esac
        ligne="${ligne#export[[:space:]]}"
        ligne="${ligne#"${ligne%%[![:space:]]*}"}"
        case "$ligne" in *=*) ;; *) continue ;; esac
        cle="${ligne%%=*}"; val="${ligne#*=}"
        cle="${cle%"${cle##*[![:space:]]}"}"
        motif "$cle" '^[A-Za-z_][A-Za-z0-9_]*$' || continue
        val="${val#"${val%%[![:space:]]*}"}"
        val="${val%"${val##*[![:space:]]}"}"
        if motif "$val" '^"([^"]*)"([[:space:]]+#.*)?$' || motif "$val" "^'([^']*)'([[:space:]]+#.*)?\$"; then
            val="${BASH_REMATCH[1]}"
        else
            val="${val%%[[:space:]]#*}"; val="${val%"${val##*[![:space:]]}"}"
        fi
        export "$cle=$val"; ENV_PAIRES+=("$cle=$val")
    done < "$ROOT/.env"
}

# .env sous root et un compte par service : absent, ou fichier ordinaire de root ou de l'opérateur qu'aucun compte des services ne peut écrire ni remplacer (deploy/droits.py sur), sinon arrêt ; puis lu comme des données.
charger_env_sur() {
    poser_droits sur "$ROOT/.env" --proprio "root,$(stat -c %U -- "$ROOT")" \
        || die "$ROOT/.env refusé (voir ci-dessus) : root n'y lit aucun chemin tant qu'un compte des services peut l'écrire ; fichier de l'opérateur, sans lien, fermé aux autres comptes."
    charger_env
}

# Instance : config.json, .env, Node, écoute et dossiers, lus par le core (sans le venv) ; sous des unités à un compte par service : chemins de .env et du dépôt seulement, ceux des unités (charger_chemins_separes).
charger_instance() {
    if separe_vise; then charger_chemins_separes; return; fi
    if [ -L "$ROOT/config.json" ] && [ ! -f "$ROOT/config.json" ]; then
        die "config.json illisible pour ce compte ($(readlink -- "$ROOT/config.json")) : membre du groupe $GROUPE_DONNEES dans une nouvelle session, ou sudo."
    fi
    [ -f "$ROOT/config.json" ] || die "config.json absent : lancez ./elpis configure"
    charger_env
    NODE="$(node_bin)"
    BIND_DEFAULT="$(_bind_default)"
    SANDBOX_DIR="${APP_SANDBOX_DIR:-}"
    if [ -z "$SANDBOX_DIR" ] && [ -f "$CORE_DIST/exploitation.mjs" ]; then
        SANDBOX_DIR="$(core_cmd config SANDBOX_DIR 2>/dev/null)" \
            || die "Dossier des sandboxes illisible par le core (bundle d'une autre version, ou Node inutilisable) : ./install.sh, ou ./install.sh --offline <paquet de cette version>"
    fi
    [ -n "$SANDBOX_DIR" ] || SANDBOX_DIR="$ROOT/user_sandboxes"
    # Cache des graphiques : écrit par le core, relu par l'hôte d'outils ; un même dossier privé pour tous.
    CHART_DIR="${CHART_CACHE_DIR:-$RUN_DIR/charts}"
    mkdir -p "$RUN_DIR" "$LOG_DIR" "$ROOT/user_db/logs"
    # Sous root (service install, backup), jamais un dossier choisi par config.json : service install crée ou refuse celui des sandboxes.
    [ "$(id -u)" -eq 0 ] || mkdir -p "$SANDBOX_DIR"
    dossiers_rag
}

# Instance sous un compte par service : config.json présent, .env (vérifié sous root), Node, chemins de .env et du dépôt (chemins_separes) ; ni le core ni une création de dossier.
charger_chemins_separes() {
    [ -e "$ROOT/config.json" ] || [ -L "$ROOT/config.json" ] || die "config.json absent : lancez ./elpis configure"
    if [ "$(id -u)" -ne 0 ] && [ -L "$ROOT/config.json" ] && [ ! -f "$ROOT/config.json" ]; then
        die "config.json illisible pour ce compte ($(readlink -- "$ROOT/config.json")) : membre du groupe $GROUPE_DONNEES dans une nouvelle session, ou sudo."
    fi
    if [ "$(id -u)" -eq 0 ]; then charger_env_sur; else charger_env; fi
    NODE="$(node_bin)"; BIND_DEFAULT=127.0.0.1
    chemins_separes
}

# chemin_absolu CHEMIN : absolu (relatif à la racine), « // », « . » et « .. » résolus sans lire le disque ; un chemin à fin de ligne est rendu tel quel (refusé ensuite).
chemin_absolu() {
    local p="$1" c r=() parties=()
    case "$p" in *$'\n'*|*$'\r'*) printf '%s' "$p"; return ;; esac
    [[ "$p" == /* ]] || p="$ROOT/$p"
    IFS=/ read -r -a parties <<< "$p"
    for c in "${parties[@]}"; do
        case "$c" in ''|.) ;; ..) [ "${#r[@]}" -eq 0 ] || unset 'r[-1]' ;; *) r+=("$c") ;; esac
    done
    (IFS=/; printf '/%s\n' "${r[*]}")
}

# defaut_donnees DOSSIER_BASE NOM DÉFAUT : défaut d'un dossier de données comme le core (defautDonnees) : DÉFAUT (relatif à la racine) si la base est dans user_db, sinon NOM près de la base, sauf s'il manque et que l'ancien dossier n'est pas vide.
defaut_donnees() {
    [ "$1" != "$ROOT/user_db" ] || { printf '%s\n' "$3"; return; }
    if [ ! -e "$1/$2" ] && [ -n "$(ls -A -- "$(chemin_absolu "$3")" 2>/dev/null)" ]; then printf '%s\n' "$3"; else printf '%s\n' "$1/$2"; fi
}

# Chemins des données sous un compte par service, de .env (ou de l'environnement) et des défauts du dépôt, jamais de config.json : ceux que root traite, fixés dans les unités et passés au code (CHEMINS_FIXES) ; chemin hors du motif sûr : arrêt.
chemins_separes() {
    local base e
    SANDBOX_DIR="$(chemin_absolu "${APP_SANDBOX_DIR:-user_sandboxes}")"
    DB_FICHIER="$(chemin_absolu "${APP_DB_PATH:-user_db/app.db}")"; base="${DB_FICHIER%/*}"
    RAG_STORE="$(chemin_absolu "${RAG_STORE_DIR:-$base/rag}")"
    RAG_CACHE="$(chemin_absolu "${RAG_CACHE_DIR:-${RAG_STORE%/}-cache}")"
    CHART_DIR="$(chemin_absolu "${CHART_CACHE_DIR:-$RUN_DIR/charts}")"
    CHEMINS_FIXES=("APP_SANDBOX_DIR=$SANDBOX_DIR" "APP_DB_PATH=$DB_FICHIER" "RAG_STORE_DIR=$RAG_STORE" "CHART_CACHE_DIR=$CHART_DIR"
        "APP_MEMORY_DIR=$(chemin_absolu "${APP_MEMORY_DIR:-user_db/memoire}")"
        "APP_SKILLS_DIR=$(chemin_absolu "${APP_SKILLS_DIR:-skills}")"
        "APP_USER_SKILLS_DIR=$(chemin_absolu "${APP_USER_SKILLS_DIR:-$(defaut_donnees "$base" user_skills user_skills)}")"
        "APP_SKINS_DIR=$(chemin_absolu "${APP_SKINS_DIR:-$(defaut_donnees "$base" user_skins user_skins)}")"
        "MCP_SERVERS_DIR=$(chemin_absolu "${MCP_SERVERS_DIR:-$(defaut_donnees "$base" mcp_custom_servers ../mcp_custom_servers)}")"
        "APP_FILE_HISTORY_DIR=$(chemin_absolu "${APP_FILE_HISTORY_DIR:-user_db/file_history}")"
        "APP_OFFICE_CACHE_DIR=$(chemin_absolu "${APP_OFFICE_CACHE_DIR:-$SANDBOX_DIR/.office-cache}")")
    for e in "${CHEMINS_FIXES[@]}" "RAG_CACHE_DIR=$RAG_CACHE"; do _chemin_unite "${e%%=*} (.env)" "${e#*=}"; done
}

# Valeur d'un chemin fixé (CHEMINS_FIXES) : fixe NOM.
fixe() { local e; for e in "${CHEMINS_FIXES[@]}"; do [ "${e%%=*}" != "$1" ] || { printf '%s\n' "${e#*=}"; return 0; }; done; return 1; }

# Magasin du RAG (lu par le core et l'extracteur, le même pour les deux) et cache de l'extracteur, calculés par le core.
dossiers_rag() {
    RAG_STORE="${RAG_STORE_DIR:-}"; RAG_CACHE="${RAG_CACHE_DIR:-}"
    if [ -f "$CORE_DIST/exploitation.mjs" ]; then
        [ -n "$RAG_STORE" ] || RAG_STORE="$(core_cmd config RAG_STORE_DIR 2>/dev/null)" || RAG_STORE=""
        [ -n "$RAG_CACHE" ] || RAG_CACHE="$(core_cmd config RAG_CACHE_DIR 2>/dev/null)" || RAG_CACHE=""
    fi
    [ -n "$RAG_STORE" ] || RAG_STORE="$ROOT/user_db/rag"
    [ -n "$RAG_CACHE" ] || RAG_CACHE="${RAG_STORE%/}-cache"
    # Sous root (service install), jamais : un dossier créé par root serait illisible pour le compte des services.
    if [ "$(id -u)" -ne 0 ]; then mkdir -p -m 700 "$RAG_STORE" "$RAG_CACHE" 2>/dev/null || true; fi
}

# Services : le venv sert encore au RAG, au moteur Office de l'hôte d'outils et à l'installation.
load_runtime() {
    need_venv
    charger_instance
