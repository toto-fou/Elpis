            check_out "serveur LLM" "./elpis configure" doctor_llm "$py" "$moteur" "$llm" "$cle"
            local conseil
            while IFS= read -r conseil; do info "$conseil"; done \
                < <(if racine_separee; then app_console --env "ELPIS_CFG_LLM_API_KEY=$cle" "$py" "$ROOT/deploy/configure.py" --conseils-moteur --engine "${moteur:-llamacpp}"
