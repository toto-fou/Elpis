# Compte des services pour « audit setup » et « vault setup » (COMPTE_SETUP) : User= des unités, sinon ELPIS_USER, sinon SUDO_USER ; jamais root ; root exigé hors arborescence factice.
compte_setup() {
    local quoi="$1" unite
    unite="$(compte_services)"
    if [ -n "$unite" ] && [ -n "${ELPIS_USER:-}" ] && [ "$ELPIS_USER" != "$unite" ]; then
        die "Les services tournent sous $unite (User= des unités systemd), pas sous ELPIS_USER=$ELPIS_USER : sudo ELPIS_USER=$ELPIS_USER ./elpis service install pour changer de compte."
    fi
    COMPTE_SETUP="${unite:-${ELPIS_USER:-${SUDO_USER:-}}}"
    if [ -z "$SYS_PREFIXE" ]; then
        [ "$(id -u)" -eq 0 ] || die "Lancez avec sudo : sudo ./elpis $quoi setup"
    else
        COMPTE_SETUP="${COMPTE_SETUP:-$(id -un)}"
    fi
    [ -n "$COMPTE_SETUP" ] && [ "$COMPTE_SETUP" != root ] \
        || die "Utilisateur de service inconnu : lancez via sudo depuis votre compte, ou ELPIS_USER=nom."
    id -u "$COMPTE_SETUP" >/dev/null 2>&1 || die "Compte de service $COMPTE_SETUP inexistant (ELPIS_USER=nom)."
    if [ -n "$unite" ] && [ "$unite" != "${SUDO_USER:-}" ]; then info "Compte des services : $unite (unités systemd installées)."; fi
}

# Journal de sécurité : mise en place (setup, root) ou vérification des signatures et de la continuité (verify).
cmd_audit() {
    if [ "${1:-}" = "setup" ]; then
        compte_setup audit
        audit_setup "$COMPTE_SETUP" "" 1 || die "Journal de sécurité incomplet : voir ci-dessus, puis relancez sudo ./elpis audit setup."
        ok "Journal de sécurité en place (compte $COMPTE_SETUP)."
        return 0
    fi
    charger_env
    charger_instance
    need_exploitation
    core_cmd audit "$@"
}

# Coffre « Secrets » : clé (setup en root ; status ; rekey, ancienne clé relative au dossier d'Elpis, rendue absolue) ; doctor sert ./elpis doctor.
cmd_vault() {
    local f
    case "${1:-}" in
        setup)
            [ $# -eq 1 ] || die "Usage : sudo ./elpis vault setup"
            vault_setup ;;
        status|rekey|doctor)
            charger_env
            charger_instance
            need_exploitation
            if [ "$1" = rekey ] && [ "${2:-}" = --from ] && [ -n "${3:-}" ]; then
                f="$3"; case "$f" in /*) ;; *) f="$ROOT/$f" ;; esac
                set -- rekey --from "$f" "${@:4}"
            fi
            vault_core vault "$@" ;;
        *) die "Usage : sudo ./elpis vault setup | ./elpis vault status | ./elpis vault rekey --from FICHIER" ;;
    esac
}

# Secrets du coffre : métadonnées seules (jamais de valeur).
cmd_secret() {
    [ "${1:-}" = ls ] || die "Usage : ./elpis secret ls [--user COMPTE]"
    charger_env
    charger_instance
    need_exploitation
    vault_core secret "$@"
}

# Commande du coffre par le core : sous le compte des services quand root la lance (runuser, ses groupes compris : clé lisible, fichiers de la base jamais créés par root), telle quelle sinon.
vault_core() {
    local compte
    if [ "$(id -u)" -ne 0 ]; then core_cmd "$@"; return; fi
    compte="$(compte_services)"
    compte="${compte:-${ELPIS_USER:-${SUDO_USER:-}}}"
    [ -n "$compte" ] && [ "$compte" != root ] \
        || die "Compte des services inconnu : relancez sans sudo sous ce compte, ou ELPIS_USER=nom."
    (cd / && runuser -u "$compte" -- env "ELPIS_RACINE=$ROOT" ${SANDBOX_DIR:+"APP_SANDBOX_DIR=$SANDBOX_DIR"} \
        "$NODE" "$CORE_DIST/exploitation.mjs" "$@")
}

# Compte des services d'après les unités installées (User= de main, admin ou toolhost) ; vide sans unité.
compte_services() {
    local s f u
    for s in main admin toolhost; do
        f="$SYS_PREFIXE/etc/systemd/system/${UNIT_PREFIX}-$s.service"
        [ -f "$f" ] || continue
        u=""
        if [ -z "$SYS_PREFIXE" ] && command -v systemctl >/dev/null 2>&1; then
            u="$(systemctl show -p User --value "${UNIT_PREFIX}-$s.service" 2>/dev/null)"
        fi
        [ -n "$u" ] || u="$(sed -n 's/^User=//p' "$f" | tail -n 1)"
        echo "$u"
        return 0
    done
}

# Groupe propre au compte : groupe local sans autre membre, groupe primaire d'aucun autre compte.
groupe_propre() {
    local g="$1" u="$2" gid membres
    gid="$(awk -F: -v g="$g" '$1 == g { print $3; exit }' /etc/group)"
    [ -n "$gid" ] || return 1
    membres="$(getent group "$g" | cut -d: -f4)"
    [ -z "$membres" ] || [ "$membres" = "$u" ] || return 1
    getent passwd | awk -F: -v g="$gid" -v u="$u" '$4 == g && $1 != u { e = 1 } END { exit e }'
}

# Groupe de la clé dans GRP_CLE : groupe primaire du compte s'il lui est propre, sinon GROUPE_CLE (créé au besoin) avec ce compte pour seul membre.
groupe_de_cle() {
    local compte="$1"
    GRP_CLE="$(id -gn "$compte")" || return 1
    if [ "$(id -u)" -ne 0 ] || groupe_propre "$GRP_CLE" "$compte"; then return 0; fi
    GRP_CLE="$GROUPE_CLE"
    if ! getent group "$GRP_CLE" >/dev/null; then
        groupadd --system "$GRP_CLE" || return 1
        info "Groupe $GRP_CLE créé : lecture de la clé de signature par $compte seul."
    fi
    if ! id -nG "$compte" | tr ' ' '\n' | grep -qx "$GRP_CLE"; then
        info "$compte ajouté au groupe $GRP_CLE : pris par les services systemd à leur redémarrage, par ./elpis start dans une nouvelle session."
    fi
    gpasswd -M "$compte" "$GRP_CLE" >/dev/null || return 1
    groupe_propre "$GRP_CLE" "$compte" || { warn "Groupe $GRP_CLE : groupe primaire d'un autre compte, clé non confiée."; return 1; }
}

# Dossier système posé sans suivre de lien : créé s'il manque, refusé si c'est un lien, un fichier, le bien d'un autre compte ou (parent inscriptible par d'autres) un dossier de root non vide à céder ; droits posés sur « . » une fois dedans.
dossier_sur() {
    local d="$1" mode="$2" proprio="$3" groupe="$4" admis=" root $3 ${5:-} " attendu parent
    [ "$(id -u)" -eq 0 ] || admis+="$(id -un) "
    if [ ! -e "$d" ] && [ ! -L "$d" ]; then
        mkdir -m "$mode" -- "$d" || return 1
        info "Dossier $d créé."
    fi
    parent="$(cd -P -- "$(dirname -- "$d")" && pwd -P)" || return 1
    attendu="$parent/${d##*/}"
    (
        { [ ! -L "$d" ] && cd -P -- "$d" 2>/dev/null && [ "$(pwd -P)" = "$attendu" ]; } \
            || { warn "$d : lien symbolique, fichier ou dossier déplacé : refusé (à vérifier)."; exit 1; }
        p="$(stat -c %U .)"
        case "$admis" in
            *" $p "*) ;;
            *) warn "$d appartient à $p, pas à $proprio : refusé (services sous $p : ELPIS_USER=$p ; passage à $proprio : sudo ELPIS_USER=$proprio ./elpis service install)."; exit 1 ;;
        esac
        if [ "$p" = root ] && [ "$proprio" != root ] && [ -n "$(ls -A .)" ] \
                && [ $(( 8#$(stat -c %a -- "$parent") & 8#022 )) -ne 0 ]; then
            warn "$d : dossier de root non vide à céder à $proprio : refusé (à vérifier)."; exit 1
        fi
        if [ "$(id -u)" -eq 0 ]; then chown -h "$proprio:$groupe" . || exit 1; fi
        chmod "$mode" .
    )
}

# Clé de signature : fichier ordinaire, jamais un lien, créée si absente ou vide (jamais remplacée sinon), puis 0440 root:GRP_CLE à chaque passage.
cle_audit() {
    local cle="$AUDIT_KEY_SYS"
    if [ -L "$cle" ] || { [ -e "$cle" ] && [ ! -f "$cle" ]; }; then
        warn "$cle : lien symbolique ou fichier spécial : refusé (à vérifier)."; return 1
    fi
    if [ ! -s "$cle" ]; then
        ( umask 0337 && od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > "$cle" ) || return 1
        info "Clé de signature du journal de sécurité créée : $cle (à sauvegarder hors de la machine)."
    fi
    if [ "$(id -u)" -eq 0 ]; then chown -h "root:$GRP_CLE" -- "$cle" || return 1; fi
    chmod 0440 -- "$cle"
}

# Commande lancée sous le compte des services quand root l'exécute (runuser, depuis /), telle quelle sinon.
en_compte() {
    local u="$1"; shift
    if [ "$(id -u)" -eq 0 ]; then (cd / && runuser -u "$u" -- "$@"); else "$@"; fi
}

# Vrai si main, admin ou l'hôte d'outils tourne (unité active ou lancement à la main) : ils gardent leur dossier d'audit jusqu'à l'arrêt.
ecrivains_en_marche() {
    local s
    for s in main admin toolhost; do
        pid_of "$s" >/dev/null && return 0
        if [ -z "$SYS_PREFIXE" ] && command -v systemctl >/dev/null 2>&1 \
                && systemctl is-active --quiet "${UNIT_PREFIX}-$s.service" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

# Fichiers des journaux (audit, app.log.jsonl et ses rotations) rendus au compte par root (chown -h, fichiers ordinaires à un seul lien, dossier à ce compte, lu après cd -P), puis mis en 0640 sous ce compte.
audit_droits_fichiers() {
    local compte="$1" d echec=0
    if [ "$(id -u)" -eq 0 ]; then
        for d in "$AUDIT_DIR_SYS|audit-*.jsonl" "$APPLOG_DIR_SYS|app.log.jsonl*"; do
            (
                motif="${d#*|}"; d="${d%%|*}"; e=0
                { [ ! -L "$d" ] && cd -P -- "$d" 2>/dev/null && [ "$(stat -c %U .)" = "$compte" ]; } || exit 0
                for f in $motif; do
                    [[ -f $f && ! -L $f ]] || continue
                    [ "$(stat -c '%U:%G' -- "$f")" != "$compte:$GROUPE_JOURNAL" ] || continue
                    if [ "$(stat -c %h -- "$f")" -ne 1 ]; then warn "$d/$f : plusieurs liens physiques, laissé tel quel (à vérifier)."; e=1; continue; fi
                    chown -h "$compte:$GROUPE_JOURNAL" -- "$f" || e=1
                done
                exit "$e"
            ) || echec=1
        done
    fi
    en_compte "$compte" find "$AUDIT_DIR_SYS" -maxdepth 1 -type f -name 'audit-*.jsonl' ! -perm 0640 -exec chmod 0640 {} + || echec=1
    if [ -d "$APPLOG_DIR_SYS" ]; then
        en_compte "$compte" find "$APPLOG_DIR_SYS" -maxdepth 1 -type f -name 'app.log.jsonl*' ! -perm 0640 -exec chmod 0640 {} + || echec=1
    fi
    return "$echec"
}

# Fichiers de logs/audit déplacés sous le compte des services (jamais par root), ou ajoutés au fichier du même jour s'il existe (seq par boot : l'ordre n'importe pas) ; écrivains en marche : ceux du jour et de la veille restent.
audit_deplacer() {
    local compte="$1" f nom jour hier="" deplaces=0 fusionnes=0 gardes=0 recents=0 echec=0
    [[ -d $AUDIT_DIR_SYS && ! -L $AUDIT_DIR_SYS ]] || { warn "$AUDIT_DIR_SYS absent : rien n'est déplacé."; return 1; }
    ecrivains_en_marche && hier="$(date -u -d yesterday +%F)"
    for f in "$ROOT"/logs/audit/audit-*.jsonl; do
        [[ -e $f || -L $f ]] || continue
        if [[ -L $f || ! -f $f ]]; then warn "$f : lien symbolique ou fichier spécial, laissé (à vérifier)."; continue; fi
        nom="${f##*/}"; jour="${nom#audit-}"; jour="${jour%.jsonl}"
        if [ -n "$hier" ] && ! [[ "$jour" < "$hier" ]]; then recents=$((recents + 1)); continue; fi
        if [ -e "$AUDIT_DIR_SYS/$nom" ] || [ -L "$AUDIT_DIR_SYS/$nom" ]; then
            if [[ -L $AUDIT_DIR_SYS/$nom || ! -f $AUDIT_DIR_SYS/$nom || $f -ef $AUDIT_DIR_SYS/$nom ]]; then gardes=$((gardes + 1)); continue; fi
            en_compte "$compte" sh -c '[ -r "$1" ] && [ -w "${1%/*}" ] && [ -w "$2" ] || exit 3
                [ -n "$(tail -c 1 -- "$2")" ] && printf "\n" >> "$2"; cat -- "$1" >> "$2" || exit 1; rm -f -- "$1" || exit 2' fusion "$f" "$AUDIT_DIR_SYS/$nom"
            case $? in
                0) fusionnes=$((fusionnes + 1)) ;;
                3) warn "$f : illisible ou non supprimable par $compte, ou $AUDIT_DIR_SYS/$nom non inscriptible : laissé (à vérifier)."; echec=1 ;;
                2) warn "$f : ajouté à $AUDIT_DIR_SYS/$nom mais non supprimé : à retirer à la main (une relance doublerait ses lignes)."; echec=1 ;;
                *) warn "$f : ajout à $AUDIT_DIR_SYS/$nom interrompu, fichier gardé (à vérifier : une relance doublerait les lignes déjà ajoutées)."; echec=1 ;;
            esac
            continue
        fi
        en_compte "$compte" mv -n -- "$f" "$AUDIT_DIR_SYS/$nom"
        if [ -e "$f" ]; then warn "$f non déplacé."; echec=1; else deplaces=$((deplaces + 1)); fi
    done
    [ "$deplaces" -gt 0 ] && info "$deplaces fichier(s) d'audit déplacé(s) de logs/audit vers $AUDIT_DIR_SYS."
    [ "$fusionnes" -gt 0 ] && info "$fusionnes fichier(s) d'audit de logs/audit ajouté(s) au fichier du même jour de $AUDIT_DIR_SYS."
    [ "$gardes" -gt 0 ] && warn "$gardes fichier(s) laissé(s) dans logs/audit : le fichier du même jour de $AUDIT_DIR_SYS est un lien, un fichier spécial ou le même fichier (à vérifier)."
    [ "$recents" -gt 0 ] && warn "$recents fichier(s) du jour et de la veille laissé(s) dans logs/audit : les services y écrivent encore ; relancez sudo ./elpis audit setup une fois arrêtés (./elpis stop, ou systemctl stop ${UNIT_PREFIX}.target)."
    audit_droits_fichiers "$compte" || echec=1
    return "$echec"
}

# Contrôle final : mode des dossiers et de la clé, propriétaire et groupe sous root, clé d'au moins 32 octets ; liste les écarts.
audit_controle() {
    local compte="$1" c chemin attendu vu echec=0
    for c in "$SYS_PREFIXE/var/lib/elpis|755 root root" "$AUDIT_DIR_SYS|2750 $compte $GROUPE_JOURNAL" \
             "$APPLOG_DIR_SYS|2750 $compte $GROUPE_JOURNAL" "$SYS_PREFIXE/etc/elpis|750 root ${GRP_CLE:-?}" \
             "$AUDIT_KEY_SYS|440 root ${GRP_CLE:-?}"; do
        chemin="${c%%|*}"; attendu="${c#*|}"
        vu="$(stat -c '%a %U %G' -- "$chemin" 2>/dev/null)" || vu="absent"
        if [ "$(id -u)" -ne 0 ]; then attendu="${attendu%% *}"; vu="${vu%% *}"; fi
        [ "$vu" = "$attendu" ] || { warn "$chemin : $vu (attendu $attendu)."; echec=1; }
    done
    if [ ! -f "$AUDIT_KEY_SYS" ] || [ -L "$AUDIT_KEY_SYS" ] || [ "$(tr -d ' \t\r\n' < "$AUDIT_KEY_SYS" | wc -c)" -lt 32 ]; then
        warn "Clé $AUDIT_KEY_SYS absente, illisible ou trop courte (32 octets au moins)."; echec=1
    fi
    return "$echec"
}

# Journal de sécurité hors du dépôt (AUDIT_SETUP COMPTE [ANCIENS_COMPTES] [DÉPLACER]) : groupes, dossiers 2750, clé, droits réappliqués, logs/audit déplacé si DÉPLACER=1, contrôle final ; non nul au moindre échec.
audit_setup() {
    local compte="$1" ancien="${2:-}" deplacer="${3:-1}" nouveau=0 echec=0 dossiers=0 d
    if [ "$(id -u)" -eq 0 ]; then
        if ! getent group "$GROUPE_JOURNAL" >/dev/null; then
            if groupadd --system "$GROUPE_JOURNAL"; then info "Groupe $GROUPE_JOURNAL créé (lecture des journaux par rsyslog)."; else echec=1; fi
        fi
        if id syslog >/dev/null 2>&1 && ! id -nG syslog | tr ' ' '\n' | grep -qx "$GROUPE_JOURNAL"; then
            if usermod -aG "$GROUPE_JOURNAL" syslog; then nouveau=1; else echec=1; fi
        fi
    fi
    [ -z "$SYS_PREFIXE" ] || mkdir -p "$SYS_PREFIXE/var/lib" "$SYS_PREFIXE/var/log" "$SYS_PREFIXE/etc" || echec=1
    if dossier_sur "$SYS_PREFIXE/var/lib/elpis" 0755 root root; then
        for d in "$AUDIT_DIR_SYS" "$APPLOG_DIR_SYS"; do
            if dossier_sur "$d" 2750 "$compte" "$GROUPE_JOURNAL" "$ancien"; then dossiers=$((dossiers + 1)); else echec=1; fi
        done
    else
        echec=1
    fi
    if groupe_de_cle "$compte" && dossier_sur "$SYS_PREFIXE/etc/elpis" 0750 root "$GRP_CLE"; then cle_audit || echec=1; else echec=1; fi
    if [ "$dossiers" -eq 2 ]; then
        if [ "$deplacer" = 1 ]; then audit_deplacer "$compte" || echec=1; else audit_droits_fichiers "$compte" || echec=1; fi
    fi
    if [ "$nouveau" -eq 1 ] && command -v systemctl >/dev/null 2>&1; then systemctl try-restart rsyslog >/dev/null 2>&1 || true; fi
    audit_controle "$compte" || echec=1
    return "$echec"
}

# Clé du coffre : fichier ordinaire, jamais un lien ; 32 octets aléatoires en base64, créée si absente ou vide, jamais remplacée ; validée par le cœur (vault check-key, même règle que les services) ; 0440 root:GRP_CLE à chaque passage.
cle_coffre() {
    local cle="$VAULT_KEY_SYS" verdict
    if [ -L "$cle" ] || { [ -e "$cle" ] && [ ! -f "$cle" ]; }; then
        warn "$cle : lien symbolique ou fichier spécial : refusé (à vérifier)."; return 1
    fi
    if [ -s "$cle" ]; then
        verdict="$(core_cmd vault check-key < "$cle" 2>&1)" \
            || { warn "$cle : ${verdict:-clé refusée par le cœur} : laissée intacte, à vérifier."; return 1; }
        info "Clé du coffre déjà en place, gardée : $cle ($verdict, jamais remplacée)."
    else
        ( umask 0337 && head -c 32 /dev/urandom | base64 > "$cle" ) || return 1
        verdict="$(core_cmd vault check-key < "$cle" 2>&1)" \
            || { rm -f -- "$cle"; warn "Clé du coffre générée refusée (${verdict:-?}) : relancez sudo ./elpis vault setup."; return 1; }
        info "Clé du coffre créée : $cle ($verdict ; à sauvegarder hors de la machine, à part des sauvegardes d'Elpis)."
    fi
    if [ "$(id -u)" -eq 0 ]; then chown -h "root:$GRP_CLE" -- "$cle" || return 1; fi
    chmod 0440 -- "$cle"
}

# Clé du coffre hors de la base (vault setup) : groupe de la clé, dossier /etc/elpis 0750, clé 0440 ; contrôle final, conseils pour la clé de repli.
vault_setup() {
    local vu attendu
    compte_setup vault
    NODE="$(node_bin)"
    need_exploitation
    [ -z "$SYS_PREFIXE" ] || mkdir -p "$SYS_PREFIXE/etc" || die "Arborescence $SYS_PREFIXE/etc impossible à créer."
    groupe_de_cle "$COMPTE_SETUP" || die "Groupe de la clé non préparé (voir ci-dessus)."
    dossier_sur "$SYS_PREFIXE/etc/elpis" 0750 root "$GRP_CLE" || die "Dossier $SYS_PREFIXE/etc/elpis refusé (voir ci-dessus)."
    cle_coffre || die "Clé du coffre non posée : voir ci-dessus, puis relancez sudo ./elpis vault setup."
    attendu="440 root $GRP_CLE"
    vu="$(stat -c '%a %U %G' -- "$VAULT_KEY_SYS" 2>/dev/null)" || vu="absent"
    if [ "$(id -u)" -ne 0 ]; then attendu="${attendu%% *}"; vu="${vu%% *}"; fi
    [ "$vu" = "$attendu" ] || die "$VAULT_KEY_SYS : $vu (attendu $attendu)."
    ok "Clé du coffre en place : $VAULT_KEY_SYS (compte $COMPTE_SETUP, groupe $GRP_CLE)."
    info "Les services la lisent au démarrage : sudo systemctl restart ${UNIT_PREFIX}.target (ou ./elpis restart)."
    if [ -e "$ROOT/user_db/.vault.key" ]; then
        info "Clé de repli trouvée (user_db/.vault.key) : après le redémarrage, ./elpis vault rekey --from user_db/.vault.key, puis supprimez-la."
    fi
}

# Image de la sandbox attendue par le code : présente, sinon chargée depuis
# son archive (deploy/docker/sandbox/elpis-sandbox-<version>.tar.gz), sinon
# construite (réseau requis). Sans elle, les conteneurs existants gardent
# leur ancienne image, sans agent : fichiers, éditeur et git inutilisables.
ensure_sandbox_image() {
    command -v docker >/dev/null 2>&1 || { warn "docker absent : image de sandbox non vérifiée."; return 0; }
    local dir="$ROOT/deploy/docker/sandbox" img arch
    img="$(bash "$dir/build_offline.sh" --print-image 2>/dev/null)" || return 0
    if docker image inspect "$img" >/dev/null 2>&1; then
        ok "Image de sandbox $img présente."
        return 0
    fi
    arch="$dir/elpis-sandbox-${img##*:}.tar.gz"
    if [ -f "$arch" ]; then
        info "Image de sandbox $img : chargement de $(basename "$arch")…"
        bash "$dir/load_image.sh" "$arch" && return 0
    fi
    info "Image de sandbox $img absente : construction (réseau requis, plusieurs minutes)…"
    bash "$dir/build_offline.sh" && return 0
    return 1
}

cmd_upgrade() {
    local backup=1 req="$ROOT/requirements-rag.txt"
    case "${1:-}" in --no-backup) backup=0 ;; "") ;; *) die "Usage : ./elpis upgrade [--no-backup]" ;; esac
    load_runtime
    git -C "$ROOT" diff --quiet HEAD -- \
        || die "Modifications locales dans le dépôt (git status) : mise à jour annulée."
    if [ "$backup" -eq 1 ]; then
        info "Sauvegarde complète…"
        local rc=0
        cmd_backup full || rc=$?
        # 3 : sauvegarde faite, mais sans le /work d'au moins un compte
        # (sandbox illisible) : la base y est, la mise à jour continue.
        if [ "$rc" -eq 3 ]; then
            warn "Sauvegarde incomplète (/work d'au moins un compte) : la mise à jour continue."
        elif [ "$rc" -ne 0 ]; then
            die "Sauvegarde échouée : mise à jour annulée (--no-backup pour passer outre)."
        fi
    fi
    local before; before="$(git -C "$ROOT" rev-parse --short HEAD)"
    info "Code (git pull --ff-only)…"
    git -C "$ROOT" pull --ff-only || die "git pull --ff-only a échoué : rien n'a été modifié."
    . "$ROOT/deploy/node/node.env"
    info "Code : $before → $(git -C "$ROOT" rev-parse --short HEAD)"
    # Extras AGPL déjà installés : ils restent à jour.
    "$PY" -c 'import fitz' >/dev/null 2>&1 && req="$ROOT/requirements-agpl-optional.txt"
    info "Dépendances Python…"
    "$PY" -m pip install -q -r "$req" || die "Échec pip : relancez ./elpis upgrade --no-backup une fois corrigé."
    info "Node.js, core et hôte d'outils…"
    # Archive officielle de Node.js téléchargée une fois pour le runtime et le npm de la construction (dossier global, supprimé à la sortie).
    CACHE_NODE="$(mktemp -d "$ROOT/.node-cache.XXXXXX")"
    trap 'rm -rf "$CACHE_NODE"' EXIT
    if [ -z "${ELPIS_NODE:-}" ]; then
        ELPIS_NODE_CACHE="$CACHE_NODE" "$ROOT/deploy/node/installer.sh" node \
            || die "Node.js du core non installé : relancez ./elpis upgrade --no-backup une fois corrigé."
        NODE="$(node_bin)"
    fi
    node_ok || die "Node.js du core absent ou trop ancien (24.x, $NODE_MIN au moins) : voir ELPIS_NODE."
    ELPIS_NODE_CACHE="$CACHE_NODE" "$ROOT/deploy/node/installer.sh" bundles \
        || die "Construction du core ou de l'hôte d'outils échouée : l'ancien bundle reste en place ; relancez ./elpis upgrade --no-backup une fois corrigé."
    ELPIS_NODE_CACHE="$CACHE_NODE" "$ROOT/deploy/node/installer.sh" web \
        || die "Construction du frontend échouée : relancez ./elpis upgrade --no-backup une fois corrigé."
    info "Image de la sandbox…"
    ensure_sandbox_image || die "Image de sandbox indisponible : chargez son archive \
(deploy/docker/sandbox/load_image.sh <archive>) ou construisez-la (./install.sh --sandbox build), \
puis ./elpis restart. Sans elle, fichiers, éditeur et git des sandboxes ne marchent pas."
    migrer_mcp
    info "Redémarrage (les migrations de la base s'appliquent au démarrage)…"
    if systemd_installed; then
        info "Unités systemd inchangées : sudo ./elpis service install quand le CHANGELOG le demande."
        sudo systemctl restart "${UNIT_PREFIX}.target" || die "Redémarrage systemd échoué."
        { wait_port "$MAIN_PORT" 120 && wait_port "$ADMIN_PORT" 60; } \
            || die "L'application ne répond pas après la mise à jour : ./elpis logs main"
    else
        cmd_stop
        cmd_start || die "L'application ne répond pas après la mise à jour (voir ci-dessus) : ./elpis logs main"
    fi
    local base
    base="$(core_cmd migrations 2>&1)" || die "Base après la mise à jour : ${base:-injoignable} (./elpis db info, ./elpis logs main)"
    case "$base" in
        "à jour"*) ok "Base : $base" ;;
        *) die "Migrations non appliquées après le redémarrage : $base (./elpis logs main)" ;;
    esac
    ok "Mise à jour appliquée ; diagnostic :"
    cmd_doctor || true
}

# =============================================================================
case "${1:-}" in
    configure) shift; cmd_configure "$@" ;;
    start)     shift; cmd_start "$@" ;;
    stop)      cmd_stop ;;
    restart)   load_runtime; need_core; cmd_migrations; cmd_stop; cmd_start ;;
    status)    cmd_status ;;
    logs)      shift; cmd_logs "$@" ;;
    service)   shift; cmd_service "$@" ;;
    doctor)    cmd_doctor ;;
    backup)    shift; cmd_backup "$@" ;;
    upgrade)   shift; cmd_upgrade "$@" ;;
    db)        shift; cmd_db "$@" ;;
    audit)     shift; cmd_audit "$@" ;;
    vault)     shift; cmd_vault "$@" ;;
    secret)    shift; cmd_secret "$@" ;;
    -h|--help|help|"") usage ;;
    *) usage; exit 2 ;;
esac
