# Sauvegarde par le core ; un compte par service : sous root seul, le core sous le compte de la console (app_console : il lit les clés de elpis-cle, pas l'autorité privée du relais de l'hôte d'outils) écrit l'archive sur sa sortie, que root reçoit dans backups/ et rend à l'opérateur (0600) ; ni --dest ni chemin pris à config.json.
cmd_backup() {
    local rc=0 op og tmp nom libelle
    charger_instance
    need_exploitation
    if [ "$(mode_installe)" != separes ]; then core_cmd backup "$@"; return; fi
    [ "$(id -u)" -eq 0 ] || die "Un compte par service : seul root lit toutes les clés à sauvegarder ; lancez sudo ./elpis backup${*:+ $*}"
    case " $* " in *" --dest"*) die "Un compte par service : l'archive va dans backups/ (--dest refusé), copiez-la ensuite." ;; esac
    case "${1:-full}" in
        full) libelle=complet ;; db|sandboxes|mcp) libelle="$1" ;;
        -h|--help) app_console "$NODE" "$CORE_DIST/exploitation.mjs" backup --help; return ;;
        *) die "Usage : sudo ./elpis backup [full|db|sandboxes|mcp]" ;;
    esac
    op="${SUDO_USER:-}"; [ -n "$op" ] && [ "$op" != root ] || op="$(stat -c %U -- "$ROOT")"
    og="$(id -gn "$op")" || return 1
    poser_droits dossier "$ROOT/backups" 0700 "$op" "$og" --creer || die "Dossier $ROOT/backups refusé (voir ci-dessus)."
    tmp="$(mktemp "$ROOT/backups/.sauvegarde.XXXXXX")" || die "Archive temporaire impossible dans $ROOT/backups."
    app_console --brut --env ELPIS_SAUVEGARDE_SUR_SORTIE=1 "$NODE" "$CORE_DIST/exploitation.mjs" backup "$@" > "$tmp"; rc=$?
    if [ ! -s "$tmp" ] || { [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ] && [ "$rc" -ne 3 ]; }; then rm -f -- "$tmp"; return "$rc"; fi
    nom="backup_${libelle}_$(date +%s)$([ "$rc" -ne 3 ] || echo _incomplet).zip"
    { chown -- "$op:$og" "$tmp" && chmod 0600 -- "$tmp" && mv -n -T -- "$tmp" "$ROOT/backups/$nom"; } \
        || { rm -f -- "$tmp"; die "Archive non rangée dans $ROOT/backups."; }
    printf '%s\n' "$ROOT/backups/$nom"
    return "$rc"
}

# Base de données : état, test d'une cible, copie, choix du moteur (« use sqlite » ne touche à aucune base) ; root sous un compte par service : mot de passe de --password-env NOM lu dans l'environnement de root, remis à la console par son fichier d'environnement (jamais sur une ligne de commande).
cmd_db() {
    local i nom=""
    refuser_operateur_separe "db $*"
    charger_instance
    need_exploitation
    if racine_separee; then
        for ((i = 1; i <= $#; i++)); do
            case "${!i}" in --password-env) i=$((i + 1)); nom="${!i:-}" ;; --password-env=*) nom="${!i#*=}" ;; esac
        done
    fi
    if [ -n "$nom" ]; then
        motif "$nom" '^[A-Z_][A-Z0-9_]*$' || die "--password-env : nom « $nom » refusé (majuscules, chiffres et _ seulement)."
        [ -n "${!nom+x}" ] || die "--password-env : $nom absente de l'environnement de root (sudo --preserve-env=$nom ./elpis db …)."
        app_console --env "$nom=${!nom}" "$NODE" "$CORE_DIST/exploitation.mjs" db "$@"; return
    fi
    core_cmd db "$@"
}

# Compte des services pour « audit setup » et « vault setup » (COMPTE_SETUP, MODE_COMPTES des unités) : mode séparé, l'écrivain du journal ${UNIT_PREFIX}-main ; sinon User= des unités, ELPIS_USER, SUDO_USER ; jamais root ; root exigé hors arborescence factice.
compte_setup() {
    local quoi="$1" unite
    MODE_COMPTES="$(mode_installe)"
    if [ "$MODE_COMPTES" = separes ]; then
        unite="$UNIT_PREFIX-main"
    else
        unite="$(compte_services)"
        if [ -n "$unite" ] && [ -n "${ELPIS_USER:-}" ] && [ "$ELPIS_USER" != "$unite" ]; then
            die "Les services tournent sous $unite (User= des unités systemd), pas sous ELPIS_USER=$ELPIS_USER : sudo ELPIS_USER=$ELPIS_USER ./elpis service install pour changer de compte."
        fi
    fi
    COMPTE_SETUP="${unite:-${ELPIS_USER:-${SUDO_USER:-}}}"
    if [ -z "$SYS_PREFIXE" ]; then
        [ "$(id -u)" -eq 0 ] || die "Lancez avec sudo : sudo ./elpis $quoi setup"
    else
        COMPTE_SETUP="${COMPTE_SETUP:-$(id -un)}"
    fi
    [ -n "$COMPTE_SETUP" ] && [ "$COMPTE_SETUP" != root ] \
        || die "Utilisateur de service inconnu : lancez via sudo depuis votre compte, ou ELPIS_USER=nom."
    id -u "$COMPTE_SETUP" >/dev/null 2>&1 || die "Compte de service $COMPTE_SETUP inexistant (ELPIS_USER=nom)."
    if [ "$MODE_COMPTES" = separes ]; then info "Comptes des services : un par service (unités systemd installées)."
    elif [ -n "$unite" ] && [ "$unite" != "${SUDO_USER:-}" ]; then info "Compte des services : $unite (unités systemd installées)."; fi
}

# Journal de sécurité : mise en place (setup, root) ou vérification des signatures et de la continuité (verify ; root et clés remises par systemd : chaque --key FICHIER, relatif au dossier d'Elpis, remis à la console par systemd, CLES_REMISES).
cmd_audit() {
    local a=() f CLES_REMISES=()
    if [ "${1:-}" = "setup" ]; then
        compte_setup audit
        audit_setup "$COMPTE_SETUP" "" 1 || die "Journal de sécurité incomplet : voir ci-dessus, puis relancez sudo ./elpis audit setup."
        if [ "$MODE_COMPTES" = separes ]; then ok "Journal de sécurité en place (un compte par service)."; else ok "Journal de sécurité en place (compte $COMPTE_SETUP)."; fi
        if [ "$MODE_COMPTES" = separes ] && cles_systemd; then
            info "Clé du journal remise par systemd : copie hors de la machine : sudo sh -c 'umask 077; systemd-creds decrypt --name=audit.key $CLES_SYS/audit.key FICHIER' (support hors ligne)."
            cle_des_unites audit.key || info "Unités sans cette clé : sudo ./elpis service install."
        fi
        return 0
    fi
    charger_instance
    need_exploitation
    refuser_operateur_separe "audit $*"
    if racine_separee && cles_systemd && [ $# -gt 0 ]; then
        a=("$1"); shift
        while [ $# -ge 2 ]; do
            f="$2"
            if [ "$1" = --key ]; then
                case "$f" in /*) ;; *) f="$ROOT/$f" ;; esac
                CLES_REMISES+=("audit-cle-$((${#CLES_REMISES[@]} + 1)).key=$f")
            fi
            a+=("$1" "$f"); shift 2
        done
        set -- "${a[@]}" "$@"
    fi
    core_cmd audit "$@"
}

# Coffre « Secrets » : clé (setup en root ; status ; rekey, ancienne clé relative au dossier d'Elpis, rendue absolue ; clés remises par systemd : ancienne clé remise à la console par systemd, CLES_REMISES) ; doctor sert ./elpis doctor.
cmd_vault() {
    local f CLES_REMISES=()
    case "${1:-}" in
        setup)
            [ $# -eq 1 ] || die "Usage : sudo ./elpis vault setup"
            vault_setup ;;
        status|rekey|doctor)
            charger_instance
            need_exploitation
            refuser_operateur_separe "vault $*"
            if [ "$1" = rekey ] && [ "${2:-}" = --from ] && [ -n "${3:-}" ]; then
                f="$3"; case "$f" in /*) ;; *) f="$ROOT/$f" ;; esac
                set -- rekey --from "$f" "${@:4}"
                ! racine_separee || ! cles_systemd || CLES_REMISES=("vault-ancienne.key=$f")
            fi
            vault_core vault "$@" ;;
        *) die "Usage : sudo ./elpis vault setup | ./elpis vault status | ./elpis vault rekey --from FICHIER" ;;
    esac
}

