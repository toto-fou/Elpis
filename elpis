# PID vivant de SERVICE (user_db/run/SERVICE.pid) ; root : lu par deploy/droits.py (fichier ordinaire, sans lien, chiffres seuls : ni FIFO ni /dev/zero).
pid_of() {
    if [ "$(id -u)" -eq 0 ]; then local p; p="$(poser_droits pid "$RUN_DIR" "$1.pid" 2>/dev/null)" && kill -0 "$p" 2>/dev/null && printf '%s\n' "$p"; return; fi
    local f="$RUN_DIR/$1.pid"; [ -s "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null && cat "$f"
}

# signaler SIGNAL PID : root, le processus seul (jamais son groupe : le PID vient d'un fichier que les services écrivent) ; sinon son groupe, à défaut lui.
signaler() {
    if [ "$(id -u)" -eq 0 ]; then kill -s "$1" "$2" 2>/dev/null; else kill -s "$1" -- "-$2" 2>/dev/null || kill -s "$1" "$2" 2>/dev/null; fi
}

# PID à signaler, lu dans user_db/run (écrit par le compte des services) : nombre > 1 ; en root, processus du compte des services, du propriétaire du dépôt ou de COMPTES_ARRET, jamais de root ; sous un compte par service, pour SERVICE, de son compte (et de COMPTES_ARRET pendant service install) seulement.
pid_signalable() {
    local uid u comptes
    motif "$1" '^[0-9]{1,9}$' && [ "$1" -gt 1 ] || return 1
    [ "$(id -u)" -eq 0 ] || return 0
    uid="$(awk '$1 == "Uid:" { print $2; exit }' "/proc/$1/status" 2>/dev/null)"
    [ -n "$uid" ] && [ "$uid" != 0 ] || return 1
    comptes="$(compte_services) $(stat -c %U -- "$ROOT") ${COMPTES_ARRET:-}"
    [ -z "${2:-}" ] || [ "$(mode_installe)" != separes ] || comptes="$UNIT_PREFIX-$2 ${COMPTES_ARRET:-}"
    for u in $comptes; do
        [ "$uid" = "$(id -u "$u" 2>/dev/null)" ] && return 0
    done
    return 1
}

systemd_active() { command -v systemctl >/dev/null && systemctl is-active --quiet "${UNIT_PREFIX}.target" 2>/dev/null; }
systemd_installed() { [ -f "/etc/systemd/system/${UNIT_PREFIX}.target" ]; }

wait_port() {
    local port="$1" n="${2:-40}"
    for _ in $(seq 1 "$n"); do port_open "$port" && return 0; sleep 0.5; done
    return 1
}

# attendre SERVICE SECONDES COMMANDE… : réussit dès que la commande réussit ; échoue au délai, ou dès que le service s'arrête.
attendre() {
    local s="$1" fin=$((SECONDS + $2)); shift 2
    until "$@" >/dev/null 2>&1; do
        { pid_of "$s" >/dev/null && [ "$SECONDS" -lt "$fin" ]; } || return 1
        sleep 0.5
    done
}

# Santé de main et admin (/api/health) sous ELPIS_ATTENTE_SANTE secondes (120) ; sinon la fin de leur journal et un code non nul.
attendre_sante() {
    local s port rc=0 fin=$((SECONDS + ${ELPIS_ATTENTE_SANTE:-120}))
    for s in main admin; do
        port="$(svc_port "$s")"
        attendre "$s" "$((fin - SECONDS))" curl --noproxy '*' -fsS -m 2 -o /dev/null "http://127.0.0.1:$port/api/health" && continue
        if pid_of "$s" >/dev/null; then
            warn "$s ne répond pas sur /api/health (port $port) après ${ELPIS_ATTENTE_SANTE:-120} s. Fin de son journal ($LOG_DIR/$s.log) :"
        else
            warn "$s s'est arrêté sans répondre sur /api/health (port $port). Fin de son journal ($LOG_DIR/$s.log) :"
        fi
        if [ "$(id -u)" -eq 0 ] || separe_vise; then poser_droits journal --lignes 20 "$LOG_DIR/$s.log" 2>/dev/null
        else tail -n 20 "$LOG_DIR/$s.log" 2>/dev/null; fi | sed 's/^/    /' >&2
        rc=1
    done
    [ "$rc" -eq 0 ] && ok "main et admin répondent (/api/health)."
    return "$rc"
}

# =============================================================================
#  start / stop / status / logs
# =============================================================================
# Journal d'un service hors systemd : au-delà de 64 Mio, renommé en .1 (3 anciens gardés) avant le démarrage.
tourner_journal() {
    local f="$1" i
    [ -f "$f" ] || return 0
    [ "$(stat -c %s "$f" 2>/dev/null || echo 0)" -gt $((64 * 1024 * 1024)) ] || return 0
    for i in 2 1; do [ -f "$f.$i" ] && mv -f "$f.$i" "$f.$((i + 1))"; done
    mv -f "$f" "$f.1"
}

cmd_start() {
    local foreground=0
    [ "${1:-}" = "--foreground" ] && foreground=1
    refuser_racine_separee start
    systemd_active && die "Les services systemd ${UNIT_PREFIX}.target tournent déjà (systemctl status ${UNIT_PREFIX}.target)."
    load_runtime
    need_core
    [ -f "$ROOT/deploy/node/relance.sh" ] || die "deploy/node/relance.sh absent (mise à jour incomplète) : ./install.sh, ou ./install.sh --offline <paquet de cette version>"
    { pid_of main || pid_of admin; } >/dev/null || deplacer_memoire "${SANDBOX_DIR:-}" "$(core_cmd config MEMORY_DIR 2>/dev/null)"
    migrer_mcp
    local s started=() retirer=()
    for s in "${SERVICES[@]}"; do
        if ! svc_available "$s"; then warn "$s non installé : ignoré."; continue; fi
        if pid_of "$s" >/dev/null; then info "$s tourne déjà (pid $(pid_of "$s"))."; continue; fi
        svc_spec "$s"
        tourner_journal "$LOG_DIR/$s.log"
        info "Démarrage de $s…"
        case "$s" in main|admin) retirer=() ;; *) retirer=(-u ELPIS_VAULT_KEY -u ELPIS_VAULT_KEY_PATH) ;; esac
        ( cd "$SPEC_DIR" && exec env ${retirer[@]+"${retirer[@]}"} "${SPEC_ENV[@]}" setsid ${SPEC_LANCEUR[@]+"${SPEC_LANCEUR[@]}"} "${SPEC_CMD[@]}" ) \
            >>"$LOG_DIR/$s.log" 2>&1 </dev/null &
        echo $! > "$RUN_DIR/$s.pid"
        started+=("$s")
        # Les suivants dépendent de Qdrant et de l'hôte d'outils : on les attend.
        case "$s" in
            qdrant|toolhost) attendre "$s" 20 port_open "$(svc_port "$s")" || warn "$s ne répond pas encore (voir ./elpis logs $s)." ;;
        esac
    done
    local rc=0
    attendre_sante || rc=1
    cmd_status
    local host="localhost"
    if _https_enabled; then
        info "Mode HTTPS : accès par le frontal Caddy (https://<hôte>/)."
    else
        info "Application : http://$host:$MAIN_PORT/   Administration : http://$host:$ADMIN_PORT/admin"
        [ "$BIND_DEFAULT" = "127.0.0.1" ] && info "Écoute locale (security.listen) : joignable depuis ce serveur seulement."
    fi
    if [ "$foreground" -eq 1 ]; then
        [ "$rc" -eq 0 ] || { cmd_stop; return 1; }
        trap 'cmd_stop; exit 0' INT TERM
        info "Premier plan : Ctrl-C arrête tout."
        while :; do sleep 5; done
    fi
    return "$rc"
}

# tuer_fils PID : SIGKILL aux groupes des fils directs (le core lancé par relance.sh a son propre groupe ; root : à chaque fils seul).
tuer_fils() {
    local c
    for c in $(cat /proc/"$1"/task/*/children 2>/dev/null || pgrep -P "$1" 2>/dev/null); do
        pid_signalable "$c" || continue
        signaler KILL "$c"
    done
}

# arreter SERVICE… : SIGTERM à chacun, attente commune (310 s si le core en est, 20 s sinon), SIGKILL au-delà.
arreter() {
    local s i n pid vivant attente=40 pids=() noms=()
    for s in "$@"; do
        pid="$(pid_of "$s")" || { retirer_pid "$s"; continue; }
        if ! pid_signalable "$pid" "$s"; then warn "$s : pid « $pid » de $RUN_DIR/$s.pid hors des comptes d'Elpis : non signalé (à vérifier)."; continue; fi
        info "Arrêt de $s (pid $pid)…"
        signaler TERM "$pid"
        pids+=("$pid"); noms+=("$s")
        case "$s" in main|admin) attente=620 ;; esac
    done
    for (( n=1; n<=attente; n++ )); do
        vivant=0
        for pid in "${pids[@]}"; do kill -0 "$pid" 2>/dev/null && vivant=1; done
        [ "$vivant" -eq 1 ] || break
        [ "$n" -eq 20 ] && [ "$attente" -gt 40 ] && info "Le core finit ses requêtes en cours (300 s au plus)…"
        sleep 0.5
    done
    for i in "${!pids[@]}"; do
        pid="${pids[$i]}"
        case "${noms[$i]}" in main|admin) kill -0 "$pid" 2>/dev/null && tuer_fils "$pid" ;; esac
        kill -0 "$pid" 2>/dev/null && signaler KILL "$pid"
        retirer_pid "${noms[$i]}"
    done
}

# Fichier PID d'un service retiré ; root : par deploy/droits.py, sans suivre de lien (user_db/run est aux services).
retirer_pid() {
    if [ "$(id -u)" -eq 0 ]; then poser_droits retirer "$RUN_DIR" "$1.pid" || true; else rm -f "$RUN_DIR/$1.pid"; fi
}

# ptrace_restreint MODE : un compte par service : kernel.yama.ptrace_scope = 1 (défaut d'Ubuntu ; réglage de tout l'hôte) dans /etc/sysctl.d/05-elpis-ptrace.conf (trié en premier : une valeur plus stricte d'un autre fichier l'emporte au démarrage), écrit et appliqué seulement quand la valeur est 0 : la console ne trace plus les commandes que root lance sous son compte ; autre mode : fichier retiré (valeur rendue au prochain démarrage).
ptrace_restreint() {
    local f="$SYS_PREFIXE/etc/sysctl.d/05-${UNIT_PREFIX}-ptrace.conf" v
    rm -f -- "$SYS_PREFIXE/etc/sysctl.d/60-${UNIT_PREFIX}.conf"
    if [ "$1" != separes ]; then
        [ ! -e "$f" ] || { rm -f -- "$f" && info "$f retiré (ptrace : réglage de l'hôte, rendu au prochain démarrage)."; }
        return 0
    fi
    v="$(cat -- "$SYS_PREFIXE/proc/sys/kernel/yama/ptrace_scope" 2>/dev/null)" \
        || { warn "ptrace : module Yama absent du noyau : la console peut tracer les commandes que root lance sous son compte (noyau avec Yama conseillé)."; return 1; }
    [ "$v" = 0 ] || return 0
    printf '# %s\nkernel.yama.ptrace_scope = 1\n' "Elpis, un compte par service (sudo ./elpis service install) : ptrace limité aux descendants." > "$f" \
        && sysctl -q -p "$f" >/dev/null && info "ptrace limité aux descendants (kernel.yama.ptrace_scope = 1, $f)." \
        || { warn "ptrace : $f non écrit ou non appliqué (sysctl) : la console peut tracer les commandes que root lance sous son compte."; return 1; }
}

# Unités à un compte par service : jamais de service lancé à la main, ni sous root (il tournerait sous root) ni sous l'opérateur (sans les clés des services, le core en créerait d'autres près de la base).
refuser_racine_separee() {
    local qui=""
    [ "$(mode_installe)" = separes ] || return 0
    [ "$(id -u)" -ne 0 ] || qui=" sous root"
    die "Un compte par service : les services se lancent par systemd (sudo systemctl $1 ${UNIT_PREFIX}.target), jamais à la main$qui."
}

# Le core d'abord, main et admin ensemble : outils et RAG servent encore pendant qu'il finit.
cmd_stop() {
    local i s
    arreter main admin
    for (( i=${#SERVICES[@]}-1; i>=0; i-- )); do
        s="${SERVICES[$i]}"
        case "$s" in main|admin) ;; *) arreter "$s" ;; esac
    done
    arreter "${SERVICES_RETIRES[@]}"
    ok "Services arrêtés."
}

# Migrations de la base vues par le core : celles en attente s'appliquent au démarrage.
cmd_migrations() {
    local out rc
    [ -f "$CORE_DIST/exploitation.mjs" ] || { warn "Base : core non construit, migrations non vérifiées."; return 0; }
    out="$(core_cmd migrations 2>&1)"; rc=$?
    case "$rc" in
        0) info "Base : $out" ;;
        *) warn "Base : ${out:-vérification impossible}" ;;
    esac
    return 0
}

cmd_status() {
    local s pid port state
    charger_env
    if systemd_active; then info "Géré par systemd (${UNIT_PREFIX}.target)."; fi
    printf '  %-10s %-8s %-7s %s\n' SERVICE PID PORT ÉTAT
    for s in "${SERVICES[@]}"; do
        pid="$(pid_of "$s" || true)"; port="$(svc_port "$s")"
        if ! svc_available "$s"; then state="non installé"
        elif port_open "$port"; then state="à l'écoute"
        elif [ -n "$pid" ]; then state="démarrage…"
        else state="arrêté"; fi
        printf '  %-10s %-8s %-7s %s\n' "$s" "${pid:--}" "$port" "$state"
    done
}

cmd_logs() {
    local svc="" compte="" follow=0 a c
    for a in "$@"; do
        case "$a" in -f|--follow) follow=1 ;; *) if [ -z "$svc" ]; then svc="$a"; else compte="$a"; fi ;; esac
    done
    # ./elpis logs browser COMPTE : journal du service navigateur dans le bac du compte (le seul navigateur).
    if [ "$svc" = browser ]; then
        [ -n "$compte" ] || die "Le navigateur tourne dans la sandbox de chaque compte : ./elpis logs browser COMPTE [-f]."
        c="$(docker ps -q --filter "label=elpis.username=$compte" | head -n1)"
        [ -n "$c" ] || die "Aucun bac en marche pour le compte $compte."
        # Journal écrit dans le bac (hostile) : caractères de contrôle et séquences C1 retirés avant le terminal (tabulation et fin de ligne gardées).
        docker exec --user 10001:10001 -e PATH=/usr/sbin:/usr/bin:/sbin:/bin "$c" tail -n 50 $([ "$follow" -eq 1 ] && echo -F) /work/.elpis-browser/service.log \
            | filtre_affichage
        exit "${PIPESTATUS[0]}"
    fi
    if systemd_active && [ -n "$svc" ]; then
        [ ! -t 1 ] || exec journalctl -u "${UNIT_PREFIX}-$svc" $([ "$follow" -eq 1 ] && echo -f)
        journalctl -u "${UNIT_PREFIX}-$svc" $([ "$follow" -eq 1 ] && echo -f) | filtre_affichage
        exit "${PIPESTATUS[0]}"
    fi
    local files=()
    if [ -n "$svc" ]; then files=("$LOG_DIR/$svc.log"); else files=("$LOG_DIR"/*.log); fi
    [ -e "${files[0]}" ] || die "Aucun journal dans $LOG_DIR."
    if [ "$(id -u)" -eq 0 ] || separe_vise; then poser_droits journal $([ "$follow" -eq 1 ] && echo --suivre) "${files[@]}"; exit $?; fi
    if [ "$follow" -eq 1 ]; then exec tail -n 50 -F "${files[@]}"; else tail -n 50 "${files[@]}"; fi
}

# =============================================================================
#  service install / remove (systemd)
# =============================================================================
# _chemin_unite NOM VALEUR : chemin rendu dans une unité systemd : absolu, lettres, chiffres et « . _ @ + / - » seulement, 4096 caractères au plus ; sinon arrêt, rien n'est installé.
_chemin_unite() {
    motif "$2" '^/[A-Za-z0-9._@+/-]+$' && [ "${#2}" -le 4096 ] && return 0
    die "$1 : « $2 » refusé pour une unité systemd (chemin absolu ; lettres, chiffres et . _ @ + / - seulement) : rien n'est installé."
}

# _valeur_unite NOM VALEUR : autre valeur rendue dans une unité : ni caractère de contrôle (fin de ligne comprise) ni « " \ % $ ` », 4096 caractères au plus ; sinon arrêt.
_valeur_unite() {
    local interdit=$'[[:cntrl:]"\\%$`]'
    ! motif "$2" "$interdit" && [ "${#2}" -le 4096 ] && return 0
    die "$1 : « $2 » refusé pour une unité systemd (caractère de contrôle, \", \\, %, \$ ou \`) : rien n'est installé."
}

# _mot_unite NOM VALEUR nom|unite|arg|variable : compte ou groupe, unité systemd, argument de commande ou nom de variable d'une unité, à son motif ; sinon arrêt.
_mot_unite() {
    local m
    case "$3" in
        nom) m='^[A-Za-z0-9_][A-Za-z0-9._-]*$' ;;
        unite) m='^[A-Za-z0-9_][A-Za-z0-9@._:-]*\.(service|target)$' ;;
        arg) m='^[A-Za-z0-9._@+/:=-]+$' ;;
        *) m='^[A-Za-z_][A-Za-z0-9_]*$' ;;
    esac
    motif "$2" "$m" && [ "${#2}" -le 256 ] && return 0
    die "$1 : « $2 » refusé pour une unité systemd : rien n'est installé."
}

# _env_unite_sure NOM=VALEUR : variable d'environnement d'une unité : nom de variable ; valeur d'un chemin (…_DIR, …_PATH, …_FILE, ELPIS_RACINE) au motif des chemins, sinon sans caractère dangereux.
_env_unite_sure() {
    _mot_unite "Variable d'unité" "${1%%=*}" variable
    case "${1%%=*}" in
        *_DIR|*_PATH|*_FILE|ELPIS_RACINE) _chemin_unite "${1%%=*}" "${1#*=}" ;;
        *) _valeur_unite "${1%%=*}" "${1#*=}" ;;
    esac
}

# _rendre_gabarit GABARIT → le gabarit, chaque @NOM@ remplacé par GAB[NOM] en une passe (une valeur n'est jamais relue) ; une ligne faite d'un seul @NOM@ reçoit GAB[NOM] tel quel (plusieurs lignes ou aucune) ; @NOM@ inconnu : échec.
_rendre_gabarit() {
    local ligne cle reste sortie
    while IFS= read -r ligne || [ -n "$ligne" ]; do
        if motif "$ligne" '^@([A-Z_]+)@$' && [ -n "${GAB[${BASH_REMATCH[1]}]+x}" ]; then
            [ -z "${GAB[${BASH_REMATCH[1]}]}" ] || printf '%s\n' "${GAB[${BASH_REMATCH[1]}]}"
            continue
        fi
        sortie=""; reste="$ligne"
        while motif "$reste" '@([A-Z_]+)@'; do
            cle="${BASH_REMATCH[1]}"
            [ -n "${GAB[$cle]+x}" ] || { warn "$1 : @$cle@ sans valeur."; return 1; }
            sortie+="${reste%%"@$cle@"*}${GAB[$cle]}"; reste="${reste#*"@$cle@"}"
        done
        printf '%s\n' "$sortie$reste"
    done < "$1"
}

# _chemins_hors_depot DOSSIER_BASE → lignes « services<TAB>dossier » des dossiers de données que le core place hors du dépôt (il les connaît, pas ce script) ; un compte par service : ceux que les unités fixent (CHEMINS_FIXES) et le dossier de la base, jamais config.json.
_chemins_hors_depot() {
    local nom d e
    if [ "${MODE_COMPTES:-}" = separes ]; then
        for e in "${CHEMINS_FIXES[@]}"; do
            case "${e%%=*}" in
                MCP_SERVERS_DIR|APP_MEMORY_DIR|APP_SKILLS_DIR|APP_USER_SKILLS_DIR|APP_SKINS_DIR) printf 'main admin\t%s\n' "${e#*=}" ;;
                APP_FILE_HISTORY_DIR|APP_OFFICE_CACHE_DIR) printf 'toolhost\t%s\n' "${e#*=}" ;;
            esac
        done
        printf 'main admin\t%s\n' "$1"
        return 0
    fi
    for nom in MCP_SERVERS_DIR MEMORY_DIR USER_SKILLS_DIR SKINS_DIR; do
        d="$(core_cmd config "$nom" 2>/dev/null)" || continue
        [ -z "$d" ] || printf 'main admin\t%s\n' "$d"
    done
    [ -z "$1" ] || printf 'main admin\t%s\n' "$1"
    lanceur ecritures
}

# Dossiers d'état d'un service : lignes ReadWritePaths= (ceux de _chemins_hors_depot, passés en 2e argument, que ce service écrit compris ; pour main et la console, ceux de la racine, config.json étant chez la console, et en mode séparé ni le dossier des sandboxes ni ceux de l'hôte d'outils, en lecture seule même dans user_db ; Qdrant sous un compte unique : son dossier du dépôt, binaire et réglages en lecture seule) ; chaque chemin validé d'abord (_chemin_unite), puis un dossier refusé d'après son chemin (chemin_etat_sur) est écarté.
_ecritures_du_service() {
    local d s l=() vu=" " ro=()
    case "$1" in
        main|admin) l=("$ROOT/user_db" "$LOG_DIR" "$ROOT/system_prompts" "$ROOT/skills" "$ROOT/user_skins"
                       "$ROOT/user_skills" "$RAG_STORE" "$CHART_DIR" "$AUDIT_DIR_SYS" "$APPLOG_DIR_SYS")
                    if [ "$MODE_COMPTES" = separes ]; then ro=("$(fixe APP_FILE_HISTORY_DIR)" "$(fixe APP_OFFICE_CACHE_DIR)"); else l+=("$SANDBOX_DIR"); fi
                    [ "$1" = main ] || l+=("$CONFIG_SYS") ;;
        toolhost)   l=("$ROOT/user_db" "$LOG_DIR" "$SANDBOX_DIR" "$CHART_DIR" "$AUDIT_DIR_SYS") ;;
        rag)        [ "$MODE_COMPTES" = separes ] || l=("$RAG_CACHE") ;;
        qdrant)     [ "$MODE_COMPTES" = separes ] || printf 'ReadWritePaths=%s\nReadOnlyPaths=-%s/qdrant -%s/config.yaml\n' \
                        "$ROOT/rag_app/qdrant" "$ROOT/rag_app/qdrant" "$ROOT/rag_app/qdrant"
                    return 0 ;;
    esac
    while IFS=$'\t' read -r s d; do
        case " $s " in *" $1 "*) l+=("$d") ;; esac
    done <<< "${2:-}"
    for d in "${l[@]}"; do
        [ -n "$d" ] || continue
        _chemin_unite "Dossier d'écriture de $1" "$d"
        case "$vu" in *" $d "*) continue ;; esac
        case "$d" in "$AUDIT_DIR_SYS"|"$APPLOG_DIR_SYS"|"$CONFIG_SYS"|"$ROOT/system_prompts"|"$ROOT/skills") ;; *) chemin_etat_sur "$d" || continue ;; esac
        vu+="$d "
        printf 'ReadWritePaths=-%s\n' "$d"
    done
    for d in ${ro[@]+"${ro[@]}"}; do
        [ -n "$d" ] || continue
        _chemin_unite "Dossier en lecture seule de $1" "$d"
        printf 'ReadOnlyPaths=-%s\n' "$d"
    done
}

# ProtectHome : « read-only » si le dépôt, un dossier d'état, le compte des services, les navigateurs de Playwright ou un chemin donné (Node, Python, autorités, dossiers de données) sont sous /home, /root ou /run/user ; sinon « yes ».
_protection_home() {
    local d maison
    maison="$(getent passwd "$1" 2>/dev/null | cut -d: -f6)"
    shift
    for d in "$ROOT" "$SANDBOX_DIR" "$RAG_STORE" "$RAG_CACHE" "$CHART_DIR" "$maison" "${PLAYWRIGHT_BROWSERS_PATH:-}" \
             "${SSL_CERT_FILE:-}" "${SSL_CERT_DIR:-}" "${NODE_EXTRA_CA_CERTS:-}" "${GIT_SSL_CAINFO:-}" \
             "${ELPIS_SANDBOX_IMAGE_TAR:-}" "$@"; do
        case "$d" in /home|/home/*|/root|/root/*|/run/user|/run/user/*) echo read-only; return 0 ;; esac
    done
    echo yes
}

# Retire le dossier de rendu en cours (et celui de « service print ») quand le script s'arrête.
_nettoyer_rendu() { rm -rf "${STAGE_RENDU:-}" "${TMP_PRINT:-}"; }

# Compte d'une unité (User=, groupes et dossiers propres) : un compte par service en mode séparé (Docker à l'hôte d'outils seul, cache systemd au RAG, compte dynamique et dossier d'état à Qdrant), le compte unique sinon.
_compte_unite() {
    case "$MODE_COMPTES:$1" in
        separes:main|separes:admin) echo "User=$UNIT_PREFIX-$1" ;;
        separes:toolhost) echo "User=$UNIT_PREFIX-toolhost"; if getent group docker >/dev/null; then echo "SupplementaryGroups=docker"; fi ;;
        separes:rag) printf 'User=%s\nCacheDirectory=%s\n' "$UNIT_PREFIX-rag" "$UNIT_PREFIX-rag" ;;
        separes:qdrant) printf 'DynamicUser=yes\nStateDirectory=%s\n' "$UNIT_PREFIX-qdrant" ;;
        *) echo "User=$2" ;;
    esac
}

# umask d'une unité : mode séparé, main et console 0007, hôte d'outils 0027 (le groupe des données lit ce qu'il écrit sans pouvoir l'écrire ; le code pose lui-même les modes de ce qu'il partage avec les bacs), RAG 0077 ; compte unique : 0027, hôte d'outils 0022 ; Qdrant 0077.
_umask_unite() {
    case "$MODE_COMPTES:$1" in
        separes:main|separes:admin) echo 0007 ;;
        separes:toolhost) echo 0027 ;;
        *:toolhost) echo 0022 ;;
        *:qdrant|separes:rag) echo 0077 ;;
        *) echo 0027 ;;
    esac
}

# Environnement, dossier et commande propres au mode des comptes (Qdrant lancé avec sa clé d'API remise par systemd : deploy/qdrant/lancer.sh) : ELPIS_COMPTES (main, admin, toolhost) ; en mode séparé, les chemins des données fixés (CHEMINS_FIXES : config.json ne les change plus), ELPIS_GROUPE_DONNEES, ELPIS_GROUPE_CLE (main et console : groupe des secrets des sauvegardes distantes), le jeton du RAG hors de user_db (main, console, RAG ; remis par systemd, il passe par _cles_unite), le cache systemd du RAG, le stockage de Qdrant dans son dossier d'état et, pour l'hôte d'outils, les navigateurs des bacs (NAV).
_env_comptes() {
    local e jeton=()
    case "$1" in main|admin|toolhost) SPEC_ENV+=("ELPIS_COMPTES=$MODE_COMPTES") ;; esac
    [ "$MODE_COMPTES" = separes ] || return 0
    jeton=("RAG_SERVICE_TOKEN_FILE=$JETON_RAG_SYS"); ! cles_systemd || ! cle_presente rag.token || jeton=()
    case "$1" in
        main|admin) SPEC_ENV+=("ELPIS_GROUPE_DONNEES=$GROUPE_DONNEES" "ELPIS_GROUPE_CLE=$GROUPE_CLE" ${jeton[@]+"${jeton[@]}"})
                    for e in "${CHEMINS_FIXES[@]}"; do _env_unite "$e"; done ;;
        toolhost) SPEC_ENV+=("ELPIS_GROUPE_DONNEES=$GROUPE_DONNEES"); [ -z "$2" ] || SPEC_ENV+=("PLAYWRIGHT_BROWSERS_PATH=$2")
                  for e in "${CHEMINS_FIXES[@]}"; do _env_unite "$e"; done ;;
        rag) _env_unite "RAG_CACHE_DIR=/var/cache/$UNIT_PREFIX-rag"
             if [ "${#jeton[@]}" -eq 0 ]; then _env_retire RAG_SERVICE_TOKEN_FILE; else _env_unite "${jeton[0]}"; fi ;;
        qdrant) SPEC_DIR="/var/lib/$UNIT_PREFIX-qdrant"
                SPEC_ENV+=("QDRANT__STORAGE__STORAGE_PATH=$SPEC_DIR/storage" "QDRANT__STORAGE__SNAPSHOTS_PATH=$SPEC_DIR/storage/snapshots")
                ! cles_systemd || ! cle_presente qdrant.key || SPEC_CMD=(/bin/sh "$ROOT/deploy/qdrant/lancer.sh" "${SPEC_CMD[@]}") ;;
    esac
}

# Lignes des clés remises par systemd au service S (un compte par service, systemd 250 ou plus) : pour chaque clé de S présente dans le magasin (vu par ce compte), LoadCredentialEncrypted= et sa variable (%d : dossier des credentials du service) ; aucune sinon (fichiers du bloc 5).
_cles_unite() {
    local n v
    [ "$MODE_COMPTES" = separes ] && cles_systemd || return 0
    for n in $(cles_du_service "$1"); do
        cle_presente "$n" || { [ "$n" != audit.key ] || warn "unité $1 sans la clé $n (absente de $CLES_SYS) : systemd ne la lui remet pas (sudo ./elpis audit setup, puis sudo ./elpis service install)"; continue; }
        printf 'LoadCredentialEncrypted=%s:%s/%s\n' "$n" "$CLES_SYS" "$n"
        v="$(variable_de_cle "$n" "$1")"
        [ -z "$v" ] || printf 'Environment="%s=%%d/%s"\n' "$v" "$n"
    done
}

# NOM retiré de l'environnement de l'unité en cours (SPEC_ENV).
_env_retire() {
    local e l=()
    for e in "${SPEC_ENV[@]}"; do [ "${e%%=*}" = "$1" ] || l+=("$e"); done
    SPEC_ENV=(${l[@]+"${l[@]}"})
}

# NOM=VALEUR dans l'environnement de l'unité en cours (SPEC_ENV), à la place d'une valeur déjà donnée.
_env_unite() { _env_retire "${1%%=*}"; SPEC_ENV+=("$1"); }

# Dossier de la base pour root : celui d'APP_DB_PATH (environnement, .env), sinon user_db ; celui du core (DOSSIER, config.json compris) doit être le même, sinon rien, avec la marche à suivre.
base_sure() {
    local b="${APP_DB_PATH:-user_db/app.db}"
    [[ "$b" == /* ]] || b="$ROOT/$b"
    b="${b%/*}"
    if [ "$(realpath -m -- "$b")" = "$(realpath -m -- "$1")" ]; then printf '%s\n' "$b"; return 0; fi
    warn "Base de config.json ($1) non confirmée par APP_DB_PATH (.env) : secrets et droits de ce dossier non posés (APP_DB_PATH=$1/… dans .env, puis sudo ./elpis service install)."
}

# _render_units DOSSIER COMPTE [DOSSIER_TMPFILES] → unités du mode MODE_COMPTES (COMPTE : compte unique, ou opérateur en mode séparé) rendues depuis deploy/systemd/ (UNITS_WANTS, ECRITURES et BASE_DONNEES remplis) ; un compte par service : chemins de .env et du dépôt (charger_chemins_separes), réglages du core lus sous le compte de la console ; chaque valeur rendue validée avant tout filtre, rendue en une passe ; dossier d'exécution partagé dans DOSSIER_TMPFILES s'il est donné ; tout est rendu à part, puis déplacé : un échec ne laisse aucune unité tronquée
_render_units() {
    local unit_dir="$1" run_user="$2" tmpfiles_dir="${3:-}" s e repli gabarits="$ROOT/deploy/systemd" ecr db hors=() groupe run nav="" db_unit valeurs=()
    local -A GAB
    UNITS_WANTS=(); MODE_COMPTES="${MODE_COMPTES:-unique}"
    if [ "$MODE_COMPTES" = separes ]; then need_venv; charger_chemins_separes; else load_runtime; fi
    need_core
    _mot_unite "Compte des services" "$run_user" nom
    STAGE_RENDU="$(mktemp -d)" || die "Dossier temporaire indisponible."
    trap _nettoyer_rendu EXIT
    local stage="$STAGE_RENDU"
    db_unit="$(_db_local_unit)"
    [ -z "$db_unit" ] || motif "$db_unit" '^postgresql(@[0-9]{1,3}-main)?\.service$' \
        || die "Unité de la base : « $db_unit » refusée (postgresql.service ou postgresql@<version>-main.service seulement) : rien n'est installé."
    if [ "$MODE_COMPTES" = separes ]; then
        db="$DB_FICHIER"; BASE_DONNEES="${db%/*}"
        run="2770 root $GROUPE_DONNEES"; nav="$(_navigateurs "$run_user")"; COMPTE_ETAT=""
        case "$(fixe APP_MEMORY_DIR)/" in "$SANDBOX_DIR/"*) die "APP_MEMORY_DIR ($(fixe APP_MEMORY_DIR)) est dans le dossier des sandboxes, que seul l'hôte d'outils écrit avec un compte par service : retirez-le de .env (défaut : user_db/memoire), puis relancez sudo ./elpis service install." ;; esac
        avertir_chemins_config
    else
        db="$(core_cmd config DB_PATH 2>/dev/null)"; db="${db:-$ROOT/user_db/app.db}"; BASE_DONNEES="$(base_sure "${db%/*}")"
        groupe="$(id -gn "$run_user" 2>/dev/null)" || die "Groupe de $run_user introuvable (id -gn)."
        _mot_unite "Groupe de $run_user" "$groupe" nom
        run="0700 $run_user $groupe"; COMPTE_ETAT="$run_user"
    fi
    repli="${db%/*}/.vault.key"
    ecr="$(_chemins_hors_depot "${db%/*}")"; ECRITURES="$ecr"
    # Toute valeur venue de .env, du core ou du système validée ici, avant le moindre filtre.
    mapfile -t valeurs < <(printf '%s\n' "$ROOT" "$VAULT_KEY_SYS" "$repli" "$AUDIT_KEY_SYS" "$SANDBOX_DIR" "$RAG_STORE" "$RAG_CACHE" \
        "$CHART_DIR" "${db%/*}" "$nav" "$CLES_SYS"; printf '%s\n' "$ecr" | cut -s -f2)
    for e in "${valeurs[@]}"; do [ -z "$e" ] || _chemin_unite "Chemin d'unité" "$e"; done
    mapfile -t hors < <(printf '%s\n' "$ecr" | cut -s -f2; printf '%s\n' "${NODE:-}" "$nav"; readlink -f "${PY:-}" 2>/dev/null)
    GAB=([PREFIX]="$UNIT_PREFIX" [RUN]="$run" [ROOT]="$ROOT" [BASE]="${db%/*}" [VAULT_KEY_SYS]="$VAULT_KEY_SYS"
         [VAULT_KEY_REPLI]="$repli" [AUDIT_KEY_SYS]="$AUDIT_KEY_SYS" [AFTER_DB]="${db_unit:+ $db_unit}" [WANTS_DB]="${db_unit:+Wants=$db_unit}"
         [PROTECT_HOME]="$(_protection_home "$([ "$MODE_COMPTES" = separes ] && echo "$UNIT_PREFIX-toolhost" || echo "$run_user")" "${hors[@]}")")
    for s in "${SERVICES[@]}"; do
        svc_available "$s" || { warn "$s non installé : pas d'unité."; continue; }
        svc_spec "$s"
        _env_comptes "$s" "$nav"
        _chemin_unite "Dossier de travail de $s" "$SPEC_DIR"
        for e in "${SPEC_ENV[@]}"; do _env_unite_sure "$e"; done
        for e in "${SPEC_CMD[@]}"; do _mot_unite "Commande de $s" "$e" arg; done
        [[ "${SPEC_CMD[0]:-}" == /* ]] || die "Commande de $s : « ${SPEC_CMD[0]:-} » refusée (chemin absolu attendu, sans préfixe + @ - : !) : rien n'est installé."
        GAB[COMPTE]="$(_compte_unite "$s" "$run_user")"
        GAB[CLES]="$(_cles_unite "$s")"
        GAB[UMASK]="$(_umask_unite "$s")"
        GAB[WORKDIR]="$SPEC_DIR"
        GAB[EXEC]="$(printf '%q ' "${SPEC_CMD[@]}")"
        GAB[ENV]="$(for e in "${SPEC_ENV[@]}"; do printf 'Environment="%s"\n' "$e"; done)"
        GAB[RW]="$(_ecritures_du_service "$s" "$ecr")" || exit 1
        _rendre_gabarit "$gabarits/elpis-$s.service" > "$stage/${UNIT_PREFIX}-$s.service" \
            || die "Gabarit d'unité invalide : $gabarits/elpis-$s.service"
        UNITS_WANTS+=("${UNIT_PREFIX}-$s.service")
    done
    # Unités installées à côté : Caddy (apt, --with-caddy) quand HTTPS est
    # actif, moteur vocal local (deploy/voice). Démarrées et arrêtées avec
    # le reste, sans qu'on écrive leurs fichiers.
    local extra=()
    if _https_enabled && [ -f /lib/systemd/system/caddy.service ]; then extra+=(caddy.service); fi
    [ -f /etc/systemd/system/elpis-whisper.service ] && extra+=(elpis-whisper.service)
    [ -f /etc/systemd/system/elpis-tts.service ] && extra+=(elpis-tts.service)
    GAB[WANTS]="${UNITS_WANTS[*]}${extra[*]:+ ${extra[*]}}"
    _rendre_gabarit "$gabarits/elpis.target" > "$stage/${UNIT_PREFIX}.target" \
        || die "Gabarit d'unité invalide : $gabarits/elpis.target"
    if [ -n "$tmpfiles_dir" ]; then
        _rendre_gabarit "$gabarits/elpis.tmpfiles" > "$stage/${UNIT_PREFIX}.conf" \
            || die "Gabarit invalide : $gabarits/elpis.tmpfiles"
        mv -f -- "$stage/${UNIT_PREFIX}.conf" "$tmpfiles_dir/${UNIT_PREFIX}.conf" || die "Écriture de $tmpfiles_dir impossible."
    fi
    mv -f -- "$stage"/* "$unit_dir"/ || die "Écriture de $unit_dir impossible."
    rm -rf "$stage"; STAGE_RENDU=""
}

# Réglages de chemins de config.json sans effet sous un compte par service (les unités fixent ceux de .env et du dépôt) : un avertissement par écart (compté dans ECARTS_CONFIG), avec la marche à suivre ; destination « montée » de la sauvegarde distante hors des dossiers des services signalée.
avertir_chemins_config() {
    local cle v nom d rw
    while IFS=$'\t' read -r cle v; do
        [ -n "$cle" ] && [ -n "$v" ] || continue
        v="${v//[[:cntrl:]]/?}"
        case "$cle" in
            app.sandbox_dir) nom=APP_SANDBOX_DIR ;; app.db_path) nom=APP_DB_PATH ;; rag.store_dir) nom=RAG_STORE_DIR ;;
            app.memory_dir) nom=APP_MEMORY_DIR ;; skills.dir) nom=APP_SKILLS_DIR ;; skills.user_dir) nom=APP_USER_SKILLS_DIR ;;
            skins.dir) nom=APP_SKINS_DIR ;; mcp.servers_dir) nom=MCP_SERVERS_DIR ;; office_preview.cache_dir) nom=APP_OFFICE_CACHE_DIR ;;
            backup.remote.dest_path)
                rw=0
                for d in "$ROOT/user_db" "$LOG_DIR"; do case "$v/" in "$d/"*) rw=1 ;; esac; done
                for d in "$SANDBOX_DIR" "$(fixe APP_FILE_HISTORY_DIR)" "$(fixe APP_OFFICE_CACHE_DIR)"; do case "$v/" in "$d/"*) rw=2 ;; esac; done
                case "$rw" in
                    0) warn "config.json : sauvegarde distante « montée » vers $v, hors des dossiers que main et la console écrivent : à leur ouvrir (sudo systemctl edit ${UNIT_PREFIX}-main ${UNIT_PREFIX}-admin, ReadWritePaths=$v)."; ECARTS_CONFIG=$((ECARTS_CONFIG + 1)) ;;
                    2) warn "config.json : sauvegarde distante « montée » vers $v, dans un dossier que seul l'hôte d'outils écrit : choisissez une destination hors des sandboxes, de l'historique des fichiers et du cache des aperçus."; ECARTS_CONFIG=$((ECARTS_CONFIG + 1)) ;;
                esac
                continue ;;
            *) continue ;;
        esac
        d="$(chemin_absolu "$v")"
        [ "$d" = "$(fixe "$nom")" ] || { warn "config.json : $cle ($v) sans effet sous un compte par service : les unités fixent $nom=$(fixe "$nom") (.env ou défaut) ; pour le garder : $nom=$v dans .env, puis sudo ./elpis service install."; ECARTS_CONFIG=$((ECARTS_CONFIG + 1)); }
    done < <(lanceur chemins)
}

# Premier dossier, de CHEMIN à « / », que les autres comptes ne traversent pas (sans o+x) ; échec si tous le permettent.
dossier_ferme() {
    local d="$1" m
    while :; do
        m="$(stat -c %a -- "$d" 2>/dev/null)" || m=0
        [ $(( 8#$m & 1 )) -ne 0 ] || { echo "$d"; return 0; }
        [ "$d" = / ] && return 1
        d="$(dirname -- "$d")"
    done
}

# Premier chemin que COMPTE ne peut pas lire (r) ou traverser et exécuter (x), essayé sous ce compte : chemin_refuse COMPTE r|x CHEMIN… ; échec si tout passe.
chemin_refuse() {
    local compte="$1" t c; shift
    while [ $# -ge 2 ]; do
        t="$1"; c="$2"; shift 2
        [ -z "$c" ] || (cd / && setsid -w runuser -u "$compte" -- test "-$t" "$c") </dev/null >/dev/null 2>&1 || { echo "$c"; return 0; }
    done
    return 1
}

# Navigateurs de Playwright montés dans les bacs (PLAYWRIGHT_BROWSERS_PATH, sinon le cache du compte qui les a installés) ; rien sans service navigateur.
_navigateurs() {
    [ -d "$ROOT/browser-service/node_modules" ] || return 0
    printf '%s\n' "${PLAYWRIGHT_BROWSERS_PATH:-$(getent passwd "$1" | cut -d: -f6)/.cache/ms-playwright}"
}

# Navigateurs des bacs hors de portée de l'hôte d'outils (cache d'une maison fermée) : copiés par root dans son dossier s'ils y manquent ou si leur liste diffère, à lui, lisibles par tous (le compte des bacs les lit par leur montage), PLAYWRIGHT_BROWSERS_PATH pointé sur la copie ; celui de .env, qui l'emporterait dans l'unité, signalé seulement.
navigateurs_bac() {
    local src copie="$SYS_PREFIXE/var/lib/$UNIT_PREFIX-toolhost/ms-playwright" tmp
    src="$(_navigateurs "$1")"
    { [ -d "$src" ] && chemin_refuse "$UNIT_PREFIX-toolhost" x "$src" >/dev/null; } || return 0
    [ -z "${PLAYWRIGHT_BROWSERS_PATH:-}" ] || { warn "PLAYWRIGHT_BROWSERS_PATH ($src) hors de portée de $UNIT_PREFIX-toolhost : navigateur des bacs indisponible tant que ce dossier n'est pas accessible aux autres comptes (docs/operations.md, « Service accounts »)."; return 0; }
    if [ ! -d "$copie" ] || [ "$(ls -A -- "$src")" != "$(ls -A -- "$copie")" ]; then
        tmp="$(mktemp -d "${copie%/*/*}/.$UNIT_PREFIX-ms-playwright.XXXXXX")" || return 1
        { cp -a -- "$src/." "$tmp/c" && chown -R "$UNIT_PREFIX-toolhost:$GROUPE_DONNEES" -- "$tmp/c" && chmod -R u=rwX,go=rX -- "$tmp/c" \
            && rm -rf -- "$copie" && mv -T -- "$tmp/c" "$copie"; } || { rm -rf -- "$tmp"; return 1; }
        rm -rf -- "$tmp"
        info "Navigateurs de Playwright copiés dans $copie ($src est hors de portée de $UNIT_PREFIX-toolhost)."
    fi
    PLAYWRIGHT_BROWSERS_PATH="$copie"
}

# Mode des comptes (MODE_COMPTES) pour print et install : unique sur demande (ELPIS_COMPTE_UNIQUE=1), repli si le dépôt, ou sous root le code ou Node, est fermé au compte de main déjà créé, séparé sinon.
mode_des_comptes() {
    local ferme
    MODE_COMPTES=separes
    if [ "${ELPIS_COMPTE_UNIQUE:-0}" = 1 ]; then MODE_COMPTES=unique
    elif ferme="$(dossier_ferme "$ROOT")"; then avertir_repli "$ferme"
    elif [ "$(id -u)" -eq 0 ] && id -u "$UNIT_PREFIX-main" >/dev/null 2>&1 \
            && ferme="$(chemin_refuse "$UNIT_PREFIX-main" r "$ROOT/elpis" r "$CORE_DIST/main.mjs" x "$NODE")"; then
        avertir_repli "$ferme"
    fi
}

# Mode séparé impossible (chemin lu par les services fermé aux autres comptes) : repli sur un compte unique, avec la marche à suivre.
avertir_repli() {
    if [ "${SEPARE_ACQUIS:-0}" = 1 ]; then
        systemctl start "${UNIT_PREFIX}.target" >/dev/null 2>&1 || true
        die "Un compte par service est en place, mais $1 n'est pas accessible à $UNIT_PREFIX-main (ou sa sonde a échoué) : rien n'est changé (unités et services remis tels quels). Rendez-le accessible aux autres comptes (docs/operations.md, « Service accounts ») et relancez, ou passez à un seul compte explicitement : sudo ELPIS_COMPTE_UNIQUE=1 ./elpis service install."
    fi
    MODE_COMPTES=repli
    warn "Un compte par service impossible : $1 n'est pas accessible aux autres comptes. Services sous un seul compte (repli). Pour en changer : installation dans /opt/elpis, ou dossiers parents traversables et code lisible par les autres comptes (docs/operations.md, « Service accounts »), puis sudo ./elpis service install."
}

# Comptes du mode séparé, sans rien changer de ce qui est déjà en place (un compte existant doit être un compte système sans shell) : groupes, comptes système de main, de la console et de l'hôte d'outils (sans shell, groupe primaire des données) et du RAG (groupe du RAG), clé et magasin du RAG à main et à la console, journaux aux trois, opérateur dans le groupe des données.
comptes_separes() {
    local s u g maison
    for g in "$GROUPE_DONNEES" "$GROUPE_CLE" "$GROUPE_JOURNAL" "$GROUPE_RAG"; do
        getent group "$g" >/dev/null || { groupadd --system "$g" && info "Groupe $g créé."; } || return 1
    done
    for s in main admin toolhost rag; do
        u="$UNIT_PREFIX-$s"; maison=/nonexistent; g="$GROUPE_DONNEES"
        [ "$s" = toolhost ] && maison="/var/lib/$u"
        [ "$s" = rag ] && g="$GROUPE_RAG"
        if ! id -u "$u" >/dev/null 2>&1; then
            useradd --system --gid "$g" --home-dir "$maison" --no-create-home --shell /usr/sbin/nologin "$u" || return 1
            info "Compte système $u créé."
        elif ! getent passwd "$u" | awk -F: '$3 > 0 && $3 < 1000 && $7 ~ /\/(nologin|false)$/ { ok = 1 } END { exit !ok }'; then
            warn "$u existe déjà sans être un compte système sans shell (uid de 1 à 999, nologin) : refusé ; à vérifier, puis à retirer (userdel $u)."
            return 1
        elif [ "$(id -gn "$u")" != "$g" ]; then
            usermod -g "$g" "$u" || return 1
        fi
    done
    dossier_sur "$SYS_PREFIXE/var/lib/$UNIT_PREFIX-toolhost" 0700 "$UNIT_PREFIX-toolhost" "$GROUPE_DONNEES" || return 1
    membres_exacts "$GROUPE_CLE" "$UNIT_PREFIX-main" "$UNIT_PREFIX-admin" || return 1
    membres_exacts "$GROUPE_RAG" "$UNIT_PREFIX-main" "$UNIT_PREFIX-admin" || return 1
    for s in main admin toolhost; do membre "$UNIT_PREFIX-$s" "$GROUPE_JOURNAL" || return 1; done
    membre "$1" "$GROUPE_DONNEES"
}

# deploy/droits.py par le Python du système, isolé : droits posés sans suivre de lien, dossiers ouverts depuis « / » et refusés si un compte des services peut en remplacer un parent.
poser_droits() {
    ELPIS_DROITS_SERVICES="$UNIT_PREFIX-main $UNIT_PREFIX-admin $UNIT_PREFIX-toolhost $UNIT_PREFIX-rag" ELPIS_DROITS_GROUPES=docker \
        python3 -I "$ROOT/deploy/droits.py" "$@"
}

# chemin_etat_sur DOSSIER : dossier d'état que root peut ouvrir aux services, d'après son seul chemin (rien n'est lu sur le disque, sinon les maisons des comptes) : absolu, sans « . », « .. » ni « // » ; dans le dépôt, sous un dossier d'état ; ailleurs, ni « / », ni un parent du dépôt, ni une maison, ni un dossier système ou d'Elpis ; refus signalé une fois.
chemin_etat_sur() {
    local d="${1%/}" pourquoi=""
    [ -n "$1" ] || return 1
    [ -z "${ETAT_VU[$1]+x}" ] || return "${ETAT_VU[$1]}"
    if [[ "$d" != /?* || "$d/" == */./* || "$d/" == */../* || "$d" == *//* ]]; then
        pourquoi="chemin relatif ou avec . ou .."
    elif [[ "$d/" == "$ROOT/"* ]]; then
        case "${d#"$ROOT"/}/" in user_db/*|user_sandboxes/*|logs/*|user_skins/*|user_skills/*) ;; *) pourquoi="dans le dépôt, hors de ses dossiers d'état" ;; esac
    elif [[ "$ROOT/" == "$d/"* ]]; then pourquoi="parent du dépôt"
    elif [ "$d" = /home ] || getent passwd | cut -d: -f6 | grep -qxF -- "$d"; then pourquoi="dossier personnel"
    elif case "$d/" in /etc/*|/run/*|/proc/*|/sys/*|/dev/*|/usr/*|/boot/*|/var/log/*|/var/lib/private/*|"$SYS_PREFIXE"/etc/*|"$SYS_PREFIXE"/var/log/*|\
            "$SYS_PREFIXE/var/lib/$UNIT_PREFIX"/*|"$SYS_PREFIXE/var/lib/$UNIT_PREFIX"-*|"$SYS_PREFIXE/var/cache/$UNIT_PREFIX"-*) true ;; *) false ;; esac; then
        pourquoi="dossier système ou d'Elpis"
    fi
    ETAT_VU[$1]=0
    [ -n "$pourquoi" ] || return 0
    ETAT_VU[$1]=1
    warn "Dossier $1 refusé ($pourquoi) : root n'y pose aucun droit et les services n'y écrivent pas (docs/operations.md, « Service accounts »)."
    return 1
}

# Dossier d'état accepté d'après son chemin (chemin_etat_sur) mis à PROPRIO:GROUPE (root et le groupe des données par défaut) en MODE par deploy/droits.py, au moment même (aucun verdict gardé) ; ADMIS : propriétaires actuels admis ; dans le dépôt (et le dossier MCP par défaut, voisin du dépôt) ou sous SOUS (dossier géré qui le contient, déjà posé), créé s'il manque ; ailleurs, existant, à un compte d'Elpis, au compte unique (COMPTE_ETAT) ou à root:<groupe des données>.
dossier_donnees() {
    local opts=(--admis "$3" --creer)
    chemin_etat_sur "$1" || return 1
    case "$1/" in
        "$ROOT/"*|"${ROOT%/*}/mcp_custom_servers/") ;;
        *) [ -n "${6:-}" ] || opts=(--admis "$UNIT_PREFIX-main $UNIT_PREFIX-admin $UNIT_PREFIX-toolhost $UNIT_PREFIX-rag ${COMPTE_ETAT:-}" --groupe-racine "$GROUPE_DONNEES") ;;
    esac
    poser_droits dossier "$1" "$2" "${4:-root}" "${5:-$GROUPE_DONNEES}" "${opts[@]}" ${6:+--sous "$6"}
}

# Premier des DOSSIERS que DOSSIER chevauche (le même, dedans, autour) ; échec s'il n'en chevauche aucun.
chevauchement() {
    local d="$1" x; shift
    for x in "$@"; do
        [ -n "$x" ] || continue
        if [ "$d" = "$x" ] || [[ "$d/" == "$x/"* ]] || [[ "$x/" == "$d/"* ]]; then printf '%s\n' "$x"; return 0; fi
    done
    return 1
}

# Droits du mode séparé, à chaque passage, services arrêtés, posés par deploy/droits.py au moment même : dossiers fixes du dépôt et dossiers de .env (jamais de config.json), refusés s'ils se chevauchent (le magasin du RAG peut être dans le dossier de la base) ; dossiers au groupe des données, contenu g+rwX ; seules les entrées de l'opérateur et des anciens comptes uniques sont reprises (jamais celles de root ni d'un service, qu'un service aurait pu y déplacer), dossiers de root compris ; secrets un à un (jeton du RAG laissé dans user_db, source refusée ou réécrite : fermé à son propriétaire, jamais partagé), autorité du relais à l'hôte d'outils, run/chat_runs et run/task_resume privés à main, exclusions sur chaque parcours ; dossier des sandboxes à l'hôte d'outils seul (2750, ce que les anciens comptes et les services y ont laissé compris, sans écriture du groupe, chaque /work laissé au compte des bacs, dossier de l'agent en 1777 sans toucher à son contenu, relais en 0755, instantanés à part), historique des fichiers et cache des aperçus privés à l'hôte d'outils (écartés du parcours du dossier géré qui les contient, refusés s'ils en contiennent un) ; ailleurs, aucun dossier nommé work ni .elpis-agent parcouru ; backups/ privé à l'opérateur ; aucun lien suivi, aucun /work touché.
droits_separes() {
    local base="$1" op="$2" G="$GROUPE_DONNEES" og d n e=0 legs="" admis U="$ROOT/user_db" S="$SANDBOX_DIR" B="" R="$RAG_STORE" sousR="" x h
    og="$(id -gn "$op")" || return 1
    # Anciens propriétaires repris : l'opérateur et les anciens comptes uniques, jamais root ni un compte des services.
    for n in $op ${3:-}; do
        case "$n" in root|"$UNIT_PREFIX"-*) continue ;; esac
        case " $legs " in *" $n "*) ;; *) legs+="$n " ;; esac
    done
    admis="$legs $UNIT_PREFIX-main $UNIT_PREFIX-admin $UNIT_PREFIX-toolhost"
    local cle=(.vault.key .vault.key.lock .encryption_key .encryption_key.lock .session_secret .session_secret.lock)
    local partages=(.local_mcp_token) prives=(.rag_service_token) base_console=('.db_password*') envois=(.backup_ssh_key .backup_rsync_password)
    local fixes=("$U" "$LOG_DIR" "$ROOT/backups" "$ROOT/system_prompts" "$ROOT/skills") commun=() hors=() geres=() hote=() sauf_hote=() bacs=()
    commun=(--comptes "$legs" --comptes-dossiers root
            --prive "$UNIT_PREFIX-main:$U/run/chat_runs" --prive "$UNIT_PREFIX-main:$U/run/task_resume")
    for n in "${cle[@]}" "${partages[@]}" "${prives[@]}" "${base_console[@]}" "${envois[@]}" .backup_known_hosts; do commun+=(--sauf "$n"); done
    bacs=(g+rX,g-w,o-rwx g+rXs,g-w,o-rwx --proprio "$UNIT_PREFIX-toolhost" --comptes "$admis" "${commun[@]}")
    commun+=(--sauf work --sauf .elpis-agent)
    [ -z "$base" ] || [ "$base" = "$U" ] || B="$base"
    # Chevauchements : sandboxes et base ni l'une dans l'autre ni sur un dossier fixe ; magasin du RAG dans la base ou à part.
    if x="$(chevauchement "$S" "${fixes[@]}" "$B")"; then warn "Dossier des sandboxes $S refusé : il chevauche $x."; S=""; e=1; fi
    if [ -n "$B" ] && x="$(chevauchement "$B" "${fixes[@]}" "$S")"; then warn "Dossier de la base $B refusé : il chevauche $x."; B=""; e=1; fi
    for x in "$U" "$B"; do [ -z "$x" ] || [[ "$R/" != "$x/"?* ]] || sousR="$x"; done
    if [ -n "$sousR" ]; then
        case "$R/" in "$sousR/run/"*|"$sousR/browser-relay-ca/"*|"$sousR/rag-cache/"*) warn "Magasin du RAG $R refusé : dans un dossier réservé de $sousR."; R=""; e=1 ;; esac
    elif x="$(chevauchement "$R" "${fixes[@]}" "$S" "$B")"; then warn "Magasin du RAG $R refusé : il chevauche $x."; R=""; e=1; fi
    geres=("${fixes[@]}" "$S" "$B" "$R")
    for h in "$(fixe APP_FILE_HISTORY_DIR)" "$(fixe APP_OFFICE_CACHE_DIR)"; do
        [ -n "$h" ] || continue
        if x="$(chevauchement "$h" "${geres[@]}")" && [[ "$h/" != "$x/"?* ]]; then warn "Dossier $h refusé : il contient $x."; e=1; continue; fi
        hote+=("$h"); sauf_hote+=(--sauf "$h")
    done
    geres+=(${hote[@]+"${hote[@]}"})
    while IFS= read -r h; do
        [ -n "$h" ] || continue
        if x="$(chevauchement "$h" "${geres[@]}" "${hors[@]}")"; then
            [[ "$h/" == "$x/"* ]] || { warn "Dossier $h refusé : il contient $x."; e=1; }
            continue
        fi
        hors+=("$h")
    done < <(printf '%s\n' "${ECRITURES:-}" | cut -s -f2 | sort -u)
    for d in "$U" "$B"; do
        [ -n "$d" ] || continue
        dossier_donnees "$d" 2771 "$admis" || { e=1; continue; }
        poser_droits arbre "$d" "$G" g+rwX,o-rwx g+rwXs,o-rwx "${commun[@]}" ${R:+--sauf "$R"} ${sauf_hote[@]+"${sauf_hote[@]}"} \
            --regle "$UNIT_PREFIX-toolhost:$G:-:go-rwxs:$d/browser-relay-ca" || e=1
        poser_droits fichiers "$d" root "$GROUPE_CLE" 0640 "${cle[@]}" --comptes "root $legs" || e=1
        poser_droits fichiers "$d" root "$G" 0640 "${partages[@]}" --comptes "root $legs" || e=1
        poser_droits fichiers "$d" - - 0600 "${prives[@]}" || e=1
        poser_droits fichiers "$d" "$UNIT_PREFIX-admin" "$G" 0640 "${base_console[@]}" --comptes "$legs" || e=1
        poser_droits fichiers "$d" "$UNIT_PREFIX-admin" "$GROUPE_CLE" 0640 "${envois[@]}" --comptes "$legs" || e=1
        poser_droits fichiers "$d" "$UNIT_PREFIX-admin" "$GROUPE_CLE" 0660 .backup_known_hosts --comptes "$legs" || e=1
    done
    poser_droits fichiers "$ROOT" "$op" "$G" 0640 mcp.json toolhost.json config.json --comptes "root $legs" || e=1
    if [ -n "$S" ]; then
        if dossier_donnees "$S" 2750 "$admis" "$UNIT_PREFIX-toolhost"; then
            poser_droits arbre "$S" "$G" "${bacs[@]}" ${sauf_hote[@]+"${sauf_hote[@]}"} \
                --sauf '*/work' --sauf '*/.elpis-agent/*' --sauf '_snapshots/*' \
                --regle "$UNIT_PREFIX-toolhost:-:-:1777:*/.elpis-agent" --regle "$UNIT_PREFIX-toolhost:-:-:0755:$S/.elpis-relay" || e=1
            poser_droits arbre "$S/_snapshots" "$G" "${bacs[@]}" --sous "$S" || e=1
        else
            e=1
        fi
    fi
    for d in ${hote[@]+"${hote[@]}"}; do
        x=""; for h in "${geres[@]}"; do [ -z "$h" ] || [[ "$d/" != "$h/"?* ]] || x="$h"; done
        [ -n "$x" ] || case "$d/" in "$ROOT/"*) ;; *) [ -e "$d" ] || [ -L "$d" ] || continue ;; esac
        { dossier_donnees "$d" 0700 "$admis" "$UNIT_PREFIX-toolhost" "$G" "$x" \
            && poser_droits arbre "$d" "$G" go-rwx go-rwxs --proprio "$UNIT_PREFIX-toolhost" --comptes "$admis" --comptes-dossiers root ${x:+--sous "$x"}; } || e=1
    done
    { dossier_donnees "$LOG_DIR" 2770 "$admis" && poser_droits arbre "$LOG_DIR" "$G" g+rwX,o-rwx g+rwXs,o-rwx "${commun[@]}" --sauf browser-relay-ca; } || e=1
    { poser_droits dossier "$ROOT/backups" 00700 "$op" "$og" --admis "$admis" --creer \
        && poser_droits arbre "$ROOT/backups" "$og" go-rwx go-rwxs --proprio "$op" --comptes "root $legs"; } || e=1
    for d in "$ROOT/system_prompts" "$ROOT/skills"; do
        [ -d "$d" ] && [ ! -L "$d" ] || continue
        { poser_droits dossier "$d" 2770 "$(stat -c %U -- "$d")" "$G" --admis "$admis" \
            && poser_droits arbre "$d" "$G" g+rwX,o-rwx g+rwXs,o-rwx "${commun[@]}" --sauf browser-relay-ca; } || e=1
    done
    if [ -n "$R" ]; then
        if [ -n "$sousR" ]; then
            { poser_droits dossier "$R" 2770 "$UNIT_PREFIX-main" "$GROUPE_RAG" --admis "$legs" --creer --sous "$sousR" \
                && poser_droits arbre "$R" "$GROUPE_RAG" g+rwX,o-rwx g+rwXs,o-rwx "${commun[@]}" --sauf browser-relay-ca --sous "$sousR"; } || e=1
        else
            { dossier_donnees "$R" 2770 "$legs" "$UNIT_PREFIX-main" "$GROUPE_RAG" \
                && poser_droits arbre "$R" "$GROUPE_RAG" g+rwX,o-rwx g+rwXs,o-rwx "${commun[@]}" --sauf browser-relay-ca; } || e=1
        fi
    fi
    for d in "${hors[@]}"; do
        { dossier_donnees "$d" 2770 "$admis" && poser_droits arbre "$d" "$G" g+rwX,o-rwx g+rwXs,o-rwx "${commun[@]}" --sauf browser-relay-ca; } || e=1
    done
    return "$e"
}

# Compte unique, à chaque passage, services arrêtés : dossiers d'état acceptés d'après leur chemin (base, sandboxes hors de leurs /work, journaux, magasin et cache du RAG, dossiers hors du dépôt) rendus au compte COMPTE en 0700 par deploy/droits.py, contenu u+rwX à lui (ce qui était à root, à un ancien compte ANCIENS ou à un compte d'Elpis ; dossier de l'agent sans son contenu, instantanés à part), secrets de la base à lui seul ; aucun lien suivi.
droits_unique() {
    local base="$1" u="$2" g d e=0 comptes="root $2 ${3:-} $UNIT_PREFIX-main $UNIT_PREFIX-admin $UNIT_PREFIX-toolhost $UNIT_PREFIX-rag" liste=() sauf
    g="$(id -gn "$u")" || return 1
    mapfile -t liste < <({ printf '%s\n' "$ROOT/user_db" "$base" "$SANDBOX_DIR" "$LOG_DIR" "$RAG_STORE" "$RAG_CACHE"; printf '%s\n' "${ECRITURES:-}" | cut -s -f2; } | sed '/^$/d' | sort -u)
    for d in "${liste[@]}"; do
        sauf=(); [ "$d" != "$SANDBOX_DIR" ] || sauf=(--sauf '*/work' --sauf '*/.elpis-agent/*' --sauf '_snapshots/*')
        dossier_donnees "$d" 00700 "$comptes" "$u" "$g" || { e=1; continue; }
        poser_droits arbre "$d" "$g" u+rwX u+rwx,g-s --proprio "$u" --comptes "$comptes" "${sauf[@]}" || e=1
        [ "$d" != "$SANDBOX_DIR" ] || poser_droits arbre "$d/_snapshots" "$g" u+rwX u+rwx,g-s --proprio "$u" --comptes "$comptes" --sous "$d" || e=1
    done
    [ -z "$base" ] || poser_droits fichiers "$base" "$u" "$g" 0600 .session_secret .encryption_key --avec-root || e=1
    return "$e"
}

# Mémoire des comptes hors du dossier des sandboxes, services arrêtés : SANDBOXES/<compte>/memory (et l'ancien .memory) déplacés dans MEMOIRE/<compte>/ par deploy/droits.py, sans suivre de lien ni changer de système de fichiers, sous le compte COMPTE s'il est donné (compte unique : jamais au nom de root), seulement vers le dossier par défaut (user_db/memoire) ; un refus est signalé, rien n'est arrêté.
deplacer_memoire() {
    [ -n "$1" ] && [ "${2%/}" = "$ROOT/user_db/memoire" ] && [ -d "$1" ] || return 0
    if [ -n "${3:-}" ]; then (cd / && _hors_terminal runuser -u "$3" -- python3 -I "$ROOT/deploy/droits.py" memoire "$1" "$2")
    else poser_droits memoire "$1" "$2"; fi \
        || warn "Mémoire des comptes pas toute déplacée de $1 vers $2 (voir ci-dessus) : à faire à la main, puis relancez."
}

# ranger_cfg COMPTE ARGUMENT… : deploy/configure.py --ranger-secrets ARGUMENT… sous le propriétaire de config.json : la console en mode séparé (app_console), le compte unique COMPTE sinon (runuser, hors du terminal de root).
ranger_cfg() {
    local c="$1"; shift
    if [ "$MODE_COMPTES" = separes ]; then app_console "$PY" "$ROOT/deploy/configure.py" --ranger-secrets "$@"
    else (cd / && _hors_terminal runuser -u "$c" -- "$PY" "$ROOT/deploy/configure.py" --ranger-secrets "$@"); fi
}

# Secrets de config.json rangés sans prendre de chemin à config.json, en deux temps : deploy/configure.py --ranger-secrets --garder les donne par un tube sous son propriétaire COMPTE, sans les retirer ; root les écrit (deploy/droits.py ranger, cibles vérifiées avant) près de la base de confiance et dans JETON, ou en clés remises par systemd, et les vérifie ; puis --retirer ôte de config.json les seuls secrets écrits, s'ils n'ont pas changé ; enfin le config.json.bak resté dans le dépôt est retiré.
ranger_secrets() {
    local jeton="$1" c="$2" f sortie liste rc magasin=() cibles=() cles=()
    [ -n "$BASE_DONNEES" ] || return 1
    cibles=("$BASE_DONNEES/.session_secret" "$BASE_DONNEES/.encryption_key" "$jeton")
    if [ "$MODE_COMPTES" = separes ] && cles_systemd; then magasin=(--magasin "$CLES_SYS"); cibles=(); fi
    for f in ${cibles[@]+"${cibles[@]}"}; do
        [ -d "${f%/*}" ] && [ ! -L "${f%/*}" ] && [ ! -L "$f" ] && { [ ! -e "$f" ] || [ -f "$f" ]; } \
            || { warn "$f : dossier absent, lien ou fichier spécial : secrets laissés dans config.json (à vérifier, puis sudo ./elpis service install)."; return 1; }
    done
    sortie="$(ranger_cfg "$c" --sortie - --garder)"; rc=$?
    if [ "$rc" -ne 0 ]; then
        warn "Secrets de config.json non rangés (deploy/configure.py --ranger-secrets, code $rc) : relancez sudo ./elpis service install une fois corrigé."
        return 1
    fi
    liste="$(printf '%s' "$sortie" | poser_droits ranger "$BASE_DONNEES" "$jeton" ${magasin[@]+"${magasin[@]}"})"; rc=$?
    [ "$rc" -eq 0 ] || warn "Secrets de config.json pas tous écrits (voir ci-dessus) : ceux-là restent dans config.json ; relancez sudo ./elpis service install une fois corrigé."
    mapfile -t cles < <(printf '%s\n' "$liste" | grep -xE 'app\.(session_secret|encryption_key)|rag\.(service_token|qdrant_api_key)')
    if [ "${#cles[@]}" -gt 0 ]; then
        printf '%s' "$sortie" | ranger_cfg "$c" --retirer "${cles[@]}" \
            || { warn "Secrets rangés mais pas tous retirés de config.json (voir ci-dessus) : relancez sudo ./elpis service install."; rc=1; }
    fi
    [ ! -f "$ROOT/config.json.bak" ] || [ -L "$ROOT/config.json.bak" ] || rm -f -- "$ROOT/config.json.bak"
    return "$rc"
}

# Jeton du service RAG au fichier du mode (COMPTE : opérateur, ou compte unique) : mode séparé, JETON_RAG_SYS (0440, groupe du RAG ; user_db/.rag_service_token, que ./elpis configure y régénère, l'emporte s'il vient de l'opérateur seul, à un seul lien et sans écriture d'autrui : lu par descripteur, recopié, retiré, par deploy/droits.py reprendre), créé s'il manque ; clés remises par systemd : la clé rag.token, reprise de JETON_RAG_SYS ou de user_db/.rag_service_token seulement s'il n'y en a pas (fichier égal retiré, autre laissé et signalé, fermé par droits_separes), créée sinon ; compte unique, user_db/.rag_service_token, au compte unique (0600) ; secrets de config.json rangés au passage.
jeton_rag() {
    local depot="$ROOT/user_db/.rag_service_token" sys="$JETON_RAG_SYS" e=0
    if [ "$MODE_COMPTES" = separes ] && cles_systemd; then
        magasin_cles || return 1
        poser_droits cle "$CLES_SYS" rag.token --source "$sys" --proprio "root,$1" || true
        poser_droits cle "$CLES_SYS" rag.token --source "$depot" --proprio "$1" --creer jeton \
            || poser_droits cle "$CLES_SYS" rag.token --creer jeton || e=1
        return "$e"
    elif [ "$MODE_COMPTES" = separes ]; then
        poser_droits reprendre "${depot%/*}" "${depot##*/}" "$1" "$sys"; [ "$?" -ne 1 ] || return 1
        [ ! -L "$sys" ] || rm -f -- "$sys"
        ranger_secrets "$sys" "$UNIT_PREFIX-admin"
        poser_droits secret "${sys%/*}" "${sys##*/}" && poser_droits fichiers "${sys%/*}" root "$GROUPE_RAG" 0440 "${sys##*/}"
    else
        if [ -f "$sys" ] && [ ! -L "$sys" ] && [ ! -e "$depot" ]; then mv -T -- "$sys" "$depot" || return 1; fi
        poser_droits fichiers "${depot%/*}" "$1" "$(id -gn "$1")" 0600 "${depot##*/}" --comptes "root $1" || return 1
        ranger_secrets "$depot" "$1"
    fi
}

# Magasin des clés remises par systemd : CLES_SYS, 0700 root:root (deploy/droits.py dossier : ni lien ni autre propriétaire).
magasin_cles() { poser_droits dossier "$CLES_SYS" 0700 root root --creer; }

# Un compte par service et systemd 250 ou plus, services arrêtés : clés de la plateforme chiffrées par systemd-creds dans le magasin, chacune reprise de sa source en clair du bloc 5 (deploy/droits.py cle : lue sans suivre de lien, à root, à l'opérateur OPÉRATEUR ou à un ancien compte unique d'ANCIENS ; chiffrée, déchiffrée et comparée, puis retirée), sinon gardée, sinon créée : clé du coffre (/etc/elpis/vault.key ; la clé de repli seule devient la clé, mêmes secrets sans rekey, et reste sinon pour vault rekey --from), clé de chiffrement héritée et secret de session (près de la base), clé du journal ; clé d'API de Qdrant créée (rag.qdrant_api_key de config.json la remplace ensuite).
cles_vers_systemd() {
    local proprios="root,$1" n e=0 source="$VAULT_KEY_SYS" session=(--creer session)
    for n in ${2:-}; do case "$n" in root|"$UNIT_PREFIX"-*) ;; *) proprios+=",$n" ;; esac; done
    magasin_cles || return 1
    if [ ! -e "$VAULT_KEY_SYS" ] && [ ! -L "$VAULT_KEY_SYS" ] && ! cle_presente vault.key; then source="$BASE_DONNEES/.vault.key"; fi
    poser_droits cle "$CLES_SYS" vault.key --source "$source" --proprio "$proprios" --creer coffre --copie || e=1
    poser_droits cle "$CLES_SYS" encryption.key --source "$BASE_DONNEES/.encryption_key" --proprio "$proprios" --creer fernet --copie || e=1
    [ -z "${APP_SESSION_SECRET:-}" ] || session=()
    poser_droits cle "$CLES_SYS" session.secret --source "$BASE_DONNEES/.session_secret" --proprio "$proprios" --min 40 \
        ${session[@]+"${session[@]}"} || e=1
    poser_droits cle "$CLES_SYS" audit.key --source "$AUDIT_KEY_SYS" --proprio "$proprios" --creer journal --copie || e=1
    poser_droits cle "$CLES_SYS" qdrant.key --creer qdrant || e=1
    return "$e"
}

# cles_rendues COMPTE GROUPE : clés remises par systemd que le mode en place n'emploie pas (retour à un compte, retrait des services, systemd trop ancien) rendues à leurs fichiers du compte unique, sans suivre de lien : clés du coffre et du journal 0440 root:GROUPE dans /etc/elpis, clé de chiffrement et secret de session 0600 à COMPTE près de la base des unités séparées, jeton du RAG 0600 à COMPTE dans user_db/.rag_service_token, où le compte unique le lit (mode séparé sans clés de systemd : à root dans /etc/elpis, que jeton_rag reprend), un fichier différent déjà là remplacé par le jeton en service, clé d'API de Qdrant retirée (un seul compte : Qdrant sans clé) ; une cible différente garde la clé ; magasin retiré une fois vide ; rien sans magasin.
cles_rendues() {
    local proprio="$1" g="$2" gb base jeton="$ROOT/user_db/.rag_service_token" jp="$1" jg e=0
    [ -d "$CLES_SYS" ] || return 0
    command -v systemd-creds >/dev/null 2>&1 || { warn "systemd-creds absent : clés de $CLES_SYS non déchiffrables (installez systemd, ou remettez leurs copies hors de la machine à leurs emplacements)."; return 1; }
    gb="$(id -gn "$proprio")" || return 1
    jg="$gb"; [ "${MODE_COMPTES:-}" != separes ] || { jeton="$JETON_RAG_SYS"; jp=root; jg=root; }
    base="$(chemins_separes >/dev/null && dirname -- "$DB_FICHIER")" && [ -n "$base" ] || return 1
    poser_droits cle-rendre "$CLES_SYS" vault.key "$VAULT_KEY_SYS" root "$g" 0440 || e=1
    poser_droits cle-rendre "$CLES_SYS" audit.key "$AUDIT_KEY_SYS" root "$g" 0440 || e=1
    poser_droits cle-rendre "$CLES_SYS" encryption.key "$base/.encryption_key" "$proprio" "$gb" 0600 || e=1
    poser_droits cle-rendre "$CLES_SYS" session.secret "$base/.session_secret" "$proprio" "$gb" 0600 || e=1
    poser_droits cle-rendre "$CLES_SYS" rag.token "$jeton" "$jp" "$jg" 0600 --remplacer || e=1
    poser_droits cle-rendre "$CLES_SYS" qdrant.key - root root 0600 || e=1
    [ "$e" -eq 0 ] || return 1
    rmdir -- "$CLES_SYS" 2>/dev/null || { warn "$CLES_SYS non vide : gardé (à vérifier)."; return 1; }
    info "Clés de la plateforme rendues à leurs fichiers ; $CLES_SYS retiré."
}

# Retrait des services : clés remises par systemd rendues à l'opérateur (compte unique d'un ./elpis start ou d'une prochaine installation) et au groupe de sa clé ; sous-shell : un .env refusé n'arrête que cette étape.
cles_au_retrait() { ( op="$(operateur)"; charger_env_sur && groupe_de_cle "$op" && cles_rendues "$op" "$GRP_CLE" ); }

# Stockage de Qdrant, services arrêtés : rag_app/qdrant/storage déplacé une fois dans le dossier d'état privé du compte dynamique (mode séparé ; /var/lib/private, 0700 à root s'il manque ou remis à root, par descripteur, avant le déplacement : systemd ne rend tout l'arbre au compte, et pose le lien de /var/lib, que si le haut n'est pas déjà à lui), ramené dans le dépôt au compte unique COMPTE sinon.
qdrant_stockage() {
    local depot="$ROOT/rag_app/qdrant/storage" pub="$SYS_PREFIXE/var/lib/$UNIT_PREFIX-qdrant" prive="$SYS_PREFIXE/var/lib/private" etat
    etat="$prive/$UNIT_PREFIX-qdrant"
    if [ "$MODE_COMPTES" = separes ]; then
        [ -d "$depot" ] && [ ! -L "$depot" ] || return 0
        if [ -e "$etat/storage" ] || [ -e "$pub/storage" ]; then warn "Stockage de Qdrant : $depot laissé, celui de $pub est en service (à vérifier, puis à retirer)."; return 0; fi
        { [ -d "$prive" ] || mkdir -m 0700 -- "$prive"; } && { [ -d "$etat" ] || mkdir -m 0700 -- "$etat"; } || return 1
        poser_droits dossier "$etat" 0700 root root --admis "$(stat -c '%U %u' -- "$etat")" || return 1
        mv -T -- "$depot" "$etat/storage" && info "Stockage de Qdrant déplacé dans $pub."
    else
        [ -d "$etat" ] || etat="$pub"
        if [ -d "$etat/storage" ] && [ ! -L "$etat/storage" ] && [ ! -e "$depot" ]; then
            mv -T -- "$etat/storage" "$depot" && chown -R "$1" "$depot" && info "Stockage de Qdrant ramené dans $depot."
        fi
    fi
}

# config.json chez la console (COMPTE : compte unique ou opérateur ; ADMIS : anciens propriétaires) : déplacé dans CONFIG_SYS avec .bak (0600, à elle seule) et .lock, lien laissé à sa place ; un fichier ordinaire remis à la place du lien (sed -i…) l'emporte ; dossier et fichier à la console en mode séparé, au compte unique sinon ; jamais un déplacement dans un lien.
config_vers_console() {
    local lien="$ROOT/config.json" d="$CONFIG_SYS" f proprio="$1" groupe md=0700 mf=0600
    if [ "$MODE_COMPTES" = separes ]; then proprio="$UNIT_PREFIX-admin"; groupe="$GROUPE_DONNEES"; md=2750; mf=0640
    else groupe="$(id -gn "$1")" || return 1; fi
    dossier_sur "$d" "$md" "$proprio" "$groupe" "$2" || return 1
    if [ -L "$lien" ]; then
        [ "$(readlink -- "$lien")" = "$d/config.json" ] || { warn "$lien : lien vers $(readlink -- "$lien"), pas vers $d/config.json : laissé (à vérifier)."; return 1; }
    elif [ -f "$lien" ]; then
        [ ! -e "$d/config.json" ] || warn "$lien a remplacé son lien (modifié en place, il l'emporte) : déplacé sur $d/config.json."
        mv -fT -- "$lien" "$d/config.json" && ln -s -- "$d/config.json" "$lien" || return 1
        info "config.json rangé dans $d (lien $lien) : la console seule l'écrit."
    elif [ -f "$d/config.json" ]; then
        ln -s -- "$d/config.json" "$lien" || return 1
    fi
    for f in config.json.bak config.json.lock; do
        [ ! -f "$ROOT/$f" ] || [ -L "$ROOT/$f" ] || mv -fT -- "$ROOT/$f" "$d/$f" || return 1
    done
    poser_droits fichiers "$d" "$proprio" "$groupe" "$mf" config.json config.json.lock --avec-root \
        && poser_droits fichiers "$d" "$proprio" "$groupe" 0600 config.json.bak --avec-root
}

cmd_service() {
    local action="${1:-}" unit_dir=/etc/systemd/system s
    if [ "$action" = "print" ]; then
        local tmp; tmp="$(mktemp -d)"; TMP_PRINT="$tmp"; trap _nettoyer_rendu EXIT
        mkdir "$tmp/tmpfiles.d"
        mode_des_comptes
        _render_units "$tmp" "${ELPIS_USER:-$(id -un)}" "$tmp/tmpfiles.d"
        for s in "$tmp"/*.service "$tmp"/*.target "$tmp/tmpfiles.d/${UNIT_PREFIX}.conf"; do
            echo "### ${s#"$tmp"/}"; cat "$s"; echo
        done
        return 0
    fi
    [ "$(id -u)" -eq 0 ] || die "Lancez avec sudo : sudo ./elpis service ${action:-install}"
    command -v systemctl >/dev/null || die "systemd absent."
    case "$action" in
        install)
            # Mode : un compte par service, sauf ELPIS_COMPTE_UNIQUE=1 (unique) ou chemin lu par les services fermé aux autres comptes (repli) ; ELPIS_USER : l'opérateur, ou le compte unique (celui des unités en place par défaut, invite comprise).
            local unique run_user ans ancien ecrivain
            # Root ne lance pas le core avant de connaître le mode : .env vérifié et lu, Node ; les chemins viennent avec les unités.
            need_venv
            charger_env_sur
            NODE="$(node_bin)"
            need_core
            unique="$(compte_unique)"
            ancien="$(compte_services) $(stat -c %U -- "$AUDIT_DIR_SYS" 2>/dev/null)"
            # Avant toute sonde sous un compte des services : services arrêtés (main tuerait ou tracerait les sondes de son compte) et ptrace limité ; un compte par service déjà en place ne retombe jamais sur un seul compte sans ELPIS_COMPTE_UNIQUE=1.
            SEPARE_ACQUIS=0; { [ "$(mode_installe)" = separes ] || id -u "$UNIT_PREFIX-main" >/dev/null 2>&1; } && SEPARE_ACQUIS=1
            systemctl stop "${UNIT_PREFIX}.target" "${UNIT_PREFIX}-*.service" >/dev/null 2>&1 || true
            [ "${ELPIS_COMPTE_UNIQUE:-0}" = 1 ] || ptrace_restreint separes || true
            mode_des_comptes
            if [ "$MODE_COMPTES" = separes ]; then
                run_user="${ELPIS_USER:-${SUDO_USER:-$(stat -c %U -- "$ROOT")}}"
                [ -n "$run_user" ] && [ "$run_user" != root ] && id "$run_user" >/dev/null 2>&1 \
                    || die "Opérateur inconnu (compte qui administre Elpis, mis dans le groupe $GROUPE_DONNEES) : lancez via sudo depuis votre compte, ou ELPIS_USER=nom."
                comptes_separes "$run_user" || die "Comptes des services non préparés (voir ci-dessus)."
                mode_des_comptes
            fi
            if [ "$MODE_COMPTES" = separes ]; then
                ecrivain="$UNIT_PREFIX-main"
                info "Comptes des services : un par service ($UNIT_PREFIX-main, $UNIT_PREFIX-admin, $UNIT_PREFIX-toolhost) ; opérateur $run_user (groupe $GROUPE_DONNEES)."
                navigateurs_bac "$run_user" \
                    || warn "Navigateurs de Playwright non copiés pour $UNIT_PREFIX-toolhost (voir ci-dessus) : navigateur des bacs indisponible ; relancez sudo ./elpis service install une fois corrigé."
            else
                run_user="${ELPIS_USER:-${unique:-${SUDO_USER:-}}}"
                if [ -z "${ELPIS_USER:-}" ] && [ -t 0 ]; then
                    read -r -p "  Utilisateur qui fera tourner les services [${run_user:-?}] : " ans || ans=""
                    run_user="${ans:-$run_user}"
                fi
                if [ -n "$unique" ] && [ "$run_user" != "$unique" ]; then info "Compte des services : $unique → $run_user."; fi
                [ -n "$run_user" ] && [ "$run_user" != root ] \
                    || die "Utilisateur de service inconnu : lancez via sudo depuis votre compte, ou ELPIS_USER=nom."
                id "$run_user" >/dev/null 2>&1 || die "Utilisateur $run_user inexistant (créez-le, ou ELPIS_USER=nom)."
                ecrivain="$run_user"
                # Il doit lire le dépôt et piloter Docker (sandbox).
                (cd / && setsid -w runuser -u "$run_user" -- test -r "$ROOT/elpis") </dev/null >/dev/null 2>&1 \
                    || die "$run_user ne peut pas lire le dépôt ($ROOT) : choisissez son propriétaire."
                if getent group docker >/dev/null && ! id -nG "$run_user" | tr ' ' '\n' | grep -qx docker; then
                    warn "Le groupe docker équivaut à root sur l'hôte : $run_user en deviendra membre. Machine dédiée conseillée (SECURITY.md)."
                    usermod -aG docker "$run_user" && info "$run_user ajouté au groupe docker."
                fi
            fi
            [ "$MODE_COMPTES" = separes ] || ptrace_restreint "$MODE_COMPTES"
            # Retour à un seul compte : dossiers d'état du mode séparé (chemins de .env) rendus et fermés au compte unique avant tout le reste, avant d'y rendre la moindre clé.
            if [ "$MODE_COMPTES" != separes ] && [ "$(mode_installe)" = separes ]; then
                ( chemins_separes && droits_unique "${DB_FICHIER%/*}" "$run_user" "$ancien" ) \
                    || warn "Dossiers d'état du mode séparé non tous rendus à $run_user (voir ci-dessus) : relancez sudo ./elpis service install une fois corrigé."
            fi
            # Clés remises par systemd que ce mode n'emploie pas (retour à un compte, systemd trop ancien) : rendues à leurs fichiers avant audit setup, qui en créerait une neuve.
            if ! { [ "$MODE_COMPTES" = separes ] && cles_systemd; } && ! cles_rendues "$([ "$MODE_COMPTES" = separes ] && echo root || echo "$run_user")" root; then
                systemctl start "${UNIT_PREFIX}.target" >/dev/null 2>&1 || true
                die "Clés remises par systemd non rendues à leurs fichiers (voir ci-dessus) : unités et services remis tels quels."
            fi
            audit_setup "$ecrivain" "$ancien" 0 \
                || warn "Journal de sécurité incomplet (voir ci-dessus) : sudo ./elpis audit setup une fois corrigé."
            cle_regroupee "$VAULT_KEY_SYS" "$([ "$MODE_COMPTES" = separes ] && echo "$GROUPE_CLE" || echo "${GRP_CLE:-}")" \
                || warn "Clé du coffre $VAULT_KEY_SYS non remise au groupe des services (sudo ./elpis vault setup)."
            # Avant les unités : sans config.json chez la console, main et la console ne pourraient plus l'écrire.
            config_vers_console "$run_user" "$ancien" || die "config.json non rangé dans $CONFIG_SYS (voir ci-dessus) : unités et services laissés tels quels."
            if [ "$MODE_COMPTES" = separes ] && cles_systemd; then
                # Clés remises par systemd : rangées avant le rendu (valeurs de config.json d'abord, prises pour une clé absente seulement), les unités ne portant que les clés présentes ; processus lancés à la main arrêtés d'abord.
                COMPTES_ARRET="$ancien $run_user" cmd_stop || true
                chemins_separes; BASE_DONNEES="${DB_FICHIER%/*}"
                { magasin_cles && ranger_secrets "$JETON_RAG_SYS" "$UNIT_PREFIX-admin"; } \
                    || warn "Secrets de config.json non rangés (voir ci-dessus) : relancez sudo ./elpis service install une fois corrigé."
                cles_vers_systemd "$run_user" "$ancien" \
                    || warn "Clés de la plateforme incomplètes dans $CLES_SYS (voir ci-dessus) : relancez sudo ./elpis service install une fois corrigé."
                jeton_rag "$run_user" || warn "Jeton du service RAG non préparé (voir ci-dessus) : relancez sudo ./elpis service install une fois corrigé."
            fi
            _render_units "$unit_dir" "$run_user" /etc/tmpfiles.d
            systemd-tmpfiles --create "/etc/tmpfiles.d/${UNIT_PREFIX}.conf" \
                || warn "Dossier d'exécution /run/${UNIT_PREFIX} non créé (systemd-tmpfiles)."
            for s in "${SERVICES[@]}" "${SERVICES_RETIRES[@]}"; do
                case " ${UNITS_WANTS[*]} " in *" ${UNIT_PREFIX}-$s.service "*) continue ;; esac
                [ -f "$unit_dir/${UNIT_PREFIX}-$s.service" ] || continue
                systemctl disable --now "${UNIT_PREFIX}-$s.service" >/dev/null 2>&1 || true
                rm -f "$unit_dir/${UNIT_PREFIX}-$s.service"
            done
            systemctl daemon-reload
            systemctl enable "${UNITS_WANTS[@]}" "${UNIT_PREFIX}.target" >/dev/null
            # Les processus lancés à la main laisseraient les ports occupés ; le core peut prendre 300 s.
            { [ "$MODE_COMPTES" = separes ] && cles_systemd; } || COMPTES_ARRET="$ancien $run_user" cmd_stop || true
            # Cible arrêtée : le contenu de /run/<préfixe> garderait l'ancien propriétaire si le compte change ; droits posés services arrêtés.
            systemctl stop "${UNIT_PREFIX}.target" >/dev/null 2>&1 || true
            [ -d "/run/${UNIT_PREFIX}" ] && find "/run/${UNIT_PREFIX}" -xdev -mindepth 1 -delete 2>/dev/null
            { [ "$MODE_COMPTES" = separes ] && cles_systemd; } || jeton_rag "$run_user" \
                || warn "Jeton du service RAG non préparé (voir ci-dessus) : relancez sudo ./elpis service install une fois corrigé."
            if [ "$MODE_COMPTES" = separes ]; then
                deplacer_memoire "$SANDBOX_DIR" "$(fixe APP_MEMORY_DIR)"
                # Secret de session créé ici (0640 au groupe de la clé) : créé par main, il resterait illisible pour la console ; clés remises par systemd : déjà au magasin.
                cles_systemd || [ -n "${APP_SESSION_SECRET:-}" ] || [ -z "$BASE_DONNEES" ] || poser_droits secret "$BASE_DONNEES" .session_secret \
                    || warn "Secret de session non créé dans $BASE_DONNEES (voir ci-dessus)."
                droits_separes "$BASE_DONNEES" "$run_user" "$ancien" || warn "Droits du mode séparé incomplets (voir ci-dessus) : relancez sudo ./elpis service install une fois corrigé."
            else
                droits_unique "$BASE_DONNEES" "$run_user" "$ancien" \
                    || warn "Droits du compte unique incomplets (voir ci-dessus) : relancez sudo ./elpis service install une fois corrigé."
                deplacer_memoire "$SANDBOX_DIR" "$(core_cmd config MEMORY_DIR 2>/dev/null)" "$run_user"
            fi
            [ ! -x "$ROOT/rag_app/qdrant/qdrant" ] || qdrant_stockage "$run_user" || warn "Stockage de Qdrant non déplacé (voir ci-dessus)."
            if compgen -G "$ROOT/logs/audit/audit-*.jsonl" >/dev/null; then
                audit_deplacer "$ecrivain" || warn "Fichiers de logs/audit non déplacés (voir ci-dessus)."
            fi
            systemctl restart "${UNIT_PREFIX}.target"
            if [ "$MODE_COMPTES" = separes ]; then
                ok "Services installés et démarrés, un compte par service (opérateur $run_user) : systemctl status ${UNIT_PREFIX}.target"
            else
                ok "Services installés et démarrés (utilisateur $run_user, compte unique : $MODE_COMPTES) : systemctl status ${UNIT_PREFIX}.target"
            fi
            ;;
        remove)
            local etait; etait="$(mode_installe)"
            systemctl disable --now "${UNIT_PREFIX}.target" >/dev/null 2>&1 || true
            for s in "${SERVICES[@]}" "${SERVICES_RETIRES[@]}"; do
                systemctl disable --now "${UNIT_PREFIX}-$s.service" >/dev/null 2>&1 || true
                rm -f "$unit_dir/${UNIT_PREFIX}-$s.service"
            done
            rm -f "$unit_dir/${UNIT_PREFIX}.target" "/etc/tmpfiles.d/${UNIT_PREFIX}.conf"
            rm -rf "/run/${UNIT_PREFIX}"
            # Comme au retour à un seul compte : dossiers d'état d'un compte par service rendus et fermés à l'opérateur avant d'y rendre la moindre clé.
            if [ "$etait" = separes ]; then
                ( op="$(operateur)"; charger_env_sur && chemins_separes && droits_unique "${DB_FICHIER%/*}" "$op" "" ) \
                    || warn "Dossiers d'état non tous rendus à l'opérateur (voir ci-dessus) : relancez sudo ./elpis service remove une fois corrigé."
            fi
            [ ! -d "$CLES_SYS" ] || cles_au_retrait \
                || warn "Clés remises par systemd non toutes rendues à leurs fichiers (voir ci-dessus) : $CLES_SYS gardé ; relancez sudo ./elpis service remove une fois corrigé."
            ptrace_restreint retire
            systemctl daemon-reload
            ok "Services systemd retirés."
            ;;
        *) die "Usage : sudo ./elpis service install|remove   (ou ./elpis service print)" ;;
    esac
}

