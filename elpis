#  doctor
# =============================================================================
# Sonde du moteur faite par main au démarrage : lignes [moteur] de son journal depuis le dernier résumé ; main arrêté : dit, sans échec.
sonde_du_core() {
    local journal lignes l msg n=0
    if systemd_active; then
        journal="$(journalctl -u "${UNIT_PREFIX}-main" -n 5000 --no-pager -o cat 2>/dev/null)"
    elif pid_of main >/dev/null; then
        journal="$(tail -n 5000 "$LOG_DIR/main.log" 2>/dev/null)"
    else
        info "sonde du moteur par le core : main arrêté, pas de rapport (./elpis start, puis ./elpis doctor)"
        return 0
    fi
    lignes="$(printf '%s\n' "$journal" | awk '
        index($0, "[moteur] ") == 0 { next }
        / injoignable sur |, concurrence gérée par le moteur|, file d.Elpis/ { n = 0 }
        { b[n++] = $0 }
        END { for (i = 0; i < n && i < 12; i++) print b[i] }')"
    if [ -z "$lignes" ]; then
        info "sonde du moteur par le core : aucune ligne [moteur] dans le journal de main (sonde en cours, ou ./elpis logs main)"
        return 0
    fi
    while IFS= read -r l; do
        msg="${l#*"[moteur] "}"
        if [ "$n" -eq 0 ]; then info "sonde du moteur par le core (${l%% *}) : $msg"
        else case "$l" in *" WARNING "*|*" ERROR "*) warn "  $msg" ;; *) info "  $msg" ;; esac; fi
        n=$((n+1))
    done <<< "$lignes"
}

# /health du service navigateur d'un bac (socket $1, jeton du fichier $2) : socket saisi sans suivre de lien (le bac écrit dans son dossier) en O_PATH|O_NOFOLLOW, vérifié, joint par /proc/self/fd ; vrai s'il répond ok.
sante_navigateur_bac() {
    "${PY:-python3}" -I - "$1" "$2" <<'PY' 2>/dev/null
import os, socket, stat, sys
fd = os.open(sys.argv[1], os.O_PATH | os.O_NOFOLLOW)
if not stat.S_ISSOCK(os.fstat(fd).st_mode):
    sys.exit(1)
with open(sys.argv[2], encoding="utf-8") as f:
    jeton = f.readline().strip()
s = socket.socket(socket.AF_UNIX)
s.settimeout(3)
s.connect(f"/proc/self/fd/{fd}")
s.sendall(f"GET /health HTTP/1.0\r\nHost: browser\r\nAuthorization: Bearer {jeton}\r\n\r\n".encode())
lu = b""
while len(lu) < 65536:
    m = s.recv(65536)
    if not m:
        break
    lu += m
sys.exit(0 if lu.startswith(b"HTTP/1.1 200") and b'"ok":true' in lu else 1)
PY
}

# Navigateur, dans la sandbox de chaque compte seulement : autorité du relais (clé 0600), dossiers montés lisibles par l'UID du bac, headless shell, services des comptes en marche et leur relais ; appelée par cmd_doctor (compteur bad).
doctor_navigateur_bac() {
    local ca cpu pw nm sb s d j n=0
    # Navigateur non installé : déjà signalé par le contrôle « service navigateur ».
    [ -d "$ROOT/browser-service/node_modules" ] || return 0
    ca="${ELPIS_BROWSER_CA_DIR:-$ROOT/user_db/browser-relay-ca}"
    check "navigateur dans le bac : autorité du relais ($ca)" "créée au démarrage de l'hôte d'outils : ./elpis restart" test -s "$ca/ca.crt" -a -s "$ca/ca.key"
    [ -f "$ca/ca.key" ] && check "navigateur dans le bac : clé de l'autorité en 0600" "chmod 600 $ca/ca.key" test "$(stat -c %a "$ca/ca.key")" = 600
    # Chromium partage le quota CPU du bac : à 1 CPU, les captures d'étape des pages lourdes dépassent leur délai de 3 s (mesuré : ~5 % des actions, aucune à 2 CPU).
    cpu="$("${PY:-python3}" -c 'import json, sys
try: print(int(((json.load(open(sys.argv[1])).get("executors") or {}).get("limits") or {}).get("cpu_quota_pct") or 100))
except Exception: print(100)' "$ROOT/config.json" 2>/dev/null)"
    [ "${cpu:-100}" -ge 200 ] || info "navigateur dans le bac : ${cpu:-100} % de CPU par bac (executors.limits.cpu_quota_pct) ; Chromium y partage ce quota, 200 conseillé (captures d'étape des pages lourdes hors délai à 100)."
    pw="${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}"
    check "navigateur dans le bac : headless shell de Chromium ($pw)" "./install.sh" compgen -G "$pw/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell"
    nm="$(readlink -f "$ROOT/browser-service/node_modules" 2>/dev/null)"
    check "navigateur dans le bac : service, modules et headless shell lisibles par l'UID du bac (o+rx)" "chmod o+rx ${nm:-browser-service/node_modules}" \
        test "$(find "$ROOT/browser-service" "${nm:-/nonexistent}" "$pw" -maxdepth 0 -perm -o+rx 2>/dev/null | wc -l)" = 3
    sb="$(core_cmd config SANDBOX_DIR 2>/dev/null)"
    for s in "${sb:-/nonexistent}"/*/.elpis-agent/browser.sock; do
        [ -S "$s" ] || continue
        d="$(dirname "$(dirname "$s")")"; j="$d/.browser-service.token"; n=$((n+1))
        if [ -s "$j" ] && sante_navigateur_bac "$s" "$j"; then
            check "navigateur du bac ${d##*/} : en marche, relais de l'hôte à l'écoute" "./elpis logs toolhost ; ./elpis logs browser ${d##*/}" test ! -L "$d/.elpis-agent/browser-relay.sock" -a -S "$d/.elpis-agent/browser-relay.sock"
        else
            info "navigateur du bac ${d##*/} : arrêté (relancé au prochain outil pw_* ; ./elpis logs browser ${d##*/})"
        fi
    done
    [ "$n" -gt 0 ] || info "navigateur dans le bac : aucun service en marche (démarré au premier outil pw_* d'un compte)"
}

# Journal de sécurité et centralisation (ANSSI) : dossiers et droits (compte des services), clé de signature, règle rsyslog et ses paquets, journald persistant, horloge ; appelée par cmd_doctor (compteur bad).
doctor_journaux() {
    local m d compte regles=()
    compte="$(compte_services)"
    [ -n "$compte" ] || compte="$(id -un)"
    [ "$compte" != root ] || compte="$(stat -c %U "$ROOT")"
    for d in "$AUDIT_DIR_SYS" "$APPLOG_DIR_SYS"; do
        [ -e "$d" ] || [ -L "$d" ] || continue
        m="$(stat -c '%a %U %G' -- "$d" 2>/dev/null || echo '? ? ?')"
        case "$m" in
            "2750 $compte $GROUPE_JOURNAL"|"2750 $compte adm") ok "journaux : $d ($m)" ;;
            *) warn "journaux : $d en $m (attendu 2750 $compte:$GROUPE_JOURNAL, compte des services : sudo ./elpis audit setup)"; bad=$((bad+1)) ;;
        esac
    done
    if [ ! -d "$AUDIT_DIR_SYS" ]; then
        warn "journal de sécurité : dossier de repli logs/audit (sudo ./elpis audit setup)"; bad=$((bad+1))
    elif compgen -G "$ROOT/logs/audit/audit-*.jsonl" >/dev/null; then
        warn "journal de sécurité : fichiers restés dans logs/audit, ni transmis ni purgés (services arrêtés : ./elpis stop ou sudo systemctl stop ${UNIT_PREFIX}.target, puis sudo ./elpis audit setup, qui les déplace ou les ajoute au fichier du même jour)"; bad=$((bad+1))
    fi
    doctor_cle "$compte"
    mapfile -t regles < <(compgen -G "$SYS_PREFIXE/etc/rsyslog.d/*elpis*.conf")
    if [ "${#regles[@]}" -gt 0 ]; then
        ok "centralisation : règle Elpis ${regles[0]}"
        doctor_paquets_rsyslog "${regles[@]}"
    elif mapfile -t regles < <(compgen -G "$SYS_PREFIXE/etc/syslog-ng/conf.d/*elpis*.conf") && [ "${#regles[@]}" -gt 0 ]; then
        ok "centralisation : règle Elpis ${regles[0]}"
    else
        info "centralisation : aucune règle rsyslog Elpis (exemples dans deploy/rsyslog/, ANSSI R9)"
    fi
    if [ -d /var/log/journal ]; then ok "journald persistant (/var/log/journal)"
    else info "journald : journaux en mémoire seulement (Storage=persistent, voir deploy/journald/)"; fi
    if command -v timedatectl >/dev/null 2>&1; then
        case "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" in
            yes) ok "horloge synchronisée (NTP)" ;;
            no)  warn "horloge NON synchronisée : horodatage des journaux douteux (chrony ou timesyncd sur un serveur de temps interne)"; bad=$((bad+1)) ;;
            *)   info "horloge : état de synchronisation inconnu" ;;
        esac
    fi
}

# Lecture d'un fichier par un compte : essai réel sous root (runuser), sinon d'après le mode et les groupes du compte.
compte_lit() {
    local m g
    if [ "$(id -u)" -eq 0 ]; then (cd / && runuser -u "$1" -- test -r "$2"); return; fi
    if [ "$(id -un)" = "$1" ] && [ -r "$2" ]; then return 0; fi
    read -r m g < <(stat -c '%a %G' -- "$2" 2>/dev/null) || return 1
    [ $(( 8#$m & 8#040 )) -ne 0 ] && id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qx "$g"
}

# Clé de signature : 0440 root, groupe propre au compte des services, lisible par lui, 32 octets au moins quand ce compte-ci la lit.
doctor_cle() {
    local compte="$1" m g dossier="${AUDIT_KEY_SYS%/*}"
    # Sous le compte des services : lecture réelle ; une session ouverte avant audit setup n'a pas encore le groupe de la clé.
    if [ "$(id -u)" -ne 0 ] && [ "$(id -un)" = "$compte" ] && [ -d "$dossier" ] \
            && { [ ! -x "$dossier" ] || [ -e "$AUDIT_KEY_SYS" ]; } && [ ! -r "$AUDIT_KEY_SYS" ]; then
        g="$(stat -c %G -- "$AUDIT_KEY_SYS" 2>/dev/null || stat -c %G -- "$dossier")"
        if ! id -Gn | tr ' ' '\n' | grep -qxF -- "$g" && id -Gn "$compte" | tr ' ' '\n' | grep -qxF -- "$g"; then
            warn "journal de sécurité : clé illisible par ce processus, sans le groupe $g (session ouverte avant son ajout) : ./elpis start lancé d'ici écrit des lignes non signées (nouvelle session, ou sg $g -c './elpis restart')"
        else
            warn "journal de sécurité : clé $AUDIT_KEY_SYS illisible par le compte des services $compte, lignes non signées (sudo ./elpis audit setup)"
        fi
        bad=$((bad+1)); return 0
    fi
    if [ -d "$dossier" ] && [ ! -x "$dossier" ]; then
        info "journal de sécurité : clé non vérifiable par ce compte ($dossier réservé au compte des services $compte : doctor sous ce compte ou avec sudo)"; return 0
    fi
    if [ ! -e "$AUDIT_KEY_SYS" ] && [ ! -L "$AUDIT_KEY_SYS" ]; then
        warn "journal de sécurité : lignes non signées (clé absente : sudo ./elpis audit setup)"; bad=$((bad+1)); return 0
    fi
    m="$(stat -c '%a %U %G' -- "$AUDIT_KEY_SYS" 2>/dev/null)"; g="${m##* }"
    if [ -L "$AUDIT_KEY_SYS" ] || [ ! -f "$AUDIT_KEY_SYS" ] || [ "$m" != "440 root $g" ]; then
        warn "journal de sécurité : clé $AUDIT_KEY_SYS en ${m:-?} (attendu 440 root, groupe du seul compte $compte : sudo ./elpis audit setup)"
    elif ! groupe_propre "$g" "$compte"; then
        warn "journal de sécurité : clé lisible par le groupe $g, qui n'est pas propre au compte $compte (sudo ./elpis audit setup)"
    elif ! compte_lit "$compte" "$AUDIT_KEY_SYS"; then
        warn "journal de sécurité : clé illisible par le compte des services $compte, lignes non signées (sudo ./elpis audit setup)"
    elif [ -r "$AUDIT_KEY_SYS" ] && [ "$(tr -d ' \t\r\n' < "$AUDIT_KEY_SYS" | wc -c)" -lt 32 ]; then
        warn "journal de sécurité : clé $AUDIT_KEY_SYS trop courte (32 octets au moins), lignes non signées"
    else
        ok "journal de sécurité : lignes signées (clé $AUDIT_KEY_SYS, groupe $g)"; return 0
    fi
    bad=$((bad+1))
}

# Coffre « Secrets » : clé 0440 root, groupe propre au compte des services, lisible par lui (sous ce compte : lecture réelle, une session ouverte avant l'ajout du groupe de la clé ne la lit pas) ; repli, clé illisible ou invalide et secrets d'une autre clé vus par le core (compteur bad).
doctor_coffre() {
    local compte m g niveau texte dossier="${VAULT_KEY_SYS%/*}"
    compte="$(compte_services)"
    [ -n "$compte" ] || compte="$(id -un)"
    [ "$compte" != root ] || compte="$(stat -c %U "$ROOT")"
    if [ "$(id -u)" -ne 0 ] && [ "$(id -un)" = "$compte" ] && [ -d "$dossier" ] \
            && { [ ! -x "$dossier" ] || [ -e "$VAULT_KEY_SYS" ]; } && [ ! -r "$VAULT_KEY_SYS" ]; then
        g="$(stat -c %G -- "$VAULT_KEY_SYS" 2>/dev/null || stat -c %G -- "$dossier")"
        if ! id -Gn | tr ' ' '\n' | grep -qxF -- "$g" && id -Gn "$compte" | tr ' ' '\n' | grep -qxF -- "$g"; then
            warn "coffre (Secrets) : clé illisible par ce processus, sans le groupe $g (session ouverte avant son ajout) : les services lancés d'ici n'ouvriraient pas le coffre (nouvelle session, ou sg $g -c './elpis restart')"
        else
            warn "coffre (Secrets) : clé $VAULT_KEY_SYS illisible par le compte des services $compte (sudo ./elpis vault setup)"
        fi
        bad=$((bad+1)); return 0
    fi
    if [ -e "$VAULT_KEY_SYS" ] || [ -L "$VAULT_KEY_SYS" ]; then
        m="$(stat -c '%a %U %G' -- "$VAULT_KEY_SYS" 2>/dev/null)"; g="${m##* }"
        if [ -L "$VAULT_KEY_SYS" ] || [ ! -f "$VAULT_KEY_SYS" ] || [ "$m" != "440 root $g" ]; then
            warn "coffre (Secrets) : clé $VAULT_KEY_SYS en ${m:-?} (attendu 440 root, groupe du seul compte $compte : sudo ./elpis vault setup)"; bad=$((bad+1))
        elif ! groupe_propre "$g" "$compte"; then
            warn "coffre (Secrets) : clé lisible par le groupe $g, qui n'est pas propre au compte $compte (sudo ./elpis vault setup)"; bad=$((bad+1))
        elif ! compte_lit "$compte" "$VAULT_KEY_SYS"; then
            warn "coffre (Secrets) : clé $VAULT_KEY_SYS illisible par le compte des services $compte (sudo ./elpis vault setup)"; bad=$((bad+1))
        fi
        if [ "$(id -u)" -ne 0 ] && [ ! -r "$VAULT_KEY_SYS" ]; then
            info "coffre (Secrets) : clé non lisible par ce compte, secrets non vérifiés (doctor sous le compte des services $compte, ou avec sudo)"; return 0
        fi
    elif [ "$(id -u)" -ne 0 ] && [ -d "$dossier" ] && [ ! -x "$dossier" ]; then
        info "coffre (Secrets) : clé non vérifiable par ce compte ($dossier réservé au compte des services $compte : doctor sous ce compte ou avec sudo)"; return 0
    fi
    if [ ! -f "$CORE_DIST/exploitation.mjs" ] || [ ! -f "$ROOT/config.json" ]; then
        info "coffre (Secrets) : non vérifié (core non construit ou config.json absent)"; return 0
    fi
    while IFS=$'\t' read -r niveau texte; do
        case "$niveau" in
            ok) ok "$texte" ;;
            warn) warn "$texte"; bad=$((bad+1)) ;;
            info) info "$texte" ;;
            *) [ -n "$niveau$texte" ] && { warn "coffre (Secrets) : NON ($niveau $texte)"; bad=$((bad+1)); } ;;
        esac
    done < <(vault_core vault doctor 2>&1)
}

# Pilotes cités par les règles rsyslog d'Elpis, lignes commentées exclues (gtls : rsyslog-gnutls, omrelp : rsyslog-relp) : rsyslogd -N1 ne signale pas leur absence.
doctor_paquets_rsyslog() {
    local texte p paquet
    command -v dpkg-query >/dev/null 2>&1 || return 0
    texte="$(grep -hv '^[[:space:]]*#' -- "$@" 2>/dev/null)"
    for p in gtls:rsyslog-gnutls omrelp:rsyslog-relp; do
        paquet="${p#*:}"
        case "$texte" in *"${p%%:*}"*) ;; *) continue ;; esac
        if [ "$(dpkg-query -W -f='${db:Status-Status}' "$paquet" 2>/dev/null)" = installed ]; then ok "centralisation : paquet $paquet"
        else warn "centralisation : paquet $paquet absent, la règle n'envoie rien (apt install $paquet, depuis le miroir interne)"; bad=$((bad+1)); fi
    done
}

cmd_doctor() {
    local bad=0 sortie
    charger_env
    NODE="$(node_bin)"
    # Contrôles : check LIBELLÉ CONSEIL COMMANDE [ARGUMENTS...] (la commande est un argv, jamais évaluée par un shell).
    check() { local lib="$1" conseil="$2"; shift 2; if "$@" >/dev/null 2>&1; then ok "$lib"; else warn "$lib : NON ($conseil)"; bad=$((bad+1)); fi; }
    # Facultatif : signalé, sans compter comme un problème.
    check_opt() { local lib="$1" conseil="$2"; shift 2; if "$@" >/dev/null 2>&1; then ok "$lib"; else info "$lib : absent ($conseil)"; fi; }
    check_out() { local lib="$1" conseil="$2"; shift 2; if sortie="$("$@" 2>&1)"; then ok "$lib : $sortie"; else warn "$lib : NON (${sortie:+$sortie ; }$conseil)"; bad=$((bad+1)); fi; }
    doctor_runtime() { [ "$(runtime_empreinte "$NODE_DIR")" = "$1" ]; }
    doctor_office() { (cd "$ROOT/office" && "$PY" -c 'import elpis_office.word, elpis_office.powerpoint, markdown_it'); }
    doctor_hote_empreinte() { ELPIS_RACINE="$ROOT" "$NODE" "$HOTE_DIST/main.mjs" --empreinte; }
    doctor_llm() { ELPIS_CFG_LLM_API_KEY="$4" "$1" "$ROOT/deploy/configure.py" --check-llm --engine "${2:-llamacpp}" --llm-url "$3"; }
    # Paquets apt d'un groupe : manquants = problème si le groupe sert ici, sinon simple information.
    check_apt() {
        local manquants=() l liste="" cmd
        mapfile -t manquants < <(prerequis_manquants "$1")
        if [ "${#manquants[@]}" -eq 0 ]; then ok "paquets apt ($1)"; return 0; fi
        for l in "${manquants[@]}"; do liste+="${liste:+, }$(prerequis_libelle "$l")"; done
        cmd="$(prerequis_commande "${manquants[@]}")"
        if apt_groupe_sert "$1"; then warn "paquets apt ($1) : NON (manquants : $liste ; $cmd)"; bad=$((bad+1))
        else info "paquets apt ($1, facultatif) : absents : $liste ($cmd)"; fi
    }
    if command -v dpkg-query >/dev/null 2>&1; then
        local groupe
        for groupe in $(prerequis_groupes); do
            if [ "$groupe" = socle ] || prerequis_os_connu; then check_apt "$groupe"
            else info "paquets apt ($groupe) : noms de Debian 12/13 et Ubuntu 24.04, non vérifiés sur ce système (deploy/prerequis-apt.txt)"; fi
        done
    else
        info "paquets apt : dpkg-query absent, prérequis non vérifiés (deploy/prerequis-apt.txt)"
    fi
    check "venv Python" "./install.sh" test -x "$PY"
    check "dépendances Python" "./install.sh" "$PY" -c 'import fastapi, httpx, uvicorn' 
    local v_runtime="NODE_RUNTIME_SHA256_$(uname -m)" runtime_attendu
    runtime_attendu="${!v_runtime:-absente}"
    if [ "$NODE" = "$NODE_DIR/bin/node" ]; then
        check "runtime Node.js livré (node/, sans npm, empreinte ${runtime_attendu:0:12})" \
            "./install.sh, ou ./install.sh --offline <paquet de cette version>" \
            doctor_runtime "$runtime_attendu"
    else
        info "runtime Node.js : $NODE (ELPIS_NODE ou PATH), empreinte non vérifiée"
    fi
    check "Node.js du core $("$NODE" -v 2>/dev/null || echo absent) ($NODE)" \
        "24.x, $NODE_MIN au moins : ./install.sh installe $NODE_VERSION dans node/" node_ok
    check "core construit (apps/core/dist/main.mjs)" "./install.sh, ou ./install.sh --offline <paquet de cette version>" test -f "$CORE_DIST/main.mjs"
    if [ -f "$CORE_DIST/exploitation.mjs" ]; then
        check_out "module natif du core" "./install.sh" core_cmd natif
        check_out "bundle du core" "./install.sh, ou ./install.sh --offline <paquet de cette version>" core_cmd empreinte
    fi
    # Hôte d'outils : construit, à jour des sources, node-pty (PTY du terminal) et better-sqlite3 chargés pour cette machine.
    check "hôte d'outils construit (apps/toolhost/dist/main.mjs)" "./install.sh, ou ./install.sh --offline <paquet de cette version>" test -f "$HOTE_DIST/main.mjs"
    if [ -f "$HOTE_DIST/main.mjs" ]; then
        check_out "bundle de l'hôte d'outils" "./install.sh, ou ./install.sh --offline <paquet de cette version>" \
            doctor_hote_empreinte
        check_out "modules natifs de l'hôte d'outils" "bundle incomplet ou d'une autre architecture : paquet hors ligne de cette architecture, ou construction sur place (build-essential, python3 : npm ci y compile node-pty)" \
            timeout 30 "$NODE" "$HOTE_DIST/main.mjs" --natif
    fi
    if [ -n "${SSL_CERT_FILE:-}${SSL_CERT_DIR:-}" ]; then
        check "autorités de confiance (${SSL_CERT_FILE:-SSL_CERT_DIR=$SSL_CERT_DIR})" \
            "fichier PEM, ou un seul dossier aux noms hachés (openssl rehash) : ./elpis configure --ca-file systeme|<fichier PEM>|aucun" ca_ok
    else
        info "autorités de confiance : magasins par défaut (core : Node et /etc/ssl/certs ; httpx : certifi) ; PKI interne : ./elpis configure --ca-file systeme"
    fi
    check "dépendances de l'extracteur du RAG" "venv/bin/pip install -r requirements-rag.txt" "$PY" -c 'import pdfplumber, pypdfium2, pypdf, openpyxl, docx, pptx' 
    check "moteur Office (worker de l'hôte d'outils)" "venv/bin/pip install -r requirements.txt" doctor_office
    check "config.json" "./elpis configure" test -f "$ROOT/config.json"
    check "mcp.json" "./elpis configure" test -f "$ROOT/mcp.json"
    check "jeton MCP" "./elpis configure" test -s "$ROOT/user_db/.local_mcp_token"
    check "jeton du service RAG" "./elpis configure" test -s "$ROOT/user_db/.rag_service_token"
    local th_host="${LOCAL_MCP_HOST:-127.0.0.1}"; [ "$th_host" = 0.0.0.0 ] && th_host=127.0.0.1
    check "hôte d'outils ($th_host:$MCP_PORT)" "./elpis logs toolhost" curl --noproxy '*' -fsS -m 3 -o /dev/null "http://$th_host:$MCP_PORT/health"
    if [ -f "$HOTE_DIST/main.mjs" ]; then
        local natives
        natives="$(ELPIS_RACINE="$ROOT" timeout 30 "$NODE" "$HOTE_DIST/main.mjs" --familles-natives 2>/dev/null | tail -n 1)"
        info "hôte d'outils : familles servies ${natives:-aucune} (toolhost.json › families)"
        local th_conf="${TOOLHOST_CONFIG:-$ROOT/toolhost.json}"; case "$th_conf" in /*) ;; *) th_conf="$ROOT/$th_conf" ;; esac
        if [ -f "$th_conf" ] && grep -qE '"(familles_natives|mcp_upstream|mcp_upstream_sse)"[[:space:]]*:[[:space:]]*([^[:space:]"]|"[^"])' "$th_conf"; then
            warn "toolhost.json : familles_natives / mcp_upstream sont obsolètes (elpis-tools n'existe plus), ignorés : à retirer"
        fi
    fi
    check "outils du compte servis par main (mcp.json sans URL d'appmcp)" "./elpis configure" "$PY" "$ROOT/deploy/configure.py" --verifier-mcp
    check "familles d'outils de mcp.example.json présentes dans mcp.json" "./elpis configure" "$PY" "$ROOT/deploy/configure.py" --verifier-familles-mcp
    local retire
    for retire in ELPIS_TOOLHOST ELPIS_APPMCP ELPIS_CLI; do
        [ "${!retire:-}" = python ] && info "$retire=python : ignoré depuis la 0.1.0 (retour à la version Python : tag python-final, docs/operations.md), à retirer de .env"
    done
    check "Qdrant" "./install.sh" test -x "$ROOT/rag_app/qdrant/qdrant"
    check "service navigateur (monté dans la sandbox de chaque compte)" "./install.sh" test -d "$ROOT/browser-service/node_modules"
    doctor_navigateur_bac
    # Contrôles faits par le core (exploitation.mjs) : signalés non vérifiés s'il n'est pas construit.
    local distants core_ok=0
    [ -f "$CORE_DIST/exploitation.mjs" ] && core_ok=1
    if [ "$core_ok" -eq 0 ]; then
        info "verrous de fichiers : non vérifiés (core non construit)"
    elif distants="$(core_cmd fs-local 2>/dev/null)"; then
        ok "verrous de fichiers : dossiers de données sur disque local"
    else
        warn "verrous de fichiers : NON (${distants:-vérification impossible} ; NFS/CIFS non pris en charge)"
        bad=$((bad+1))
    fi
    check "Docker joignable" "installer docker, groupe docker ; sans lui, ni sandbox ni navigateur" docker info
    local image
    image="$("$ROOT/deploy/docker/sandbox/build_offline.sh" --print-image 2>/dev/null)"
    check "image sandbox $image" "./install.sh ou deploy/docker/sandbox/build_offline.sh ; sans elle, ni sandbox ni navigateur" docker image inspect "$image"
    check "bubblewrap (analyses du RAG et aperçus Office isolés)" \
        "apt install bubblewrap ; user namespaces autorisés ; core construit requis" core_cmd bwrap
    check_opt "LibreOffice (aperçus Office, facultatif)" "paquets apt du groupe apercus-office : deploy/prerequis-apt.txt" command -v soffice
    if _https_enabled; then
        check "Caddy actif (HTTPS)" "./install.sh --with-caddy puis ./elpis configure" systemctl is-active --quiet caddy
    fi
    if [ -f /etc/systemd/system/elpis-whisper.service ]; then
        check "reconnaissance vocale (:8090)" "systemctl status elpis-whisper" curl --noproxy '*' -fsS -m 3 -o /dev/null http://127.0.0.1:8090/health
        check "synthèse vocale (:8091)" "systemctl status elpis-tts" curl --noproxy '*' -fsS -m 3 -o /dev/null http://127.0.0.1:8091/health
    fi
    if [ -f "$ROOT/config.json" ] && [ "$core_ok" -eq 1 ]; then
        local db_hint="./elpis db info pour le détail ; ./elpis db use sqlite en secours"
        if [ "$(core_cmd config base-retiree 2>/dev/null)" = oui ]; then
            db_hint="MariaDB/MySQL n'est plus pris en charge : docs/operations.md, « Upgrading »"
        fi
        check "base de données joignable" "$db_hint" core_cmd db info
        check_out "base vue par le core" "./elpis db info" core_cmd migrations
        local llm moteur cle py="$PY"
        [ -x "$py" ] || py=python3
        llm="$(core_cmd config LLAMA_URL 2>/dev/null)"
        if [ -n "$llm" ]; then
            moteur="$(core_cmd config LLAMA_ENGINE 2>/dev/null)"
            cle="$(core_cmd config LLAMA_API_KEY 2>/dev/null)"
            # Clé passée par l'environnement : jamais sur une ligne de commande (ps), jamais affichée.
            check_out "serveur LLM" "./elpis configure" doctor_llm "$py" "$moteur" "$llm" "$cle"
            local conseil
            while IFS= read -r conseil; do info "$conseil"; done \
                < <(ELPIS_CFG_LLM_API_KEY="$cle" "$py" "$ROOT/deploy/configure.py" --conseils-moteur --engine "${moteur:-llamacpp}" 2>/dev/null)
        fi
    fi
    if [ -f "$ROOT/config.json" ] && [ "$core_ok" -eq 1 ]; then
        local niveau texte
        # Extracteur, jeton et magasin partagés, Qdrant, embeddings, reclassement et OCR : vus par le core.
        while IFS=$'\t' read -r niveau texte; do
            case "$niveau" in
                ok) ok "$texte" ;;
                warn) warn "$texte"; bad=$((bad+1)) ;;
                info) info "$texte" ;;
                *) [ -n "$niveau$texte" ] && { warn "RAG : NON ($niveau $texte)"; bad=$((bad+1)); } ;;
            esac
        done < <(ELPIS_RACINE="$ROOT" timeout 120 "$NODE" --use-system-ca "$CORE_DIST/exploitation.mjs" rag 2>&1)
    else
        info "RAG : non vérifié (core non construit ou config.json absent)"
    fi
    doctor_journaux
    doctor_coffre
    sonde_du_core
    echo
    cmd_status
    [ "$bad" -eq 0 ] && ok "Aucun problème détecté." || warn "$bad point(s) à corriger."
    return "$bad"
}

