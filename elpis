#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# =============================================================================
#  elpis — configurer, lancer et diagnostiquer Elpis
# =============================================================================
#
#  ./elpis configure [options]   assistant par pages (LLM, cloud, HTTPS, RAG,
#                                sandbox, voix, base, compte admin) ; avec des
#                                options : sans assistant.  --yes = sans
#                                question ; --help = toutes les options
#  ./elpis start [--foreground]  démarre Qdrant, RAG, outils, app et admin (core
#                                Node, apps/core/dist/main.mjs) ; attend
#                                /api/health de main et admin (120 s au plus,
#                                ELPIS_ATTENTE_SANTE), sinon code non nul
#  ./elpis stop                  arrête les services lancés par « elpis start »
#                                (le core finit ses requêtes : 300 s au plus)
#  ./elpis restart               migrations en attente, puis stop et start
#  ./elpis status                état des services et des ports
#  ./elpis logs [SERVICE] [-f]   journaux (qdrant rag toolhost main admin)
#  ./elpis logs browser COMPTE [-f]  navigateur dans la sandbox du compte
#  ./elpis service install       services systemd (sudo), démarrage au boot
#  ./elpis service remove
#  ./elpis service print         affiche les unités sans rien installer
#  ./elpis doctor                diagnostic de l'installation
#  ./elpis backup [full|db|sandboxes|mcp]   sauvegarde dans backups/ (0600)
#  ./elpis upgrade [--no-backup] sauvegarde, git pull --ff-only, dépendances,
#                                core et hôte d'outils Node reconstruits,
#                                redémarrage (migrations au démarrage), doctor
#  ./elpis db info|check|transfer|use   base de données : état, test d'une
#                                cible, copie vers une base vide, choix du
#                                moteur (« ./elpis db use sqlite » = porte de
#                                sortie si le serveur de base est tombé)
#  sudo ./elpis vault setup      clé du coffre « Secrets » /etc/elpis/vault.key
#                                (0440, groupe de la clé du journal ; un compte
#                                par service et systemd 250 ou plus : chiffrée
#                                par systemd-creds), jamais remplacée
#  ./elpis vault status          clé du coffre (source, kid) et secrets
#                                chiffrés par une autre clé
#  ./elpis vault rekey --from FICHIER   rechiffre avec la clé courante les
#                                secrets de l'ancienne clé FICHIER
#  ./elpis secret ls [--user COMPTE]   secrets du coffre : métadonnées seules
#  ./elpis auth status           SSO OpenID Connect : fournisseurs (activé,
#                                actif ou inopérant, testé), mot de passe
#                                local, administrateurs
#  ./elpis auth off              issue de secours : désactive tous les fournisseurs
#                                et rouvre le mot de passe local à tous
#  ./elpis auth reactivate COMPTE  lève la suspension d'un compte (issue de
#                                secours si tous les administrateurs le sont)
#  ./elpis audit verify [--from AAAA-MM-JJ] [--to AAAA-MM-JJ] [--key CHEMIN]
#                                vérifie le journal de sécurité : signatures,
#                                lignes manquantes, arrêts propres (0 = intègre)
# =============================================================================
set -uo pipefail
# « su » sans « - » garde le PATH de l'utilisateur, sans /usr/sbin ni /sbin :
# runuser, usermod… y seraient introuvables en root.
for d in /usr/local/sbin /usr/sbin /sbin; do
    case ":$PATH:" in *":$d:"*) ;; *) PATH="$PATH:$d" ;; esac
done
export PATH

ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$ROOT"
VENV="$ROOT/venv"
PY="$VENV/bin/python"
RUN_DIR="$ROOT/user_db/run"
LOG_DIR="$ROOT/logs"
SERVICES=(qdrant rag toolhost main admin)
# Services retirés : leurs unités systemd sont supprimées par « service install » et « service remove ».
SERVICES_RETIRES=(appmcp tools browser)
UNIT_PREFIX="elpis"
# Journal de sécurité (audit) et journal technique hors du dépôt (sudo ./elpis audit setup) ;
# ELPIS_PREFIXE_SYSTEME ne sert qu'aux essais (arborescence factice).
SYS_PREFIXE="${ELPIS_PREFIXE_SYSTEME:-}"
AUDIT_DIR_SYS="$SYS_PREFIXE/var/lib/elpis/audit"
AUDIT_KEY_SYS="$SYS_PREFIXE/etc/elpis/audit.key"
# Clé du coffre « Secrets » (sudo ./elpis vault setup), lue par le core (ELPIS_VAULT_KEY_PATH à défaut).
VAULT_KEY_SYS="$SYS_PREFIXE/etc/elpis/vault.key"
APPLOG_DIR_SYS="$SYS_PREFIXE/var/log/elpis"
# config.json des services systemd, écrit par la console seule ; un lien le remplace dans le dépôt.
CONFIG_SYS="$SYS_PREFIXE/etc/elpis/config"
GROUPE_JOURNAL="${ELPIS_GROUPE_JOURNAL:-elpis-journal}"
# Groupe de la clé de signature quand le groupe primaire du compte des services n'est pas le sien seul ; en mode séparé, clés de main et de la console.
GROUPE_CLE="${ELPIS_GROUPE_CLE:-elpis-cle}"
# Mode séparé (un compte par service) : état partagé par main, la console, l'hôte d'outils et l'opérateur ; magasin et jeton du RAG.
GROUPE_DONNEES=elpis-donnees
# Dossiers d'état déjà jugés d'après leur seul chemin (chemin_etat_sur : 0 accepté, 1 refusé) ; COMPTE_ETAT : compte unique, propriétaire admis.
declare -A ETAT_VU=()
COMPTE_ETAT=""
# Paires de .env (charger_env) et chemins fixés par les unités à un compte par service (chemins_separes), passés au code que root lance (app_console).
ENV_PAIRES=(); CHEMINS_FIXES=(); ENV_CHARGE=0; ECARTS_CONFIG=0
GROUPE_RAG=elpis-rag
JETON_RAG_SYS="$SYS_PREFIXE/etc/elpis/rag.token"
# Clés de la plateforme remises par systemd (un compte par service, systemd 250 ou plus) : magasin à root seul ; CLES_SYSTEMD (oui, non) calculé une fois.
CLES_SYS="$SYS_PREFIXE/etc/elpis/credentials"; CLES_SYSTEMD=""
NODE_DIR="$ROOT/node"
CORE_DIST="$ROOT/apps/core/dist"
HOTE_DIST="$ROOT/apps/toolhost/dist"
# shellcheck source=deploy/node/node.env
. "$ROOT/deploy/node/node.env"
# shellcheck source=deploy/prerequis-apt.sh
. "$ROOT/deploy/prerequis-apt.sh"
# shellcheck source=deploy/node/runtime.sh
. "$ROOT/deploy/node/runtime.sh"

MAIN_PORT=8001; ADMIN_PORT=8002; RAG_PORT=8000; MCP_PORT="${LOCAL_MCP_PORT:-8765}"
QDRANT_PORT=6333

# Texte d'un message dans MSG : C0 (sauf tabulation), DEL et C1 remplacés par « ? » : un nom choisi par un service n'ajoute ni ligne ni séquence d'échappement à l'écran ou au journal.
_propre() { local LC_ALL=C c1=$'\xc2[\x80-\x9f]' c0=$'[\x01-\x08\x0a-\x1f\x7f]'; MSG="${*//$c1/?}"; MSG="${MSG//$c0/?}"; }
info() { local MSG; _propre "$@"; printf '\033[1;34m[elpis]\033[0m %s\n' "$MSG"; }
ok()   { local MSG; _propre "$@"; printf '\033[1;32m[ ok  ]\033[0m %s\n' "$MSG"; }
warn() { local MSG; _propre "$@"; printf '\033[1;33m[warn ]\033[0m %s\n' "$MSG" >&2; }
die()  { local MSG; _propre "$@"; printf '\033[1;31m[err  ]\033[0m %s\n' "$MSG" >&2; exit 1; }
# motif VALEUR REGEX : VALEUR conforme à REGEX, octet par octet (LC_ALL=C : [A-Za-z] n'admet ni « é » ni « Ａ » quelle que soit la locale de sudo) ; BASH_REMATCH rempli.
motif() { local LC_ALL=C; [[ $1 =~ $2 ]]; }
# filtre_affichage [--tui] : flux écrit par un compte, relayé au terminal ou au journal de root, en une passe (deploy/droits.py filtre : rien de retiré ne se recolle) : OSC, DCS, APC, PM, SOS et C1 retirés, autres contrôles en « ? », séquences d'échappement retirées sauf les couleurs ; --tui : CSI gardées.
filtre_affichage() { python3 -I "$ROOT/deploy/droits.py" filtre "$@"; }
# _hors_terminal [--brut] COMMANDE… : COMMANDE (un runuser) dans sa propre session (setsid : ni terminal de contrôle ni signaux du terminal de root), entrée /dev/null si c'est un terminal (ou fermée), sorties toujours filtrées (filtre_affichage ; --brut : sortie standard telle quelle, pour une archive) ; Ctrl-C de root transmis (SIGTERM) ; rend son code.
_hors_terminal() {
    local brut=0
    [ "${1:-}" != --brut ] || { brut=1; shift; }
    (
        local rc p1="" p2="" enfant
        [ ! -t 0 ] || exec </dev/null
        { exec 3<&0; } 2>/dev/null || exec 3</dev/null
        [ "$brut" -eq 1 ] || { exec > >(filtre_affichage); p1=$!; }
        exec 2> >(filtre_affichage >&2); p2=$!
        setsid -w "$@" <&3 3<&- &
        enfant=$!
        trap 'kill -TERM "$enfant" 2>/dev/null' INT TERM HUP
        while :; do wait "$enfant"; rc=$?; kill -0 "$enfant" 2>/dev/null || break; done
        exec >&- 2>&-
        [ -z "$p1" ] || wait "$p1"
        [ -z "$p2" ] || wait "$p2"
        exit "$rc"
    )
}
usage() { sed -n '/^#  \.\/elpis configure/,/^#                                lignes manquantes, arrêts propres/p' "$0" | sed 's/^# \{0,1\}//'; }

need_venv() { [ -x "$PY" ] || die "venv/ absent : lancez d'abord ./install.sh"; }
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && { exec 3>&- 3<&-; return 0; }; return 1; }

# Node du core : ELPIS_NODE, sinon node/ (installé par install.sh), sinon celui du PATH.
node_bin() {
    if [ -n "${ELPIS_NODE:-}" ]; then echo "$ELPIS_NODE"
    elif [ -x "$NODE_DIR/bin/node" ]; then echo "$NODE_DIR/bin/node"
    else command -v node || echo node; fi
}
version_ge() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$2" ]; }
# Node 24.x, au moins NODE_MIN (shouldUpgradeCallback du relais WebSocket).
node_ok() {
    local v; v="$("$NODE" -v 2>/dev/null)" || return 1
    v="${v#v}"
    [ "${v%%.*}" = 24 ] && version_ge "$v" "$NODE_MIN"
}
need_core() {
    [ -f "$CORE_DIST/main.mjs" ] || die "Core non construit ($CORE_DIST/main.mjs absent) : ./install.sh, ou ./install.sh --offline <paquet de cette version>"
    node_ok || die "Node.js « $("$NODE" -v 2>/dev/null || echo "$NODE absent") » : le core demande Node 24.x, $NODE_MIN au moins (./install.sh installe $NODE_VERSION dans node/, ou ELPIS_NODE=chemin)."
}
# Commandes d'exploitation du core (sauvegarde…) : bundle construit et Node 24.
need_exploitation() {
    [ -f "$CORE_DIST/exploitation.mjs" ] || die "Core non construit ($CORE_DIST/exploitation.mjs absent) : ./install.sh, ou ./install.sh --offline <paquet de cette version>"
    node_ok || die "Node.js « $("$NODE" -v 2>/dev/null || echo "$NODE absent") » : le core demande Node 24.x, $NODE_MIN au moins (./install.sh installe $NODE_VERSION dans node/, ou ELPIS_NODE=chemin)."
}
# Commande d'exploitation du core (natif, migrations, empreinte, backup…), avec la configuration des services, l'hôte d'outils local (/work des comptes pour « backup ») et, sous des unités à un compte par service, le groupe des données (fichiers créés partagés) ; root sous un compte par service : sous le compte de la console (app_console) ; l'opérateur de ces unités : natif, empreinte et bwrap seulement, qui ne lisent pas la configuration.
core_cmd() {
    local e=("ELPIS_RACINE=$ROOT") b=()
    [ "${1:-}" != bwrap ] || b=(--bac)
    if racine_separee; then app_console ${b[@]+"${b[@]}"} "$NODE" "$CORE_DIST/exploitation.mjs" "$@"; return; fi
    case "${1:-}" in natif|empreinte|bwrap) ;; *) ! operateur_separe || die "Un compte par service : le core lit la configuration et les clés des services : lancez la commande avec sudo." ;; esac
    [ -n "${SANDBOX_DIR:-}" ] && e+=("APP_SANDBOX_DIR=$SANDBOX_DIR")
    [ ! -d "$AUDIT_DIR_SYS" ] || e+=("ELPIS_AUDIT_DIR=$AUDIT_DIR_SYS" ELPIS_AUDIT_KEY_REQUIRED=1)
    e+=("LOCAL_MCP_URL=http://127.0.0.1:${MCP_PORT}/mcp")
    [ "$(mode_installe)" != separes ] || e+=("ELPIS_GROUPE_DONNEES=$GROUPE_DONNEES" "${CHEMINS_FIXES[@]}")
    # Dossier d'exécution des services (repères partagés) : jamais sous root, qui y créerait des fichiers illisibles pour leur compte.
    if [ "$(id -u)" -ne 0 ] && [ -d "/run/${UNIT_PREFIX}" ] && [ -w "/run/${UNIT_PREFIX}" ]; then e+=("ELPIS_RUNTIME_DIR=/run/${UNIT_PREFIX}"); fi
    env "${e[@]}" "$NODE" "$CORE_DIST/exploitation.mjs" "$@"
}
# lanceur QUESTION : réglage lu par le core dans config.json et l'environnement (exploitation.mjs lanceur) ; rien si le core n'est pas construit ; root sous un compte par service : sous le compte de la console.
lanceur() {
    [ -f "$CORE_DIST/exploitation.mjs" ] || return 0
    if racine_separee; then
        app_console "${NODE:-$(node_bin)}" "$CORE_DIST/exploitation.mjs" lanceur "$1" 2>/dev/null \
            || warn "Le core ne répond pas pour « $1 » (bundle d'une autre version ? ./install.sh) : valeur par défaut."
        return 0
    fi
    ELPIS_RACINE="$ROOT" "${NODE:-$(node_bin)}" "$CORE_DIST/exploitation.mjs" lanceur "$1" 2>/dev/null \
        || warn "Le core ne répond pas pour « $1 » (bundle d'une autre version ? ./install.sh) : valeur par défaut."
}
# Un compte par service : celui visé par l'installation en cours (MODE_COMPTES), sinon celui des unités installées.
separe_vise() { if [ -n "${MODE_COMPTES:-}" ]; then [ "$MODE_COMPTES" = separes ]; else [ "$(mode_installe)" = separes ]; fi; }

# Root sous un compte par service : il ne lance aucun code de l'application lui-même (app_console).
racine_separee() { [ "$(id -u)" -eq 0 ] && separe_vise; }

# Environnement de app_console, une ligne NOM=VALEUR : PATH et compte de la console, .env, chemins fixés par les unités (CHEMINS_FIXES), groupes, jeton du RAG, journaux et dossier d'exécution s'ils existent.
env_console() {
    local e
    printf '%s\n' "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" "HOME=/nonexistent" \
        "USER=$UNIT_PREFIX-admin" "LOGNAME=$UNIT_PREFIX-admin" "LANG=${LANG:-C.UTF-8}" "TMPDIR=/var/tmp" ${TERM:+"TERM=$TERM"}
    for e in "${ENV_PAIRES[@]}" "${CHEMINS_FIXES[@]}"; do printf '%s\n' "$e"; done
    printf '%s\n' "ELPIS_RACINE=$ROOT" "LOCAL_MCP_URL=http://127.0.0.1:${MCP_PORT}/mcp" "ELPIS_COMPTES=separes" \
        "ELPIS_GROUPE_DONNEES=$GROUPE_DONNEES" "ELPIS_GROUPE_CLE=$GROUPE_CLE" "RAG_SERVICE_TOKEN_FILE=$JETON_RAG_SYS"
    [ ! -d "$AUDIT_DIR_SYS" ] || printf 'ELPIS_AUDIT_DIR=%s\nELPIS_AUDIT_KEY_REQUIRED=1\n' "$AUDIT_DIR_SYS"
    [ ! -d "$APPLOG_DIR_SYS" ] || printf 'ELPIS_APP_LOG_DIR=%s\n' "$APPLOG_DIR_SYS"
    [ ! -d "/run/$UNIT_PREFIX" ] || printf 'ELPIS_RUNTIME_DIR=/run/%s\n' "$UNIT_PREFIX"
}

# Version du systemd en marche (/run/systemd/system ; premier nombre de « systemctl --version ») ; aucune dans l'arborescence factice des essais (ELPIS_PREFIXE_SYSTEME), qui ne lit jamais le systemd de la machine.
version_systemd() {
    local l
    [ -z "$SYS_PREFIXE" ] && [ -d /run/systemd/system ] || return 1
    l="$(systemctl --version 2>/dev/null | head -n 1)"
    motif "$l" '^systemd ([0-9]{1,5})([^0-9]|$)' && printf '%s\n' "${BASH_REMATCH[1]}"
}

# Clés de la plateforme remises par systemd possibles ici : systemd 250 ou plus (LoadCredentialEncrypted=), systemd-creds et systemd-run.
cles_systemd() {
    local v
    if [ -z "$CLES_SYSTEMD" ]; then
        CLES_SYSTEMD=non
        v="$(version_systemd)" && [ "$v" -ge 250 ] && command -v systemd-creds >/dev/null 2>&1 \
            && command -v systemd-run >/dev/null 2>&1 && CLES_SYSTEMD=oui
    fi
    [ "$CLES_SYSTEMD" = oui ]
}

# Clés remises par systemd à un service : main, la console et les commandes que root lance sous son compte (console), toutes ; l'hôte d'outils, la clé du journal seule ; le RAG, son jeton seul ; Qdrant, sa clé d'API seule.
cles_du_service() {
    case "$1" in
        main|admin|console) echo vault.key encryption.key session.secret audit.key rag.token qdrant.key ;;
        toolhost) echo audit.key ;;
        rag) echo rag.token ;;
        qdrant) echo qdrant.key ;;
    esac
}

# Variable qui donne au code du SERVICE le chemin d'une clé remise par systemd ; aucune pour Qdrant, que deploy/qdrant/lancer.sh lit dans $CREDENTIALS_DIRECTORY.
variable_de_cle() {
    [ "${2:-}" != qdrant ] || return 0
    case "$1" in
        vault.key) echo ELPIS_VAULT_KEY_PATH ;; encryption.key) echo APP_ENCRYPTION_KEY_PATH ;;
        session.secret) echo APP_SESSION_SECRET_FILE ;; audit.key) echo ELPIS_AUDIT_KEY_PATH ;;
        rag.token) echo RAG_SERVICE_TOKEN_FILE ;; qdrant.key) echo QDRANT_API_KEY_FILE ;;
    esac
}

# Clé NOM présente dans le magasin (vu par ce compte : root seul le lit).
cle_presente() { [ -f "$CLES_SYS/$1" ] && [ ! -L "$CLES_SYS/$1" ]; }

# Vrai si les unités installées reçoivent la clé NOM de systemd (LoadCredentialEncrypted= de main ou de la console).
cle_des_unites() {
    local s
    for s in main admin; do
        grep -q "^LoadCredentialEncrypted=${1//./\\.}:" "$SYS_PREFIXE/etc/systemd/system/${UNIT_PREFIX}-$s.service" 2>/dev/null && return 0
    done
    return 1
}

# Opérateur d'unités à un compte par service (ni root ni le compte de la console) : jamais de code de l'application qui lit la configuration des services, faute de leurs clés (le core en créerait d'autres près de la base).
operateur_separe() { [ "$(id -u)" -ne 0 ] && [ "$(id -un)" != "$UNIT_PREFIX-admin" ] && [ "$(mode_installe)" = separes ]; }

# Commande de l'opérateur qui lancerait ce code : arrêt, avec la commande à lancer sous sudo.
refuser_operateur_separe() {
    ! operateur_separe || die "Un compte par service : cette commande lit la configuration et les clés des services : lancez sudo ./elpis $1"
}

# Opérateur : le compte qui a lancé sudo, sinon le propriétaire de l'installation (jamais root).
operateur() {
    local o="${SUDO_USER:-}"
    [ -n "$o" ] && [ "$o" != root ] || o="$(stat -c %U -- "$ROOT")"
    printf '%s\n' "$o"
}

# NOM=VALEUR en ligne d'un fichier d'environnement de systemd (EnvironmentFile=) : valeur entre guillemets, \ " ` et $ échappés, prise telle quelle ; nom hors motif ignoré.
_ligne_env() {
    local v="${1#*=}"
    motif "${1%%=*}" '^[A-Za-z_][A-Za-z0-9_]*$' || return 0
    v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; v="${v//\`/\\\`}"; v="${v//\$/\\\$}"
    printf '%s="%s"\n' "${1%%=*}" "$v"
}

# Dossiers que la console écrit, comme son unité : état de la racine, journaux, config.json, dossier de la base et chemins fixés par les unités (validés par chemins_separes).
ecritures_console() {
    local e
    printf '%s\n' "$ROOT/user_db" "$LOG_DIR" "$ROOT/system_prompts" "$ROOT/skills" "$ROOT/user_skins" "$ROOT/user_skills" \
        "$AUDIT_DIR_SYS" "$APPLOG_DIR_SYS" "$CONFIG_SYS" "/run/$UNIT_PREFIX" "$(dirname -- "${DB_FICHIER:-$ROOT/user_db/app.db}")"
    for e in "${CHEMINS_FIXES[@]}"; do [ "${e%%=*}" = APP_DB_PATH ] || printf '%s\n' "${e#*=}"; done
}

# Durcissement de la sonde de bubblewrap de doctor sous le compte de la console (app_console --bac) : celui de l'unité de la console que bubblewrap supporte, système en lecture seule hors de ses dossiers.
DURCI_BAC=(-p NoNewPrivileges=yes -p CapabilityBoundingSet= -p ProtectSystem=strict -p PrivateTmp=yes
    -p PrivateDevices=yes -p ProtectKernelModules=yes -p ProtectControlGroups=yes -p ProtectClock=yes -p ProtectProc=invisible
    -p RestrictRealtime=yes -p LockPersonality=yes -p SystemCallArchitectures=native
    -p "RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK" -p "InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock")
# Durcissement des autres commandes de root sous ce compte : celui de l'unité de la console tout entier (ProtectHome repris de l'unité installée).
DURCI_CONSOLE=("${DURCI_BAC[@]}" -p RestrictNamespaces=yes -p RestrictSUIDSGID=yes -p ProtectKernelTunables=yes -p ProtectKernelLogs=yes
    -p ProtectHostname=yes -p PrivateIPC=yes -p MemoryMax=25% -p TasksMax=512)

# _console_systemd PTY BAC COMMANDE… : commande de app_console en unité transitoire (systemd-run, dans un sous-shell) : durcissement de la console (BAC=1 : celui de la sonde de bubblewrap), compte et groupe de la console, clés de la console présentes (LoadCredentialEncrypted=, chemins de /run/credentials : systemd-run ne résout pas %d), fichiers de clé donnés en argument, CLES_REMISES « nom=chemin » (copiés par root, LoadCredential=, arguments réécrits), environnement dans un fichier à root seul, « $ » doublé (systemd ne développe rien) ; unité arrêtée et fichier retiré à la sortie.
_console_systemd() {
    local pty="$1" bac="$2" unite d n v x c ph lignes colonnes fixes=" " args=() cmd=() rw=() durci=("${DURCI_CONSOLE[@]}")
    shift 2
    [ "$bac" -eq 0 ] || durci=("${DURCI_BAC[@]}")
    ph="$(sed -n 's/^ProtectHome=//p' "$SYS_PREFIXE/etc/systemd/system/${UNIT_PREFIX}-admin.service" 2>/dev/null | tail -n 1)"
    case "$ph" in yes|read-only|tmpfs) ;; *) ph=read-only ;; esac
    unite="$UNIT_PREFIX-cli-$BASHPID-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
    umask 0077
    d="$(mktemp -d "$SYS_PREFIXE/run/$UNIT_PREFIX-cli.XXXXXX")" || return 1
    trap "systemctl stop --no-block -- $(printf %q "$unite.service") >/dev/null 2>&1; rm -rf -- $(printf %q "$d")" EXIT
    args=(--wait --collect --quiet "--unit=$unite" "--uid=$UNIT_PREFIX-admin" "--gid=$GROUPE_DONNEES" -p "EnvironmentFile=$d/env"
          -p "WorkingDirectory=$ROOT" -p UMask=0007 -p "ProtectHome=$ph" "${durci[@]}")
    mapfile -t rw < <(ecritures_console)
    for x in "${rw[@]}"; do args+=(-p "ReadWritePaths=-$x"); done
    for n in $(cles_du_service console); do
        cle_presente "$n" || continue
        v="$(variable_de_cle "$n")"; fixes+="$v "
        args+=(-p "LoadCredentialEncrypted=$n:$CLES_SYS/$n" -p "Environment=$v=/run/credentials/$unite.service/$n")
    done
    for x in "${e[@]}" ${plus[@]+"${plus[@]}"}; do
        case "$fixes" in *" ${x%%=*} "*) ;; *) _ligne_env "$x" ;; esac
    done > "$d/env" || return 1
    for c in ${CLES_REMISES[@]+"${CLES_REMISES[@]}"}; do
        poser_droits copier "${c#*=}" "$d" "${c%%=*}" --proprio "root,$(operateur)" || return 2
        args+=(-p "LoadCredential=${c%%=*}:$d/${c%%=*}")
    done
    for x in "$@"; do
        for c in ${CLES_REMISES[@]+"${CLES_REMISES[@]}"}; do [ "$x" != "${c#*=}" ] || x="/run/credentials/$unite.service/${c%%=*}"; done
        cmd+=("${x//\$/\$\$}")
    done
    if [ "$pty" -eq 1 ]; then
        if read -r lignes colonnes < <(stty size 2>/dev/null) && motif "$lignes $colonnes" '^[1-9][0-9]{0,3} [1-9][0-9]{0,3}$'; then
            args+=(-p "TTYRows=$lignes" -p "TTYColumns=$colonnes")
        fi
        systemd-run --pty "${args[@]}" -- "${cmd[@]}" | filtre_affichage --tui
        return "${PIPESTATUS[0]}"
    fi
    _hors_terminal ${brut[@]+"${brut[@]}"} systemd-run --pipe "${args[@]}" -- "${cmd[@]}"
}

# app_console [--terminal] [--brut] [--bac] [--env NOM=VALEUR]… COMMANDE… : seul chemin de root vers le code de l'application sous un compte par service (core, lanceur, coffre, configure.py, wizard.py, sauvegarde, migrations) : sous le compte de la console, jamais root, depuis la racine, umask 0007, environnement construit (env_console, plus --env ; aucune valeur sur une ligne de commande) ; clés remises par systemd possibles : unité transitoire (_console_systemd), sinon runuser ; terminal de root jamais confié (_hors_terminal : session à part, entrée /dev/null, sorties filtrées ; --brut : archive telle quelle), sauf --terminal : nouveau pseudo-terminal filtré ; --bac : sonde de bubblewrap, durcissement que bubblewrap supporte.
app_console() {
    local pty=0 bac=0 brut=() v e=() plus=()
    while :; do
        case "${1:-}" in
            --terminal) pty=1; shift ;;
            --bac) bac=1; shift ;;
            --brut) brut=(--brut); shift ;;
            --env) plus+=("$2"); shift 2 ;;
            *) break ;;
        esac
    done
    [ "${ENV_CHARGE:-0}" = 1 ] || charger_env_sur
    [ "${#CHEMINS_FIXES[@]}" -gt 0 ] || chemins_separes
    mapfile -t e < <(env_console)
    if cles_systemd; then (cd "$ROOT" && _console_systemd "$pty" "$bac" "$@"); return; fi
    (
        cd "$ROOT" || exit 1
        for v in $(compgen -e); do unset "$v" 2>/dev/null; done
        export "${e[@]}" ${plus[@]+"${plus[@]}"}
        umask 0007
        if [ "$pty" -eq 1 ]; then runuser --pty -u "$UNIT_PREFIX-admin" -- "$@" | filtre_affichage --tui; exit "${PIPESTATUS[0]}"; fi
        _hors_terminal ${brut[@]+"${brut[@]}"} runuser -u "$UNIT_PREFIX-admin" -- "$@"
    )
}

# app_cmd COMMANDE… : code de l'application ; sous le compte de la console quand root le lance sous un compte par service (app_console), tel quel sinon.
app_cmd() { if racine_separee; then app_console "$@"; else "$@"; fi; }

# Autorités de confiance de .env : SSL_CERT_FILE avec un certificat, sinon un seul dossier SSL_CERT_DIR (--use-system-ca ne lit pas de liste) aux noms hachés.
ca_ok() {
    if [ -n "${SSL_CERT_FILE:-}" ]; then grep -q -- '-----BEGIN CERTIFICATE-----' "$SSL_CERT_FILE"; return; fi
    case "${SSL_CERT_DIR:-}" in *:*) return 1 ;; esac
    compgen -G "${SSL_CERT_DIR:-}/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].[0-9]*" >/dev/null
}

# =============================================================================
#  configure
# =============================================================================
cmd_configure() {
    need_venv
    # Root sous un compte par service : l'assistant et deploy/configure.py tournent sous le compte de la console (app_console), qui écrit config.json ; les fichiers de l'opérateur (.env, mcp.json) ne sont pas écrits, leurs changements sont affichés.
    if racine_separee; then
        # Fichier de réponses de root (install.sh) : donné par l'entrée standard, jamais lu par chemin sous ce compte.
        local a=() f="" i
        for ((i = 1; i <= $#; i++)); do
            case "${!i}" in
                --answers) i=$((i + 1)); f="${!i:-}"; a+=(--answers -) ;;
                --answers=*) f="${!i#--answers=}"; a+=(--answers -) ;;
                *) a+=("${!i}") ;;
            esac
        done
        if [ -n "$f" ]; then app_console bash "$ROOT/elpis" configure "${a[@]}" < "$f"
        elif [ -t 0 ] && [ -t 1 ]; then app_console --terminal bash "$ROOT/elpis" configure "${a[@]}"
        else app_console bash "$ROOT/elpis" configure "${a[@]}"; fi
        return
    fi
    # Opérateur d'unités à un compte par service : les options que deploy/configure.py sert avant tout, sans le core (jamais les options dans le message : elles peuvent porter des secrets).
    if operateur_separe; then
        case " $* " in
            *" --migrer-mcp "*|*" --verifier-mcp "*|*" --verifier-familles-mcp "*|*" --check-llm "*|*" --conseils-moteur "*|*" -h "*|*" --help "*) ;;
            *) die "Un compte par service : config.json est écrit par la console, avec les clés des services : lancez sudo ./elpis configure (mêmes options)." ;;
        esac
    fi
    # Sans option, dans un terminal : assistant par pages (deploy/wizard.py) —
    # toutes les réponses d'abord, puis application sans question. Avec des
    # options, ou sans terminal : deploy/configure.py directement
    # (« ./elpis configure --help »).
    if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
        local dossier ans rc
        # Le fichier de réponses porte des secrets : dossier temporaire privé (à root seul sous sudo), jamais sous user_db.
        dossier="$(mktemp -d)" || die "Dossier temporaire indisponible."
        ans="$dossier/configure-answers.json"
        (
            trap 'rm -rf -- "$dossier"' EXIT
            "$PY" "$ROOT/deploy/wizard.py" configure --out "$ans"
            rc=$?
            case $rc in
                0) "$PY" "$ROOT/deploy/configure.py" --answers "$ans" ;;
                1) info "Rien n'a été modifié." ;;
                *) exit 3 ;;
            esac
        )
        rc=$?
        [ "$rc" -ne 3 ] && return "$rc"
        warn "Assistant indisponible dans ce terminal : questions en lignes."
    fi
    "$PY" "$ROOT/deploy/configure.py" "$@"
}

# =============================================================================
#  Définition des services (commande, dossier, environnement)
# =============================================================================
_bind_default() {
    # Même règle que le core (apps/core/src/ecoute.ts) : HTTPS → 127.0.0.1 ;
    # config absente ou illisible → 127.0.0.1 ; security.listen « lan » →
    # 0.0.0.0, « local » → 127.0.0.1 ; clé absente (config d'avant le
    # réglage) → 0.0.0.0. Core non construit : 127.0.0.1.
    local h; h="$(lanceur ecoute)"
    case "$h" in 0.0.0.0|127.0.0.1) echo "$h" ;; *) echo 127.0.0.1 ;; esac
}

# HTTPS actif (frontal Caddy) ? Distinct du bind : « listen local » donne aussi
