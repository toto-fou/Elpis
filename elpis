        fi
    fi
    if [ -n "$sans_cles" ]; then
        info "RAG : non vérifié par ce compte$sans_cles"
    elif [ -f "$ROOT/config.json" ] && [ "$core_ok" -eq 1 ]; then
        # Extracteur, jeton et magasin partagés, Qdrant, embeddings, reclassement et OCR : vus par le core.
        lignes_doctor "RAG" app_cmd env ELPIS_RACINE="$ROOT" timeout 120 "$NODE" --use-system-ca "$CORE_DIST/exploitation.mjs" rag
    else
        info "RAG : non vérifié (core non construit ou config.json absent)"
    fi
    doctor_comptes
    doctor_cles_systemd
    doctor_journaux
    doctor_coffre
    doctor_connexion
    sonde_du_core
    echo
    cmd_status
    [ "$bad" -eq 0 ] && ok "Aucun problème détecté." || warn "$bad point(s) à corriger."
    return "$bad"
}

