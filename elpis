# Sonde du moteur faite par main au démarrage : lignes [moteur] de son journal depuis le dernier résumé ; main arrêté : dit, sans échec.
sonde_du_core() {
    local journal lignes l msg n=0
    if systemd_active; then
        journal="$(journalctl -u "${UNIT_PREFIX}-main" -n 5000 --no-pager -o cat 2>/dev/null)"
    elif pid_of main >/dev/null; then
        journal="$(tail -n 5000 "$LOG_DIR/main.log" 2>/dev/null)"
    else
        info "sonde du moteur par le core : main arrêté, pas de rapport (./elpis start, puis ./elpis doctor)"
        return 0
    fi
    lignes="$(printf '%s\n' "$journal" | awk '
        index($0, "[moteur] ") == 0 { next }
        / injoignable sur |, concurrence gérée par le moteur|, file d.Elpis/ { n = 0 }
        { b[n++] = $0 }
        END { for (i = 0; i < n && i < 12; i++) print b[i] }')"
    if [ -z "$lignes" ]; then
        info "sonde du moteur par le core : aucune ligne [moteur] dans le journal de main (sonde en cours, ou ./elpis logs main)"
        return 0
    fi
    while IFS= read -r l; do
        msg="${l#*"[moteur] "}"
        if [ "$n" -eq 0 ]; then info "sonde du moteur par le core (${l%% *}) : $msg"
        else case "$l" in *" WARNING "*|*" ERROR "*) warn "  $msg" ;; *) info "  $msg" ;; esac; fi
        n=$((n+1))
    done <<< "$lignes"
}

cmd_doctor() {
    local bad=0 sortie
    charger_env
    NODE="$(node_bin)"
    check() { if eval "$2" >/dev/null 2>&1; then ok "$1"; else warn "$1 : NON ($3)"; bad=$((bad+1)); fi; }
    # Facultatif : signalé, sans compter comme un problème.
    check_opt() { if eval "$2" >/dev/null 2>&1; then ok "$1"; else info "$1 : absent ($3)"; fi; }
    check_out() { if sortie="$(eval "$2" 2>&1)"; then ok "$1 : $sortie"; else warn "$1 : NON (${sortie:+$sortie ; }$3)"; bad=$((bad+1)); fi; }
    # Paquets apt d'un groupe : manquants = problème si le groupe sert ici, sinon simple information.
    check_apt() {
        local manquants=() l liste="" cmd
        mapfile -t manquants < <(prerequis_manquants "$1")
        if [ "${#manquants[@]}" -eq 0 ]; then ok "paquets apt ($1)"; return 0; fi
        for l in "${manquants[@]}"; do liste+="${liste:+, }$(prerequis_libelle "$l")"; done
        cmd="$(prerequis_commande "${manquants[@]}")"
        if apt_groupe_sert "$1"; then warn "paquets apt ($1) : NON (manquants : $liste ; $cmd)"; bad=$((bad+1))
        else info "paquets apt ($1, facultatif) : absents : $liste ($cmd)"; fi
    }
    if command -v dpkg-query >/dev/null 2>&1; then
        local groupe
        for groupe in $(prerequis_groupes); do
            if [ "$groupe" = socle ] || prerequis_os_connu; then check_apt "$groupe"
            else info "paquets apt ($groupe) : noms de Debian 12/13 et Ubuntu 24.04, non vérifiés sur ce système (deploy/prerequis-apt.txt)"; fi
        done
    else
        info "paquets apt : dpkg-query absent, prérequis non vérifiés (deploy/prerequis-apt.txt)"
    fi
    check "venv Python" "[ -x '$PY' ]" "./install.sh"
    check "dépendances Python" "'$PY' -c 'import fastapi, fastmcp, httpx, uvicorn'" "./install.sh"
    local v_runtime="NODE_RUNTIME_SHA256_$(uname -m)" runtime_attendu
    runtime_attendu="${!v_runtime:-absente}"
    if [ "$NODE" = "$NODE_DIR/bin/node" ]; then
        check "runtime Node.js livré (node/, sans npm, empreinte ${runtime_attendu:0:12})" \
            "[ \"\$(runtime_empreinte '$NODE_DIR')\" = '$runtime_attendu' ]" \
            "./install.sh, ou ./install.sh --offline <paquet de cette version>"
    else
        info "runtime Node.js : $NODE (ELPIS_NODE ou PATH), empreinte non vérifiée"
    fi
    check "Node.js du core $("$NODE" -v 2>/dev/null || echo absent) ($NODE)" "node_ok" \
        "24.x, $NODE_MIN au moins : ./install.sh installe $NODE_VERSION dans node/"
    check "core construit (apps/core/dist/main.mjs)" "[ -f '$CORE_DIST/main.mjs' ]" "./install.sh, ou ./install.sh --offline <paquet de cette version>"
    if [ -f "$CORE_DIST/exploitation.mjs" ]; then
        check_out "module natif du core" "core_cmd natif" "./install.sh"
        check_out "bundle du core" "core_cmd empreinte" "./install.sh, ou ./install.sh --offline <paquet de cette version>"
    fi
    # Hôte d'outils : construit, à jour des sources, node-pty (PTY du terminal) et better-sqlite3 chargés pour cette machine.
    check "hôte d'outils construit (apps/toolhost/dist/main.mjs)" "[ -f '$HOTE_DIST/main.mjs' ]" "./install.sh, ou ./install.sh --offline <paquet de cette version>"
    if [ -f "$HOTE_DIST/main.mjs" ]; then
        check_out "bundle de l'hôte d'outils" "ELPIS_RACINE='$ROOT' '$NODE' '$HOTE_DIST/main.mjs' --empreinte" \
            "./install.sh, ou ./install.sh --offline <paquet de cette version>"
        check_out "modules natifs de l'hôte d'outils" "timeout 30 '$NODE' '$HOTE_DIST/main.mjs' --natif" \
            "bundle incomplet ou d'une autre architecture : paquet hors ligne de cette architecture, ou construction sur place (build-essential, python3 : npm ci y compile node-pty)"
    fi
    if [ -n "${SSL_CERT_FILE:-}${SSL_CERT_DIR:-}" ]; then
        check "autorités de confiance (${SSL_CERT_FILE:-SSL_CERT_DIR=$SSL_CERT_DIR})" "ca_ok" \
            "fichier PEM, ou un seul dossier aux noms hachés (openssl rehash) : ./elpis configure --ca-file systeme|<fichier PEM>|aucun"
    else
        info "autorités de confiance : magasins par défaut (core : Node et /etc/ssl/certs ; httpx : certifi) ; PKI interne : ./elpis configure --ca-file systeme"
    fi
    check "dépendances de l'extracteur du RAG" "'$PY' -c 'import pdfplumber, pypdfium2, pypdf, openpyxl, docx, pptx'" "venv/bin/pip install -r requirements-rag.txt"
    check "config.json" "[ -f '$ROOT/config.json' ]" "./elpis configure"
    check "mcp.json" "[ -f '$ROOT/mcp.json' ]" "./elpis configure"
    check "jeton MCP" "[ -s '$ROOT/user_db/.local_mcp_token' ]" "./elpis configure"
    check "jeton du service RAG" "[ -s '$ROOT/user_db/.rag_service_token' ]" "./elpis configure"
    if [ -f "$ROOT/rag_app/rag_config.json" ] || [ -d "$ROOT/rag_app/DATA" ]; then
        warn "ancien RAG : NON (rag_app/rag_config.json ou rag_app/DATA encore là ; ./elpis restart ou ./install.sh le suppriment)"
        bad=$((bad+1))
    fi
    local th_host="${LOCAL_MCP_HOST:-127.0.0.1}"; [ "$th_host" = 0.0.0.0 ] && th_host=127.0.0.1
    check "hôte d'outils ($th_host:$MCP_PORT)" "curl --noproxy '*' -fsS -m 3 -o /dev/null 'http://$th_host:$MCP_PORT/health'" "./elpis logs toolhost"
    if [ -f "$HOTE_DIST/main.mjs" ]; then
        local natives
        natives="$(ELPIS_RACINE="$ROOT" timeout 30 "$NODE" "$HOTE_DIST/main.mjs" --familles-natives 2>/dev/null | tail -n 1)"
        info "hôte d'outils : familles natives ${natives:-aucune} (toolhost.json › familles_natives, absente = toutes les familles portées)"
    fi
    if svc_available tools && sans_famille_relayee; then
        info "elpis-tools : aucune famille relayée par l'hôte d'outils, rien à servir"
    elif svc_available tools; then
        check "familles Python, elpis-tools (127.0.0.1:$TOOLS_PORT)" "(exec 3<>/dev/tcp/127.0.0.1/$TOOLS_PORT)" "./elpis logs tools"
    fi
    check "outils du compte servis par main (mcp.json sans URL d'appmcp)" "'$PY' '$ROOT/deploy/configure.py' --verifier-mcp" "./elpis configure"
    check "familles d'outils de mcp.example.json présentes dans mcp.json" "'$PY' '$ROOT/deploy/configure.py' --verifier-familles-mcp" "./elpis configure"
    local retire
    for retire in ELPIS_TOOLHOST ELPIS_APPMCP ELPIS_CLI; do
        [ "${!retire:-}" = python ] && info "$retire=python : ignoré depuis la 0.1.0 (retour à la version Python : tag python-final, docs/exploitation.md), à retirer de .env"
    done
    check "Qdrant" "[ -x '$ROOT/rag_app/qdrant/qdrant' ]" "./install.sh"
    check "service navigateur" "[ -d '$ROOT/browser-service/node_modules' ]" "./install.sh"
    # En marche : son /health doit répondre et dire le navigateur utilisable.
    if curl --noproxy '*' -fsS -m 3 -o /dev/null "http://127.0.0.1:$BROWSER_PORT/health" 2>/dev/null; then
        check "service navigateur (/health)" \
            "curl --noproxy '*' -fsS -m 3 'http://127.0.0.1:$BROWSER_PORT/health' | grep -q '\"ok\":true'" \
            "./elpis logs browser"
    fi
    # Contrôles faits par le core (exploitation.mjs) : signalés non vérifiés s'il n'est pas construit.
    local etats_sans_compte distants core_ok=0
    [ -f "$CORE_DIST/exploitation.mjs" ] && core_ok=1
    if [ "$core_ok" -eq 1 ] && etats_sans_compte="$(core_cmd browser states --count 2>/dev/null)" && [ -n "$etats_sans_compte" ]; then
        [ "$etats_sans_compte" = 0 ] || info "navigateur : $etats_sans_compte état(s) d'avant la 0.0.1, sans compte : à rattacher ou à supprimer (./elpis browser states)"
    else
        info "navigateur : états d'avant la 0.0.1 non vérifiés (./elpis browser states)"
    fi
    if [ "$core_ok" -eq 0 ]; then
        info "verrous de fichiers : non vérifiés (core non construit)"
    elif distants="$(core_cmd fs-local 2>/dev/null)"; then
        ok "verrous de fichiers : dossiers de données sur disque local"
    else
        warn "verrous de fichiers : NON (${distants:-vérification impossible} ; NFS/CIFS non pris en charge)"
        bad=$((bad+1))
    fi
    check "Docker joignable" "docker info" "installer docker, groupe docker"
    local image
    image="$("$ROOT/deploy/docker/sandbox/build_offline.sh" --print-image 2>/dev/null)"
    check "image sandbox $image" "docker image inspect '$image'" "./install.sh ou deploy/docker/sandbox/build_offline.sh"
    check "bubblewrap (analyses du RAG et aperçus Office isolés)" "core_cmd bwrap" \
        "apt install bubblewrap ; user namespaces autorisés ; core construit requis"
    check_opt "LibreOffice (aperçus Office, facultatif)" "command -v soffice" "paquets apt du groupe apercus-office : deploy/prerequis-apt.txt"
    if _https_enabled; then
        check "Caddy actif (HTTPS)" "systemctl is-active --quiet caddy" "./install.sh --with-caddy puis ./elpis configure"
    fi
    if [ -f /etc/systemd/system/elpis-whisper.service ]; then
        check "reconnaissance vocale (:8090)" "curl --noproxy '*' -fsS -m 3 -o /dev/null http://127.0.0.1:8090/health" "systemctl status elpis-whisper"
        check "synthèse vocale (:8091)" "curl --noproxy '*' -fsS -m 3 -o /dev/null http://127.0.0.1:8091/health" "systemctl status elpis-tts"
    fi
    if [ -f "$ROOT/config.json" ] && [ "$core_ok" -eq 1 ]; then
        local db_hint="./elpis db info pour le détail ; ./elpis db use sqlite en secours"
        if [ "$(core_cmd config base-retiree 2>/dev/null)" = oui ]; then
            db_hint="MariaDB/MySQL n'est plus pris en charge : docs/exploitation.md, « Mettre à jour »"
        fi
        check "base de données joignable" "core_cmd db info" "$db_hint"
        check_out "base vue par le core" "core_cmd migrations" "./elpis db info"
        local llm moteur cle py="$PY"
        [ -x "$py" ] || py=python3
        llm="$(core_cmd config LLAMA_URL 2>/dev/null)"
        if [ -n "$llm" ]; then
            moteur="$(core_cmd config LLAMA_ENGINE 2>/dev/null)"
            cle="$(core_cmd config LLAMA_API_KEY 2>/dev/null)"
            # Clé passée par l'environnement : jamais sur une ligne de commande (ps), jamais affichée.
            check_out "serveur LLM" "ELPIS_CFG_LLM_API_KEY=\"\$cle\" '$py' '$ROOT/deploy/configure.py' --check-llm --engine '${moteur:-llamacpp}' --llm-url '$llm'" \
                "./elpis configure"
            local conseil
            while IFS= read -r conseil; do info "$conseil"; done \
                < <(ELPIS_CFG_LLM_API_KEY="$cle" "$py" "$ROOT/deploy/configure.py" --conseils-moteur --engine "${moteur:-llamacpp}" 2>/dev/null)
        fi
    fi
    if [ -f "$ROOT/config.json" ] && [ "$core_ok" -eq 1 ]; then
        local niveau texte
        # Extracteur, jeton et magasin partagés, Qdrant, embeddings, reclassement et OCR : vus par le core.
        while IFS=$'\t' read -r niveau texte; do
            case "$niveau" in
                ok) ok "$texte" ;;
                warn) warn "$texte"; bad=$((bad+1)) ;;
                info) info "$texte" ;;
                *) [ -n "$niveau$texte" ] && { warn "RAG : NON ($niveau $texte)"; bad=$((bad+1)); } ;;
            esac
        done < <(ELPIS_RACINE="$ROOT" timeout 120 "$NODE" --use-system-ca "$CORE_DIST/exploitation.mjs" rag 2>&1)
    else
        info "RAG : non vérifié (core non construit ou config.json absent)"
    fi
    sonde_du_core
    echo
    cmd_status
    [ "$bad" -eq 0 ] && ok "Aucun problème détecté." || warn "$bad point(s) à corriger."
    return "$bad"
}

