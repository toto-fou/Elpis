# Sonde du moteur faite par main au démarrage : lignes [moteur] de son journal depuis le dernier résumé ; main arrêté : dit, sans échec.
sonde_du_core() {
    local journal lignes l msg n=0
    if systemd_active; then
        journal="$(journalctl -u "${UNIT_PREFIX}-main" -n 5000 --no-pager -o cat 2>/dev/null)"
    elif pid_of main >/dev/null; then
        journal="$(tail -n 5000 "$LOG_DIR/main.log" 2>/dev/null)"
    else
        info "sonde du moteur par le core : main arrêté, pas de rapport (./elpis start, puis ./elpis doctor)"
        return 0
    fi
    lignes="$(printf '%s\n' "$journal" | awk '
        index($0, "[moteur] ") == 0 { next }
        / injoignable sur |, concurrence gérée par le moteur|, file d.Elpis/ { n = 0 }
        { b[n++] = $0 }
        END { for (i = 0; i < n && i < 12; i++) print b[i] }')"
    if [ -z "$lignes" ]; then
        info "sonde du moteur par le core : aucune ligne [moteur] dans le journal de main (sonde en cours, ou ./elpis logs main)"
        return 0
    fi
    while IFS= read -r l; do
        msg="${l#*"[moteur] "}"
        if [ "$n" -eq 0 ]; then info "sonde du moteur par le core (${l%% *}) : $msg"
        else case "$l" in *" WARNING "*|*" ERROR "*) warn "  $msg" ;; *) info "  $msg" ;; esac; fi
        n=$((n+1))
    done <<< "$lignes"
}

# /health du service navigateur d'un bac (socket $1, jeton du fichier $2) : socket saisi sans suivre de lien (le bac écrit dans son dossier) en O_PATH|O_NOFOLLOW, vérifié, joint par /proc/self/fd ; vrai s'il répond ok.
sante_navigateur_bac() {
    "${PY:-python3}" -I - "$1" "$2" <<'PY' 2>/dev/null
import os, socket, stat, sys
fd = os.open(sys.argv[1], os.O_PATH | os.O_NOFOLLOW)
if not stat.S_ISSOCK(os.fstat(fd).st_mode):
    sys.exit(1)
with open(sys.argv[2], encoding="utf-8") as f:
    jeton = f.readline().strip()
s = socket.socket(socket.AF_UNIX)
s.settimeout(3)
s.connect(f"/proc/self/fd/{fd}")
s.sendall(f"GET /health HTTP/1.0\r\nHost: browser\r\nAuthorization: Bearer {jeton}\r\n\r\n".encode())
lu = b""
while len(lu) < 65536:
    m = s.recv(65536)
    if not m:
        break
    lu += m
sys.exit(0 if lu.startswith(b"HTTP/1.1 200") and b'"ok":true' in lu else 1)
PY
}

# Isolation des bacs : script de démarrage, réseau sans trafic entre bacs, filtrage du pont, version de Docker, swap, root remappé ou noyau applicatif, sudo ; script, réseau, filtrage et version comptés (compteur bad), le reste en conseil.
doctor_isolation_bac() {
    local sec runtime sudo_permis reseau version majeure py ouverts
    if [ -r "$ROOT/sandbox-agent/demarrage.sh" ]; then ok "script de démarrage des bacs présent"
    else warn "script de démarrage des bacs absent (sandbox-agent/demarrage.sh) : aucun bac ne démarre ; réinstallez ou mettez à jour"; bad=$((bad + 1)); fi
    sec="$(docker info --format '{{join .SecurityOptions " "}}' 2>/dev/null)" || return 0
    if reseau="$(docker network inspect elpis-sandbox --format '{{.Driver}}|{{.EnableIPv6}}|{{index .Options "com.docker.network.bridge.enable_icc"}}|{{index .Options "com.docker.network.bridge.name"}}' 2>/dev/null)"; then
        if [ "$reseau" = "bridge|false|false|br-elpis-sb" ]; then ok "réseau des bacs : pont dédié, trafic entre bacs coupé"
        else warn "réseau Docker elpis-sandbox non conforme ($reseau) : les bacs des profils ouverts ou filtrés ne démarrent pas (docker network rm elpis-sandbox une fois les bacs arrêtés : il sera recréé)"; bad=$((bad + 1)); fi
        if [ "$(cat /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null)" != 1 ]; then
            warn "filtrage du trafic ponté inactif (net.bridge.bridge-nf-call-iptables) : la coupure entre bacs repose dessus (module br_netfilter)"; bad=$((bad + 1))
        fi
    else
        info "réseau des bacs : créé au premier bac d'un profil ouvert ou filtré"
    fi
    version="$(docker version --format '{{.Server.Version}}' 2>/dev/null)"; majeure="${version%%.*}"
    case "$majeure" in ''|*[!0-9]*) ;; *) if [ "$majeure" -lt 26 ]; then warn "Docker $version : la coupure entre bacs demande Docker 26 ou plus récent (avant, l'IPv6 lien-local des interfaces relie les conteneurs)"; bad=$((bad + 1)); fi ;; esac
    [ "$(docker info --format '{{.SwapLimit}}' 2>/dev/null)" != false ] || warn "noyau sans limite du swap des conteneurs : un bac peut dépasser sa mémoire en swap (cgroup swap à activer)"
    py="${PY:-python3}"; [ -x "$py" ] || py=python3
    runtime="$("$py" -c 'import json, sys
try: print(((json.load(open(sys.argv[1])).get("executors") or {}).get("runtime") or ""))
except Exception: print("")' "$ROOT/config.json" 2>/dev/null)"
    sudo_permis="$("$py" -c 'import json, sys
lu = True
try: v = (json.load(open(sys.argv[1])).get("executors") or {}).get("allow_sudo", True)
except FileNotFoundError: v = True
except Exception: lu = False
print(("oui" if v is True else "non") if lu else "")' "$ROOT/config.json" 2>/dev/null)"
    case "$sec $runtime" in
        *userns*|*rootless*|*runsc*|*kata*) ok "isolation des bacs : renforcée (${runtime:-$sec})" ;;
        *) info "isolation des bacs : ni userns-remap, ni Docker rootless, ni gVisor ; une faille du noyau mène d'un bac à l'hôte (SECURITY.md, « Hardened isolation »)" ;;
    esac
    case "$sudo_permis" in
        oui) info "sudo permis dans les bacs au réseau non filtré (executors.allow_sudo) : le compte y est root de son conteneur" ;;
        non) ok "bacs durcis : sudo refusé (executors.allow_sudo)" ;;
        *) warn "réglage executors.allow_sudo non lu (config.json ou Python indisponible)" ;;
    esac
    ouverts="$("$py" -c 'import json, sys
try: p = (json.load(open(sys.argv[1])).get("executors") or {}).get("network_profiles") or []
except Exception: p = []
print(" ".join(str(x.get("id")) for x in p if isinstance(x, dict) and x.get("mode") == "bridge" and not any(x.get(k) for k in ("block_metadata", "block_lan", "block_host"))))' "$ROOT/config.json" 2>/dev/null)"
    [ -z "$ouverts" ] || info "profils réseau ouverts sans protection ($ouverts) : leurs bacs joignent le réseau local, la machine hôte et les métadonnées du cloud (console › Sandbox, cases « Refuser »)"
    return 0
}

# Navigateur, dans la sandbox de chaque compte seulement : autorité du relais (clé 0600), dossiers montés lisibles par l'UID du bac, headless shell, services des comptes en marche et leur relais ; appelée par cmd_doctor (compteur bad).
doctor_navigateur_bac() {
    local ca cpu pw nm sb s d j jt n=0
    # Navigateur non installé : déjà signalé par le contrôle « service navigateur ».
    [ -d "$ROOT/browser-service/node_modules" ] || return 0
    ca="${ELPIS_BROWSER_CA_DIR:-$ROOT/user_db/browser-relay-ca}"
    if [ -d "$ca" ] && [ ! -x "$ca" ]; then
        info "navigateur dans le bac : autorité du relais ($ca) réservée au compte de l'hôte d'outils, non vérifiable par ce compte (doctor avec sudo)"
    else
        check "navigateur dans le bac : autorité du relais ($ca)" "créée au démarrage de l'hôte d'outils : ./elpis restart" test -s "$ca/ca.crt" -a -s "$ca/ca.key"
        [ -f "$ca/ca.key" ] && check "navigateur dans le bac : clé de l'autorité en 0600" "chmod 600 $ca/ca.key" test "$(stat -c %a "$ca/ca.key")" = 600
    fi
    # Chromium partage le quota CPU du bac : à 1 CPU, les captures d'étape des pages lourdes dépassent leur délai de 3 s (mesuré : ~5 % des actions, aucune à 2 CPU).
    cpu="$("${PY:-python3}" -c 'import json, sys
try: print(int(((json.load(open(sys.argv[1])).get("executors") or {}).get("limits") or {}).get("cpu_quota_pct") or 100))
except Exception: print(100)' "$ROOT/config.json" 2>/dev/null)"
    [ "${cpu:-100}" -ge 200 ] || info "navigateur dans le bac : ${cpu:-100} % de CPU par bac (executors.limits.cpu_quota_pct) ; Chromium y partage ce quota, 200 conseillé (captures d'étape des pages lourdes hors délai à 100)."
    pw="${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}"
    check "navigateur dans le bac : headless shell de Chromium ($pw)" "./install.sh" compgen -G "$pw/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell"
    nm="$(readlink -f "$ROOT/browser-service/node_modules" 2>/dev/null)"
    check "navigateur dans le bac : service, modules et headless shell lisibles par l'UID du bac (o+rx)" "chmod o+rx ${nm:-browser-service/node_modules} browser-service/dist ; chmod o+r browser-service/dist/main.mjs" \
        test "$(find "$ROOT/browser-service" "$ROOT/browser-service/dist" "${nm:-/nonexistent}" "$pw" -maxdepth 0 -perm -o+rx 2>/dev/null | wc -l)" = 4 -a -n "$(find "$ROOT/browser-service/dist/main.mjs" -perm -o+r 2>/dev/null)"
    sb="$(core_cmd config SANDBOX_DIR 2>/dev/null)"
    # Jetons du service : dossier d'exécution de l'hôte d'outils (unité systemd) ou, sans systemd, $RUN_DIR/navigateur.
    jt="$RUN_DIR/navigateur"
    if systemd_active && [ "$(systemctl show -p WorkingDirectory --value "${UNIT_PREFIX}-toolhost.service" 2>/dev/null)" = "$ROOT" ]; then jt="/run/${UNIT_PREFIX}-toolhost/navigateur"; fi
    if [ -d "${jt%/*}" ] && [ ! -x "${jt%/*}" ]; then
        info "navigateur dans le bac : état des services non vérifiable par ce compte (jetons réservés au compte de l'hôte d'outils : doctor avec sudo)"; return 0
    fi
    for s in "${sb:-/nonexistent}"/*/.elpis-agent/browser.sock; do
        [ -S "$s" ] || continue
        d="$(dirname "$(dirname "$s")")"; j="$jt/${d##*/}.service.token"; n=$((n+1))
        if [ -s "$j" ] && sante_navigateur_bac "$s" "$j"; then
            check "navigateur du bac ${d##*/} : en marche, relais de l'hôte à l'écoute" "./elpis logs toolhost ; ./elpis logs browser ${d##*/}" test ! -L "$d/.elpis-agent/browser-relay.sock" -a -S "$d/.elpis-agent/browser-relay.sock"
        else
            info "navigateur du bac ${d##*/} : arrêté (relancé au prochain outil pw_* ; ./elpis logs browser ${d##*/})"
        fi
    done
    [ "$n" -gt 0 ] || info "navigateur dans le bac : aucun service en marche (démarré au premier outil pw_* d'un compte)"
}

# Comptes des services (unités installées) : un par service, un seul choisi, repli ou unités d'avant ce réglage (marche à suivre) ; en mode séparé, groupe des données de cette session et droits des dossiers partagés (de backups/, le mode seul) ; appelée par cmd_doctor (compteur bad).
doctor_comptes() {
    local mode c chemin attendu vu sb rs
    mode="$(mode_installe)"
    case "$mode" in
        "") return 0 ;;
        separes) ok "comptes des services : un par service ($UNIT_PREFIX-main, $UNIT_PREFIX-admin, $UNIT_PREFIX-toolhost)" ;;
        unique) info "comptes des services : un seul compte, choisi (ELPIS_COMPTE_UNIQUE=1)" ;;
        repli) c="$(dossier_ferme "$ROOT")" && c=" : $c sans droit de traversée pour les autres comptes"
               warn "comptes des services : un seul compte (repli$c) ; pour un compte par service : installation dans /opt/elpis, ou dossiers parents traversables et code lisible par les autres comptes (docs/operations.md, « Service accounts »), puis sudo ./elpis service install"; bad=$((bad+1)) ;;
        *) warn "comptes des services : un seul compte (unités d'avant les comptes séparés) : sudo ./elpis service install pour un compte par service"; bad=$((bad+1)) ;;
    esac
    [ "$mode" = separes ] || return 0
    if id -nG "$(id -un)" | tr ' ' '\n' | grep -qxF -- "$GROUPE_DONNEES" && ! id -Gn | tr ' ' '\n' | grep -qxF -- "$GROUPE_DONNEES"; then
        warn "groupe $GROUPE_DONNEES absent de cette session (ouverte avant son ajout) : données des services illisibles d'ici (nouvelle session, ou sg $GROUPE_DONNEES -c './elpis doctor')"; bad=$((bad+1))
    fi
    sb="$(core_cmd config SANDBOX_DIR 2>/dev/null)"; rs="$(core_cmd config RAG_STORE_DIR 2>/dev/null)"
    for c in "$ROOT/user_db|2771 root $GROUPE_DONNEES" "${sb:-$ROOT/user_sandboxes}|2770 root $GROUPE_DONNEES" "$LOG_DIR|2770 root $GROUPE_DONNEES" \
             "$ROOT/backups|700" "$SYS_PREFIXE/etc/elpis|751 root root" \
             "${rs:-$ROOT/user_db/rag}|2770 $UNIT_PREFIX-main $GROUPE_RAG" "$JETON_RAG_SYS|440 root $GROUPE_RAG"; do
        chemin="${c%%|*}"; attendu="${c#*|}"
        [ -e "$chemin" ] || continue
        vu="$(stat -c '%a %U %G' -- "$chemin" 2>/dev/null)"
        [[ "$vu " == "$attendu "* ]] || { warn "droits : $chemin en ${vu:-?} (attendu $attendu : sudo ./elpis service install)"; bad=$((bad+1)); }
    done
}

# Journal de sécurité et centralisation (ANSSI) : dossiers et droits (compte des services), clé de signature, règle rsyslog et ses paquets, journald persistant, horloge ; appelée par cmd_doctor (compteur bad).
doctor_journaux() {
    local m d compte attendu admis="" regles=()
    if [ "$(mode_installe)" = separes ]; then
        compte="$UNIT_PREFIX-main $UNIT_PREFIX-admin $UNIT_PREFIX-toolhost"; attendu="2770 root"; admis=syslog
    else
        compte="$(compte_services)"
        [ -n "$compte" ] || compte="$(id -un)"
        [ "$compte" != root ] || compte="$(stat -c %U "$ROOT")"
        attendu="2750 $compte"
    fi
    for d in "$AUDIT_DIR_SYS" "$APPLOG_DIR_SYS"; do
        [ -e "$d" ] || [ -L "$d" ] || continue
        m="$(stat -c '%a %U %G' -- "$d" 2>/dev/null || echo '? ? ?')"
        case "$m" in
            "$attendu $GROUPE_JOURNAL"|"$attendu adm") ok "journaux : $d ($m)" ;;
            *) warn "journaux : $d en $m (attendu ${attendu%% *} ${attendu#* }:$GROUPE_JOURNAL : sudo ./elpis audit setup)"; bad=$((bad+1)) ;;
        esac
    done
    if [ ! -d "$AUDIT_DIR_SYS" ]; then
        warn "journal de sécurité : dossier de repli logs/audit (sudo ./elpis audit setup)"; bad=$((bad+1))
    elif compgen -G "$ROOT/logs/audit/audit-*.jsonl" >/dev/null; then
        warn "journal de sécurité : fichiers restés dans logs/audit, ni transmis ni purgés (services arrêtés : ./elpis stop ou sudo systemctl stop ${UNIT_PREFIX}.target, puis sudo ./elpis audit setup, qui les déplace ou les ajoute au fichier du même jour)"; bad=$((bad+1))
    fi
    doctor_cle "$compte" "$admis"
    mapfile -t regles < <(compgen -G "$SYS_PREFIXE/etc/rsyslog.d/*elpis*.conf")
    if [ "${#regles[@]}" -gt 0 ]; then
        ok "centralisation : règle Elpis ${regles[0]}"
        doctor_paquets_rsyslog "${regles[@]}"
    elif mapfile -t regles < <(compgen -G "$SYS_PREFIXE/etc/syslog-ng/conf.d/*elpis*.conf") && [ "${#regles[@]}" -gt 0 ]; then
        ok "centralisation : règle Elpis ${regles[0]}"
    else
        info "centralisation : aucune règle rsyslog Elpis (exemples dans deploy/rsyslog/, ANSSI R9)"
    fi
    if [ -d /var/log/journal ]; then ok "journald persistant (/var/log/journal)"
    else info "journald : journaux en mémoire seulement (Storage=persistent, voir deploy/journald/)"; fi
    if command -v timedatectl >/dev/null 2>&1; then
        case "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" in
            yes) ok "horloge synchronisée (NTP)" ;;
            no)  warn "horloge NON synchronisée : horodatage des journaux douteux (chrony ou timesyncd sur un serveur de temps interne)"; bad=$((bad+1)) ;;
            *)   info "horloge : état de synchronisation inconnu" ;;
        esac
    fi
}

# Lecture d'un fichier par un compte : essai réel sous root (runuser), sinon d'après le mode et les groupes du compte.
compte_lit() {
    local m g
    if [ "$(id -u)" -eq 0 ]; then (cd / && runuser -u "$1" -- test -r "$2"); return; fi
    if [ "$(id -un)" = "$1" ] && [ -r "$2" ]; then return 0; fi
    read -r m g < <(stat -c '%a %G' -- "$2" 2>/dev/null) || return 1
    [ $(( 8#$m & 8#040 )) -ne 0 ] && id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qx "$g"
}

# Premier des COMPTES qui ne lit pas FICHIER (compte_lit) ; échec si tous le lisent.
compte_sans_lecture() {
    local f="$1" c; shift
    for c in "$@"; do compte_lit "$c" "$f" || { echo "$c"; return 0; }; done
    return 1
}

# Clé de signature : 0440 root, groupe réservé aux comptes des services (COMPTES, ADMIS : membres permis en plus), lisible par chacun, 32 octets au moins quand ce compte-ci la lit.
doctor_cle() {
    local compte="$1" admis="$1 ${2:-}" m g c dossier="${AUDIT_KEY_SYS%/*}"
    # Sous le compte des services : lecture réelle ; une session ouverte avant audit setup n'a pas encore le groupe de la clé.
    if [ "$(id -u)" -ne 0 ] && [ "$(id -un)" = "$compte" ] && [ -d "$dossier" ] \
            && { [ ! -x "$dossier" ] || [ -e "$AUDIT_KEY_SYS" ]; } && [ ! -r "$AUDIT_KEY_SYS" ]; then
        g="$(stat -c %G -- "$AUDIT_KEY_SYS" 2>/dev/null || stat -c %G -- "$dossier")"
        if ! id -Gn | tr ' ' '\n' | grep -qxF -- "$g" && id -Gn "$compte" | tr ' ' '\n' | grep -qxF -- "$g"; then
            warn "journal de sécurité : clé illisible par ce processus, sans le groupe $g (session ouverte avant son ajout) : ./elpis start lancé d'ici écrit des lignes non signées (nouvelle session, ou sg $g -c './elpis restart')"
        else
            warn "journal de sécurité : clé $AUDIT_KEY_SYS illisible par le compte des services $compte, lignes non signées (sudo ./elpis audit setup)"
        fi
        bad=$((bad+1)); return 0
    fi
    if [ -d "$dossier" ] && [ ! -x "$dossier" ]; then
        info "journal de sécurité : clé non vérifiable par ce compte ($dossier réservé au compte des services $compte : doctor sous ce compte ou avec sudo)"; return 0
    fi
    if [ ! -e "$AUDIT_KEY_SYS" ] && [ ! -L "$AUDIT_KEY_SYS" ]; then
        warn "journal de sécurité : lignes non signées (clé absente : sudo ./elpis audit setup)"; bad=$((bad+1)); return 0
    fi
    m="$(stat -c '%a %U %G' -- "$AUDIT_KEY_SYS" 2>/dev/null)"; g="${m##* }"
    if [ -L "$AUDIT_KEY_SYS" ] || [ ! -f "$AUDIT_KEY_SYS" ] || [ "$m" != "440 root $g" ]; then
        warn "journal de sécurité : clé $AUDIT_KEY_SYS en ${m:-?} (attendu 440 root, groupe réservé à $compte : sudo ./elpis audit setup)"
    elif ! groupe_propre "$g" "$admis"; then
        warn "journal de sécurité : clé lisible par le groupe $g, qui n'est pas réservé à $compte (sudo ./elpis audit setup)"
    elif c="$(compte_sans_lecture "$AUDIT_KEY_SYS" $compte)"; then
        warn "journal de sécurité : clé illisible par le compte des services $c, lignes non signées (sudo ./elpis audit setup)"
    elif [ -r "$AUDIT_KEY_SYS" ] && [ "$(tr -d ' \t\r\n' < "$AUDIT_KEY_SYS" | wc -c)" -lt 32 ]; then
        warn "journal de sécurité : clé $AUDIT_KEY_SYS trop courte (32 octets au moins), lignes non signées"
    else
        ok "journal de sécurité : lignes signées (clé $AUDIT_KEY_SYS, groupe $g)"; return 0
    fi
    bad=$((bad+1))
}

# Coffre « Secrets » : clé 0440 root, groupe réservé aux comptes des services qui l'ouvrent (main et la console en mode séparé), lisible par chacun (sous ce compte : lecture réelle, une session ouverte avant l'ajout du groupe de la clé ne la lit pas) ; repli, clé illisible ou invalide et secrets d'une autre clé vus par le core (compteur bad).
doctor_coffre() {
    local compte m g c niveau texte dossier="${VAULT_KEY_SYS%/*}"
    if [ "$(mode_installe)" = separes ]; then
        compte="$UNIT_PREFIX-main $UNIT_PREFIX-admin"
    else
        compte="$(compte_services)"
        [ -n "$compte" ] || compte="$(id -un)"
        [ "$compte" != root ] || compte="$(stat -c %U "$ROOT")"
    fi
    if [ "$(id -u)" -ne 0 ] && [ "$(id -un)" = "$compte" ] && [ -d "$dossier" ] \
            && { [ ! -x "$dossier" ] || [ -e "$VAULT_KEY_SYS" ]; } && [ ! -r "$VAULT_KEY_SYS" ]; then
        g="$(stat -c %G -- "$VAULT_KEY_SYS" 2>/dev/null || stat -c %G -- "$dossier")"
        if ! id -Gn | tr ' ' '\n' | grep -qxF -- "$g" && id -Gn "$compte" | tr ' ' '\n' | grep -qxF -- "$g"; then
            warn "coffre (Secrets) : clé illisible par ce processus, sans le groupe $g (session ouverte avant son ajout) : les services lancés d'ici n'ouvriraient pas le coffre (nouvelle session, ou sg $g -c './elpis restart')"
        else
            warn "coffre (Secrets) : clé $VAULT_KEY_SYS illisible par le compte des services $compte (sudo ./elpis vault setup)"
        fi
        bad=$((bad+1)); return 0
    fi
    if [ -e "$VAULT_KEY_SYS" ] || [ -L "$VAULT_KEY_SYS" ]; then
        m="$(stat -c '%a %U %G' -- "$VAULT_KEY_SYS" 2>/dev/null)"; g="${m##* }"
        if [ -L "$VAULT_KEY_SYS" ] || [ ! -f "$VAULT_KEY_SYS" ] || [ "$m" != "440 root $g" ]; then
            warn "coffre (Secrets) : clé $VAULT_KEY_SYS en ${m:-?} (attendu 440 root, groupe réservé à $compte : sudo ./elpis vault setup)"; bad=$((bad+1))
        elif ! groupe_propre "$g" "$compte"; then
            warn "coffre (Secrets) : clé lisible par le groupe $g, qui n'est pas réservé à $compte (sudo ./elpis vault setup)"; bad=$((bad+1))
        elif c="$(compte_sans_lecture "$VAULT_KEY_SYS" $compte)"; then
            warn "coffre (Secrets) : clé $VAULT_KEY_SYS illisible par le compte des services $c (sudo ./elpis vault setup)"; bad=$((bad+1))
        fi
        if [ "$(id -u)" -ne 0 ] && [ ! -r "$VAULT_KEY_SYS" ]; then
            info "coffre (Secrets) : clé non lisible par ce compte, secrets non vérifiés (doctor sous le compte des services ou avec sudo)"; return 0
        fi
    elif [ "$(id -u)" -ne 0 ] && [ -d "$dossier" ] && [ ! -x "$dossier" ]; then
        info "coffre (Secrets) : clé non vérifiable par ce compte ($dossier réservé au compte des services $compte : doctor sous ce compte ou avec sudo)"; return 0
    fi
    if [ ! -f "$CORE_DIST/exploitation.mjs" ] || [ ! -f "$ROOT/config.json" ]; then
        info "coffre (Secrets) : non vérifié (core non construit ou config.json absent)"; return 0
    fi
    lignes_doctor "coffre (Secrets)" vault_core vault doctor
}

# Lignes « niveau<TAB>texte » de la sortie d'un diagnostic du core, rendues par ok / warn / info ; toute autre ligne, l'alerte de secret de session faible de son journal ou un échec sans défaut déjà compté sont des défauts (le reste du journal est tu).
lignes_doctor() {
    local libelle="$1" niveau texte sortie code erreur defaut=0 f
    shift
    f="$(mktemp)" || { warn "$libelle : NON (fichier temporaire impossible)"; bad=$((bad+1)); return 0; }
    sortie="$("$@" 2>"$f")"; code=$?
    while IFS=$'\t' read -r niveau texte; do
        case "$niveau" in
            ok) ok "$texte" ;;
            warn) warn "$texte"; bad=$((bad+1)); defaut=1 ;;
            info) info "$texte" ;;
            *) [ -n "$niveau$texte" ] && { warn "$libelle : NON ($niveau $texte)"; bad=$((bad+1)); defaut=1; } ;;
        esac
    done <<< "$sortie"
    while IFS= read -r texte; do
        warn "$libelle : NON ($texte)"; bad=$((bad+1)); defaut=1
    done < <(grep -a '\[CRITICAL\] Elpis SESSION_SECRET FAIBLE' -- "$f")
    erreur="$(grep -av -e '^[[:space:]]*$' -e '^Node\.js v' -- "$f" | tail -n 1)"
    rm -f -- "$f"
    [ "$code" -eq 0 ] || [ "$defaut" -eq 1 ] || { warn "$libelle : NON (${erreur:-échec, code $code})"; bad=$((bad+1)); }
}

# SSO OpenID Connect vu par le core (lecture seule, sans réseau) : une ligne « niveau<TAB>texte » par contrôle ; rien si le core ou config.json manque.
doctor_connexion() {
    local illisible=0 dossier="${VAULT_KEY_SYS%/*}"
    # Même garde que doctor_coffre : sous un compte qui ne lit pas la clé, le core ne lit aucun secret (aucune ligne de journal dans la sortie).
    if [ "$(id -u)" -ne 0 ] && [ -z "${ELPIS_VAULT_KEY:-}${ELPIS_VAULT_KEY_PATH:-}" ] && [ -d "$dossier" ] \
            && { [ ! -x "$dossier" ] || { [ -e "$VAULT_KEY_SYS" ] && [ ! -r "$VAULT_KEY_SYS" ]; }; }; then
        illisible=1
    fi
    if [ ! -f "$CORE_DIST/exploitation.mjs" ] || [ ! -f "$ROOT/config.json" ]; then
        info "SSO OpenID Connect : non vérifié (core non construit ou config.json absent)"; return 0
    fi
    ELPIS_DOCTOR_COFFRE_ILLISIBLE="$illisible" lignes_doctor "SSO OpenID Connect" vault_core auth doctor
}

# Pilotes cités par les règles rsyslog d'Elpis, lignes commentées exclues (gtls : rsyslog-gnutls, omrelp : rsyslog-relp) : rsyslogd -N1 ne signale pas leur absence.
doctor_paquets_rsyslog() {
    local texte p paquet
    command -v dpkg-query >/dev/null 2>&1 || return 0
    texte="$(grep -hv '^[[:space:]]*#' -- "$@" 2>/dev/null)"
    for p in gtls:rsyslog-gnutls omrelp:rsyslog-relp; do
        paquet="${p#*:}"
        case "$texte" in *"${p%%:*}"*) ;; *) continue ;; esac
        if [ "$(dpkg-query -W -f='${db:Status-Status}' "$paquet" 2>/dev/null)" = installed ]; then ok "centralisation : paquet $paquet"
        else warn "centralisation : paquet $paquet absent, la règle n'envoie rien (apt install $paquet, depuis le miroir interne)"; bad=$((bad+1)); fi
    done
}

cmd_doctor() {
    local bad=0 sortie
    charger_env
    NODE="$(node_bin)"
    # Contrôles : check LIBELLÉ CONSEIL COMMANDE [ARGUMENTS...] (la commande est un argv, jamais évaluée par un shell).
    check() { local lib="$1" conseil="$2"; shift 2; if "$@" >/dev/null 2>&1; then ok "$lib"; else warn "$lib : NON ($conseil)"; bad=$((bad+1)); fi; }
    # Facultatif : signalé, sans compter comme un problème.
    check_opt() { local lib="$1" conseil="$2"; shift 2; if "$@" >/dev/null 2>&1; then ok "$lib"; else info "$lib : absent ($conseil)"; fi; }
    check_out() { local lib="$1" conseil="$2"; shift 2; if sortie="$("$@" 2>&1)"; then ok "$lib : $sortie"; else warn "$lib : NON (${sortie:+$sortie ; }$conseil)"; bad=$((bad+1)); fi; }
    doctor_runtime() { [ "$(runtime_empreinte "$NODE_DIR")" = "$1" ]; }
    doctor_office() { (cd "$ROOT/office" && "$PY" -c 'import elpis_office.word, elpis_office.powerpoint, markdown_it'); }
    doctor_hote_empreinte() { ELPIS_RACINE="$ROOT" "$NODE" "$HOTE_DIST/main.mjs" --empreinte; }
    doctor_llm() { ELPIS_CFG_LLM_API_KEY="$4" "$1" "$ROOT/deploy/configure.py" --check-llm --engine "${2:-llamacpp}" --llm-url "$3"; }
    # Paquets apt d'un groupe : manquants = problème si le groupe sert ici, sinon simple information.
    check_apt() {
        local manquants=() l liste="" cmd
        mapfile -t manquants < <(prerequis_manquants "$1")
        if [ "${#manquants[@]}" -eq 0 ]; then ok "paquets apt ($1)"; return 0; fi
        for l in "${manquants[@]}"; do liste+="${liste:+, }$(prerequis_libelle "$l")"; done
        cmd="$(prerequis_commande "${manquants[@]}")"
        if apt_groupe_sert "$1"; then warn "paquets apt ($1) : NON (manquants : $liste ; $cmd)"; bad=$((bad+1))
        else info "paquets apt ($1, facultatif) : absents : $liste ($cmd)"; fi
    }
    if command -v dpkg-query >/dev/null 2>&1; then
        local groupe
        for groupe in $(prerequis_groupes); do
            if [ "$groupe" = socle ] || prerequis_os_connu; then check_apt "$groupe"
            else info "paquets apt ($groupe) : noms de Debian 12/13 et Ubuntu 24.04, non vérifiés sur ce système (deploy/prerequis-apt.txt)"; fi
        done
    else
        info "paquets apt : dpkg-query absent, prérequis non vérifiés (deploy/prerequis-apt.txt)"
    fi
    check "venv Python" "./install.sh" test -x "$PY"
    check "dépendances Python" "./install.sh" "$PY" -c 'import fastapi, httpx, uvicorn' 
    local v_runtime="NODE_RUNTIME_SHA256_$(uname -m)" runtime_attendu
    runtime_attendu="${!v_runtime:-absente}"
    if [ "$NODE" = "$NODE_DIR/bin/node" ]; then
        check "runtime Node.js livré (node/, sans npm, empreinte ${runtime_attendu:0:12})" \
            "./install.sh, ou ./install.sh --offline <paquet de cette version>" \
            doctor_runtime "$runtime_attendu"
    else
        info "runtime Node.js : $NODE (ELPIS_NODE ou PATH), empreinte non vérifiée"
    fi
    check "Node.js du core $("$NODE" -v 2>/dev/null || echo absent) ($NODE)" \
        "24.x, $NODE_MIN au moins : ./install.sh installe $NODE_VERSION dans node/" node_ok
    check "core construit (apps/core/dist/main.mjs)" "./install.sh, ou ./install.sh --offline <paquet de cette version>" test -f "$CORE_DIST/main.mjs"
    if [ -f "$CORE_DIST/exploitation.mjs" ]; then
        check_out "module natif du core" "./install.sh" core_cmd natif
        check_out "bundle du core" "./install.sh, ou ./install.sh --offline <paquet de cette version>" core_cmd empreinte
    fi
    # Hôte d'outils : construit, à jour des sources, node-pty (PTY du terminal) et better-sqlite3 chargés pour cette machine.
    check "hôte d'outils construit (apps/toolhost/dist/main.mjs)" "./install.sh, ou ./install.sh --offline <paquet de cette version>" test -f "$HOTE_DIST/main.mjs"
    if [ -f "$HOTE_DIST/main.mjs" ]; then
        check_out "bundle de l'hôte d'outils" "./install.sh, ou ./install.sh --offline <paquet de cette version>" \
            doctor_hote_empreinte
        check_out "modules natifs de l'hôte d'outils" "bundle incomplet ou d'une autre architecture : paquet hors ligne de cette architecture, ou construction sur place (build-essential, python3 : npm ci y compile node-pty)" \
            timeout 30 "$NODE" "$HOTE_DIST/main.mjs" --natif
    fi
    if [ -n "${SSL_CERT_FILE:-}${SSL_CERT_DIR:-}" ]; then
        check "autorités de confiance (${SSL_CERT_FILE:-SSL_CERT_DIR=$SSL_CERT_DIR})" \
            "fichier PEM, ou un seul dossier aux noms hachés (openssl rehash) : ./elpis configure --ca-file systeme|<fichier PEM>|aucun" ca_ok
    else
        info "autorités de confiance : magasins par défaut (core : Node et /etc/ssl/certs ; httpx : certifi) ; PKI interne : ./elpis configure --ca-file systeme"
    fi
    check "dépendances de l'extracteur du RAG" "venv/bin/pip install -r requirements-rag.txt" "$PY" -c 'import pdfplumber, pypdfium2, pypdf, openpyxl, docx, pptx' 
    check "moteur Office (worker de l'hôte d'outils)" "venv/bin/pip install -r requirements.txt" doctor_office
    if [ -L "$ROOT/config.json" ] && [ ! -f "$ROOT/config.json" ]; then
        warn "config.json : illisible pour ce compte ($(readlink -- "$ROOT/config.json") : groupe $GROUPE_DONNEES dans une nouvelle session, ou sudo ./elpis doctor)"; bad=$((bad+1))
    else
        check "config.json" "./elpis configure" test -f "$ROOT/config.json"
    fi
    check "mcp.json" "./elpis configure" test -f "$ROOT/mcp.json"
    check "jeton MCP" "./elpis configure" test -s "$ROOT/user_db/.local_mcp_token"
    if [ "$(mode_installe)" = separes ]; then
        check "jeton du service RAG ($JETON_RAG_SYS)" "sudo ./elpis service install" test -s "$JETON_RAG_SYS"
    else
        check "jeton du service RAG" "./elpis configure" test -s "$ROOT/user_db/.rag_service_token"
    fi
    local th_host="${LOCAL_MCP_HOST:-127.0.0.1}"; [ "$th_host" = 0.0.0.0 ] && th_host=127.0.0.1
    check "hôte d'outils ($th_host:$MCP_PORT)" "./elpis logs toolhost" curl --noproxy '*' -fsS -m 3 -o /dev/null "http://$th_host:$MCP_PORT/health"
    if [ -f "$HOTE_DIST/main.mjs" ]; then
        local natives
        natives="$(ELPIS_RACINE="$ROOT" timeout 30 "$NODE" "$HOTE_DIST/main.mjs" --familles-natives 2>/dev/null | tail -n 1)"
        info "hôte d'outils : familles servies ${natives:-aucune} (toolhost.json › families)"
        local th_conf="${TOOLHOST_CONFIG:-$ROOT/toolhost.json}"; case "$th_conf" in /*) ;; *) th_conf="$ROOT/$th_conf" ;; esac
        if [ -f "$th_conf" ] && grep -qE '"(familles_natives|mcp_upstream|mcp_upstream_sse)"[[:space:]]*:[[:space:]]*([^[:space:]"]|"[^"])' "$th_conf"; then
            warn "toolhost.json : familles_natives / mcp_upstream sont obsolètes (elpis-tools n'existe plus), ignorés : à retirer"
        fi
    fi
    check "outils du compte servis par main (mcp.json sans URL d'appmcp)" "./elpis configure" "$PY" "$ROOT/deploy/configure.py" --verifier-mcp
    check "familles d'outils de mcp.example.json présentes dans mcp.json" "./elpis configure" "$PY" "$ROOT/deploy/configure.py" --verifier-familles-mcp
    local retire
    for retire in ELPIS_TOOLHOST ELPIS_APPMCP ELPIS_CLI; do
        [ "${!retire:-}" = python ] && info "$retire=python : ignoré depuis la 0.1.0 (retour à la version Python : tag python-final, docs/operations.md), à retirer de .env"
    done
    check "Qdrant" "./install.sh" test -x "$ROOT/rag_app/qdrant/qdrant"
    check "service navigateur (monté dans la sandbox de chaque compte)" "./install.sh" test -d "$ROOT/browser-service/node_modules"
    if [ -d "$ROOT/browser-service/node_modules" ]; then
        check "service navigateur construit pour ces sources (browser-service/dist)" "deploy/node/installer.sh navigateur" \
            env ELPIS_RACINE="$ROOT" "$NODE" "$ROOT/browser-service/dist/empreinte.mjs"
    fi
    doctor_navigateur_bac
    # Contrôles faits par le core (exploitation.mjs) : signalés non vérifiés s'il n'est pas construit.
    local distants core_ok=0
    [ -f "$CORE_DIST/exploitation.mjs" ] && core_ok=1
    if [ "$core_ok" -eq 0 ]; then
        info "verrous de fichiers : non vérifiés (core non construit)"
    elif distants="$(core_cmd fs-local 2>/dev/null)"; then
        ok "verrous de fichiers : dossiers de données sur disque local"
    else
        warn "verrous de fichiers : NON (${distants:-vérification impossible} ; NFS/CIFS non pris en charge)"
        bad=$((bad+1))
    fi
    check "Docker joignable" "installer docker, groupe docker ; sans lui, ni sandbox ni navigateur" docker info
    local image
    image="$("$ROOT/deploy/docker/sandbox/build_offline.sh" --print-image 2>/dev/null)"
    check "image sandbox $image" "./install.sh ou deploy/docker/sandbox/build_offline.sh ; sans elle, ni sandbox ni navigateur" docker image inspect "$image"
    doctor_isolation_bac
    check "bubblewrap (analyses du RAG et aperçus Office isolés)" \
        "apt install bubblewrap ; user namespaces autorisés ; core construit requis" core_cmd bwrap
    check_opt "LibreOffice (aperçus Office, facultatif)" "paquets apt du groupe apercus-office : deploy/prerequis-apt.txt" command -v soffice
    if _https_enabled; then
        check "Caddy actif (HTTPS)" "./install.sh --with-caddy puis ./elpis configure" systemctl is-active --quiet caddy
    fi
    if [ -f /etc/systemd/system/elpis-whisper.service ]; then
        check "reconnaissance vocale (:8090)" "systemctl status elpis-whisper" curl --noproxy '*' -fsS -m 3 -o /dev/null http://127.0.0.1:8090/health
        check "synthèse vocale (:8091)" "systemctl status elpis-tts" curl --noproxy '*' -fsS -m 3 -o /dev/null http://127.0.0.1:8091/health
    fi
    if [ -f "$ROOT/config.json" ] && [ "$core_ok" -eq 1 ]; then
        local db_hint="./elpis db info pour le détail ; ./elpis db use sqlite en secours"
        if [ "$(core_cmd config base-retiree 2>/dev/null)" = oui ]; then
            db_hint="MariaDB/MySQL n'est plus pris en charge : docs/operations.md, « Upgrading »"
        fi
        check "base de données joignable" "$db_hint" core_cmd db info
        check_out "base vue par le core" "./elpis db info" core_cmd migrations
        local llm moteur cle py="$PY"
        [ -x "$py" ] || py=python3
        llm="$(core_cmd config LLAMA_URL 2>/dev/null)"
        if [ -n "$llm" ]; then
            moteur="$(core_cmd config LLAMA_ENGINE 2>/dev/null)"
            cle="$(core_cmd config LLAMA_API_KEY 2>/dev/null)"
            # Clé passée par l'environnement : jamais sur une ligne de commande (ps), jamais affichée.
            check_out "serveur LLM" "./elpis configure" doctor_llm "$py" "$moteur" "$llm" "$cle"
            local conseil
            while IFS= read -r conseil; do info "$conseil"; done \
                < <(ELPIS_CFG_LLM_API_KEY="$cle" "$py" "$ROOT/deploy/configure.py" --conseils-moteur --engine "${moteur:-llamacpp}" 2>/dev/null)
        fi
    fi
    if [ -f "$ROOT/config.json" ] && [ "$core_ok" -eq 1 ]; then
        # Extracteur, jeton et magasin partagés, Qdrant, embeddings, reclassement et OCR : vus par le core.
        lignes_doctor "RAG" env ELPIS_RACINE="$ROOT" timeout 120 "$NODE" --use-system-ca "$CORE_DIST/exploitation.mjs" rag
    else
        info "RAG : non vérifié (core non construit ou config.json absent)"
    fi
    doctor_comptes
    doctor_journaux
    doctor_coffre
    doctor_connexion
    sonde_du_core
    echo
    cmd_status
    [ "$bad" -eq 0 ] && ok "Aucun problème détecté." || warn "$bad point(s) à corriger."
    return "$bad"
}

# =============================================================================
#  backup / upgrade
# =============================================================================
# Sauvegarde par le core ; un compte par service : sous root seul (lui seul lit toutes les clés), archives de backups/ rendues ensuite à l'opérateur (0600).
cmd_backup() {
    local rc=0 op og
    charger_env
    charger_instance
    need_exploitation
    if [ "$(mode_installe)" != separes ]; then core_cmd backup "$@"; return; fi
    [ "$(id -u)" -eq 0 ] || die "Un compte par service : seul root lit toutes les clés à sauvegarder ; lancez sudo ./elpis backup${*:+ $*}"
    core_cmd backup "$@" || rc=$?
    op="${SUDO_USER:-}"; [ -n "$op" ] && [ "$op" != root ] || op="$(stat -c %U -- "$ROOT")"
    og="$(id -gn "$op")" || return 1
    if [ -d "$ROOT/backups" ]; then
        { dossier_sur "$ROOT/backups" 00700 "$op" "$og" && poser_droits arbre "$ROOT/backups" "$og" go-rwx go-rwxs --proprio "$op" --comptes root; } \
            || warn "Archives de backups/ non rendues à $op (voir ci-dessus)."
    fi
    return "$rc"
}

# Base de données : état, test d'une cible, copie, choix du moteur (« use sqlite » ne touche à aucune base).
cmd_db() {
    charger_env
    charger_instance
    need_exploitation
    core_cmd db "$@"
}

# Compte des services pour « audit setup » et « vault setup » (COMPTE_SETUP, MODE_COMPTES des unités) : mode séparé, l'écrivain du journal ${UNIT_PREFIX}-main ; sinon User= des unités, ELPIS_USER, SUDO_USER ; jamais root ; root exigé hors arborescence factice.
compte_setup() {
    local quoi="$1" unite
    MODE_COMPTES="$(mode_installe)"
    if [ "$MODE_COMPTES" = separes ]; then
        unite="$UNIT_PREFIX-main"
    else
        unite="$(compte_services)"
        if [ -n "$unite" ] && [ -n "${ELPIS_USER:-}" ] && [ "$ELPIS_USER" != "$unite" ]; then
            die "Les services tournent sous $unite (User= des unités systemd), pas sous ELPIS_USER=$ELPIS_USER : sudo ELPIS_USER=$ELPIS_USER ./elpis service install pour changer de compte."
        fi
    fi
    COMPTE_SETUP="${unite:-${ELPIS_USER:-${SUDO_USER:-}}}"
    if [ -z "$SYS_PREFIXE" ]; then
        [ "$(id -u)" -eq 0 ] || die "Lancez avec sudo : sudo ./elpis $quoi setup"
    else
        COMPTE_SETUP="${COMPTE_SETUP:-$(id -un)}"
    fi
    [ -n "$COMPTE_SETUP" ] && [ "$COMPTE_SETUP" != root ] \
        || die "Utilisateur de service inconnu : lancez via sudo depuis votre compte, ou ELPIS_USER=nom."
    id -u "$COMPTE_SETUP" >/dev/null 2>&1 || die "Compte de service $COMPTE_SETUP inexistant (ELPIS_USER=nom)."
    if [ "$MODE_COMPTES" = separes ]; then info "Comptes des services : un par service (unités systemd installées)."
    elif [ -n "$unite" ] && [ "$unite" != "${SUDO_USER:-}" ]; then info "Compte des services : $unite (unités systemd installées)."; fi
}

# Journal de sécurité : mise en place (setup, root) ou vérification des signatures et de la continuité (verify).
cmd_audit() {
    if [ "${1:-}" = "setup" ]; then
        compte_setup audit
        audit_setup "$COMPTE_SETUP" "" 1 || die "Journal de sécurité incomplet : voir ci-dessus, puis relancez sudo ./elpis audit setup."
        if [ "$MODE_COMPTES" = separes ]; then ok "Journal de sécurité en place (un compte par service)."; else ok "Journal de sécurité en place (compte $COMPTE_SETUP)."; fi
        return 0
    fi
    charger_env
    charger_instance
    need_exploitation
    core_cmd audit "$@"
}

# Coffre « Secrets » : clé (setup en root ; status ; rekey, ancienne clé relative au dossier d'Elpis, rendue absolue) ; doctor sert ./elpis doctor.
cmd_vault() {
    local f
    case "${1:-}" in
        setup)
            [ $# -eq 1 ] || die "Usage : sudo ./elpis vault setup"
            vault_setup ;;
        status|rekey|doctor)
            charger_env
            charger_instance
            need_exploitation
            if [ "$1" = rekey ] && [ "${2:-}" = --from ] && [ -n "${3:-}" ]; then
                f="$3"; case "$f" in /*) ;; *) f="$ROOT/$f" ;; esac
                set -- rekey --from "$f" "${@:4}"
            fi
            vault_core vault "$@" ;;
        *) die "Usage : sudo ./elpis vault setup | ./elpis vault status | ./elpis vault rekey --from FICHIER" ;;
    esac
}

# Secrets du coffre : métadonnées seules (jamais de valeur).
cmd_secret() {
    [ "${1:-}" = ls ] || die "Usage : ./elpis secret ls [--user COMPTE]"
    charger_env
    charger_instance
    need_exploitation
    vault_core secret "$@"
}

# SSO OpenID Connect : état et coupure de secours des fournisseurs d'identité (config.json relu à chaud, rien à redémarrer).
cmd_auth() {
    case "${1:-}" in
        status|doctor|off) [ $# -eq 1 ] || die "Usage : ./elpis auth status | ./elpis auth doctor | ./elpis auth off | ./elpis auth reactivate <compte>" ;;
        reactivate) [ $# -eq 2 ] || die "Usage : ./elpis auth status | ./elpis auth doctor | ./elpis auth off | ./elpis auth reactivate <compte>" ;;
        *) die "Usage : ./elpis auth status | ./elpis auth doctor | ./elpis auth off | ./elpis auth reactivate <compte>" ;;
    esac
    charger_env
    charger_instance
    need_exploitation
    vault_core auth "$@"
}

# Commande du coffre par le core : sous le compte des services quand root la lance (la console en mode séparé ; runuser, ses groupes compris : clé lisible, fichiers de la base jamais créés par root), telle quelle sinon.
vault_core() {
    local compte groupe=""
    if [ "$(id -u)" -ne 0 ]; then core_cmd "$@"; return; fi
    if [ "$(mode_installe)" = separes ]; then
        compte="$UNIT_PREFIX-admin"; groupe="ELPIS_GROUPE_DONNEES=$GROUPE_DONNEES"
    else
        compte="$(compte_services)"
        compte="${compte:-${ELPIS_USER:-${SUDO_USER:-}}}"
    fi
    [ -n "$compte" ] && [ "$compte" != root ] \
        || die "Compte des services inconnu : relancez sans sudo sous ce compte, ou ELPIS_USER=nom."
    (cd / && runuser -u "$compte" -- env "ELPIS_RACINE=$ROOT" ${SANDBOX_DIR:+"APP_SANDBOX_DIR=$SANDBOX_DIR"} ${groupe:+"$groupe"} \
        "$NODE" "$CORE_DIST/exploitation.mjs" "$@")
}

# Comptes des unités installées (User= de chaque service, sans doublon, séparés par une espace) ; vide sans unité.
compte_services() {
    local s f u liste=" "
    for s in main admin toolhost rag qdrant; do
        f="$SYS_PREFIXE/etc/systemd/system/${UNIT_PREFIX}-$s.service"
        [ -f "$f" ] || continue
        u=""
        if [ -z "$SYS_PREFIXE" ] && command -v systemctl >/dev/null 2>&1; then
            u="$(systemctl show -p User --value "${UNIT_PREFIX}-$s.service" 2>/dev/null)"
        fi
        [ -n "$u" ] || u="$(sed -n 's/^User=//p' "$f" | tail -n 1)"
        [ -z "$u" ] || case "$liste" in *" $u "*) ;; *) liste+="$u " ;; esac
    done
    liste="${liste# }"; printf '%s\n' "${liste% }"
}

# Mode des comptes des unités installées (ELPIS_COMPTES de main, admin ou toolhost) : separes, unique, repli, ancien (unités d'avant ce réglage) ; vide sans unité.
mode_installe() {
    local s f m
    for s in main admin toolhost; do
        f="$SYS_PREFIXE/etc/systemd/system/${UNIT_PREFIX}-$s.service"
        [ -f "$f" ] || continue
        m="$(sed -n 's/^Environment="ELPIS_COMPTES=\([a-z]*\)"$/\1/p' "$f" | tail -n 1)"
        echo "${m:-ancien}"
        return 0
    done
}

# Compte unique des unités installées (mode unique, repli ou unités d'avant les comptes séparés) ; vide en mode séparé ou sans unité.
compte_unique() { [ "$(mode_installe)" = separes ] || compte_services; }

# Groupe propre aux comptes donnés (liste séparée par des espaces) : groupe local dont chaque membre est l'un d'eux, groupe primaire d'aucun autre compte.
groupe_propre() {
    local g="$1" admis=" $2 " gid m
    gid="$(awk -F: -v g="$g" '$1 == g { print $3; exit }' "$SYS_PREFIXE/etc/group" 2>/dev/null)"
    [ -n "$gid" ] || return 1
    for m in $(getent group "$g" | cut -d: -f4 | tr ',' ' '); do
        case "$admis" in *" $m "*) ;; *) return 1 ;; esac
    done
    getent passwd | awk -F: -v g="$gid" -v a="$admis" '$4 == g && index(a, " " $1 " ") == 0 { e = 1 } END { exit e }'
}

# Membres de GROUPE ramenés aux comptes donnés (gpasswd -M), seulement s'ils diffèrent.
membres_exacts() {
    local g="$1" voulu actuel; shift
    voulu="$(printf '%s\n' "$@" | sort | paste -sd,)"
    actuel="$(getent group "$g" | cut -d: -f4 | tr ',' '\n' | sed '/^$/d' | sort | paste -sd,)"
    [ "$voulu" = "$actuel" ] || gpasswd -M "$voulu" "$g" >/dev/null
}

# COMPTE ajouté au GROUPE s'il n'en est pas membre (pris par ses processus à leur prochaine session ou à leur redémarrage).
membre() {
    id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qxF -- "$2" && return 0
    usermod -aG "$2" "$1" && info "$1 ajouté au groupe $2."
}

# Groupe de la clé dans GRP_CLE : groupe primaire du compte s'il lui est propre, sinon GROUPE_CLE (créé au besoin) avec ce compte pour seul membre.
groupe_de_cle() {
    local compte="$1"
    GRP_CLE="$(id -gn "$compte")" || return 1
    if [ "$(id -u)" -ne 0 ] || groupe_propre "$GRP_CLE" "$compte"; then return 0; fi
    GRP_CLE="$GROUPE_CLE"
    if ! getent group "$GRP_CLE" >/dev/null; then
        groupadd --system "$GRP_CLE" || return 1
        info "Groupe $GRP_CLE créé : lecture de la clé de signature par $compte seul."
    fi
    if ! id -nG "$compte" | tr ' ' '\n' | grep -qx "$GRP_CLE"; then
        info "$compte ajouté au groupe $GRP_CLE : pris par les services systemd à leur redémarrage, par ./elpis start dans une nouvelle session."
    fi
    membres_exacts "$GRP_CLE" "$compte" || return 1
    groupe_propre "$GRP_CLE" "$compte" || { warn "Groupe $GRP_CLE : groupe primaire d'un autre compte, clé non confiée."; return 1; }
}

# Dossier système posé sans suivre de lien : créé s'il manque, refusé si c'est un lien, un fichier, le bien d'un autre compte ou (parent inscriptible par d'autres) un dossier de root non vide à céder ; droits posés sur « . » une fois dedans.
dossier_sur() {
    local d="$1" mode="$2" proprio="$3" groupe="$4" admis=" root $3 ${5:-} " attendu parent
    [ "$(id -u)" -eq 0 ] || admis+="$(id -un) "
    if [ ! -e "$d" ] && [ ! -L "$d" ]; then
        mkdir -m "$mode" -- "$d" || return 1
        info "Dossier $d créé."
    fi
    parent="$(cd -P -- "$(dirname -- "$d")" && pwd -P)" || return 1
    attendu="$parent/${d##*/}"
    (
        { [ ! -L "$d" ] && cd -P -- "$d" 2>/dev/null && [ "$(pwd -P)" = "$attendu" ]; } \
            || { warn "$d : lien symbolique, fichier ou dossier déplacé : refusé (à vérifier)."; exit 1; }
        p="$(stat -c %U .)"
        case "$admis" in
            *" $p "*) ;;
            *) warn "$d appartient à $p, pas à $proprio : refusé (services sous $p : ELPIS_USER=$p ; passage à $proprio : sudo ELPIS_USER=$proprio ./elpis service install)."; exit 1 ;;
        esac
        if [ "$p" = root ] && [ "$proprio" != root ] && [ -n "$(ls -A .)" ] \
                && [ $(( 8#$(stat -c %a -- "$parent") & 8#022 )) -ne 0 ]; then
            warn "$d : dossier de root non vide à céder à $proprio : refusé (à vérifier)."; exit 1
        fi
        if [ "$(id -u)" -eq 0 ]; then chown -h "$proprio:$groupe" . || exit 1; fi
        chmod "$mode" .
    )
}

# Clé de signature : fichier ordinaire, jamais un lien, créée si absente ou vide (jamais remplacée sinon), puis 0440 root:GRP_CLE à chaque passage.
cle_audit() {
    local cle="$AUDIT_KEY_SYS"
    if [ -L "$cle" ] || { [ -e "$cle" ] && [ ! -f "$cle" ]; }; then
        warn "$cle : lien symbolique ou fichier spécial : refusé (à vérifier)."; return 1
    fi
    if [ ! -s "$cle" ]; then
        ( umask 0337 && od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > "$cle" ) || return 1
        info "Clé de signature du journal de sécurité créée : $cle (à sauvegarder hors de la machine)."
    fi
    cle_regroupee "$cle" "$GRP_CLE"
}

# Clé en place (audit, coffre) remise à 0440 root:GROUPE (propriétaire et groupe sous root seulement) : fichier ordinaire, jamais un lien ; rien sans clé ni groupe.
cle_regroupee() {
    [ -n "$2" ] && [ -f "$1" ] && [ ! -L "$1" ] || return 0
    if [ "$(id -u)" -eq 0 ]; then chown -h "root:$2" -- "$1" || return 1; fi
    chmod 0440 -- "$1"
}

# Commande lancée sous le compte des services quand root l'exécute (runuser, depuis /), telle quelle sinon.
en_compte() {
    local u="$1"; shift
    if [ "$(id -u)" -eq 0 ]; then (cd / && runuser -u "$u" -- "$@"); else "$@"; fi
}

# Vrai si main, admin ou l'hôte d'outils tourne (unité active ou lancement à la main) : ils gardent leur dossier d'audit jusqu'à l'arrêt.
ecrivains_en_marche() {
    local s
    for s in main admin toolhost; do
        pid_of "$s" >/dev/null && return 0
        if [ -z "$SYS_PREFIXE" ] && command -v systemctl >/dev/null 2>&1 \
                && systemctl is-active --quiet "${UNIT_PREFIX}-$s.service" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

# Fichiers des journaux (audit, app.log.jsonl et ses rotations) rendus au compte par root (chown -h, fichiers ordinaires à un seul lien, dossier à ce compte, lu après cd -P), puis mis en 0640 sous ce compte ; mode séparé : groupe des journaux et 0660 (les trois écrivains ajoutent au même fichier), posés par descripteur.
audit_droits_fichiers() {
    local compte="$1" d echec=0
    if [ "${MODE_COMPTES:-}" = separes ]; then
        poser_droits fichiers "$AUDIT_DIR_SYS" - "$GROUPE_JOURNAL" 0660 'audit-*.jsonl' || echec=1
        poser_droits fichiers "$APPLOG_DIR_SYS" - "$GROUPE_JOURNAL" 0660 'app.log.jsonl*' || echec=1
        return "$echec"
    fi
    if [ "$(id -u)" -eq 0 ]; then
        for d in "$AUDIT_DIR_SYS|audit-*.jsonl" "$APPLOG_DIR_SYS|app.log.jsonl*"; do
            (
                motif="${d#*|}"; d="${d%%|*}"; e=0
                { [ ! -L "$d" ] && cd -P -- "$d" 2>/dev/null && [ "$(stat -c %U .)" = "$compte" ]; } || exit 0
                for f in $motif; do
                    [[ -f $f && ! -L $f ]] || continue
                    [ "$(stat -c '%U:%G' -- "$f")" != "$compte:$GROUPE_JOURNAL" ] || continue
                    if [ "$(stat -c %h -- "$f")" -ne 1 ]; then warn "$d/$f : plusieurs liens physiques, laissé tel quel (à vérifier)."; e=1; continue; fi
                    chown -h "$compte:$GROUPE_JOURNAL" -- "$f" || e=1
                done
                exit "$e"
            ) || echec=1
        done
    fi
    en_compte "$compte" find "$AUDIT_DIR_SYS" -maxdepth 1 -type f -name 'audit-*.jsonl' ! -perm 0640 -exec chmod 0640 {} + || echec=1
    if [ -d "$APPLOG_DIR_SYS" ]; then
        en_compte "$compte" find "$APPLOG_DIR_SYS" -maxdepth 1 -type f -name 'app.log.jsonl*' ! -perm 0640 -exec chmod 0640 {} + || echec=1
    fi
    return "$echec"
}

# Fichiers de logs/audit déplacés sous le compte des services (jamais par root), ou ajoutés au fichier du même jour s'il existe (seq par boot : l'ordre n'importe pas) ; écrivains en marche : ceux du jour et de la veille restent.
audit_deplacer() {
    local compte="$1" f nom jour hier="" deplaces=0 fusionnes=0 gardes=0 recents=0 echec=0
    [[ -d $AUDIT_DIR_SYS && ! -L $AUDIT_DIR_SYS ]] || { warn "$AUDIT_DIR_SYS absent : rien n'est déplacé."; return 1; }
    ecrivains_en_marche && hier="$(date -u -d yesterday +%F)"
    for f in "$ROOT"/logs/audit/audit-*.jsonl; do
        [[ -e $f || -L $f ]] || continue
        if [[ -L $f || ! -f $f ]]; then warn "$f : lien symbolique ou fichier spécial, laissé (à vérifier)."; continue; fi
        nom="${f##*/}"; jour="${nom#audit-}"; jour="${jour%.jsonl}"
        if [ -n "$hier" ] && ! [[ "$jour" < "$hier" ]]; then recents=$((recents + 1)); continue; fi
        if [ -e "$AUDIT_DIR_SYS/$nom" ] || [ -L "$AUDIT_DIR_SYS/$nom" ]; then
            if [[ -L $AUDIT_DIR_SYS/$nom || ! -f $AUDIT_DIR_SYS/$nom || $f -ef $AUDIT_DIR_SYS/$nom ]]; then gardes=$((gardes + 1)); continue; fi
            en_compte "$compte" sh -c '[ -r "$1" ] && [ -w "${1%/*}" ] && [ -w "$2" ] || exit 3
                [ -n "$(tail -c 1 -- "$2")" ] && printf "\n" >> "$2"; cat -- "$1" >> "$2" || exit 1; rm -f -- "$1" || exit 2' fusion "$f" "$AUDIT_DIR_SYS/$nom"
            case $? in
                0) fusionnes=$((fusionnes + 1)) ;;
                3) warn "$f : illisible ou non supprimable par $compte, ou $AUDIT_DIR_SYS/$nom non inscriptible : laissé (à vérifier)."; echec=1 ;;
                2) warn "$f : ajouté à $AUDIT_DIR_SYS/$nom mais non supprimé : à retirer à la main (une relance doublerait ses lignes)."; echec=1 ;;
                *) warn "$f : ajout à $AUDIT_DIR_SYS/$nom interrompu, fichier gardé (à vérifier : une relance doublerait les lignes déjà ajoutées)."; echec=1 ;;
            esac
            continue
        fi
        en_compte "$compte" mv -n -- "$f" "$AUDIT_DIR_SYS/$nom"
        if [ -e "$f" ]; then warn "$f non déplacé."; echec=1; else deplaces=$((deplaces + 1)); fi
    done
    [ "$deplaces" -gt 0 ] && info "$deplaces fichier(s) d'audit déplacé(s) de logs/audit vers $AUDIT_DIR_SYS."
    [ "$fusionnes" -gt 0 ] && info "$fusionnes fichier(s) d'audit de logs/audit ajouté(s) au fichier du même jour de $AUDIT_DIR_SYS."
    [ "$gardes" -gt 0 ] && warn "$gardes fichier(s) laissé(s) dans logs/audit : le fichier du même jour de $AUDIT_DIR_SYS est un lien, un fichier spécial ou le même fichier (à vérifier)."
    [ "$recents" -gt 0 ] && warn "$recents fichier(s) du jour et de la veille laissé(s) dans logs/audit : les services y écrivent encore ; relancez sudo ./elpis audit setup une fois arrêtés (./elpis stop, ou systemctl stop ${UNIT_PREFIX}.target)."
    audit_droits_fichiers "$compte" || echec=1
    return "$echec"
}

# Contrôle final : mode des dossiers et de la clé, propriétaire et groupe sous root, clé d'au moins 32 octets ; liste les écarts.
audit_controle() {
    local c chemin attendu vu echec=0 journaux="2750 $1" etc="750 root ${GRP_CLE:-?}"
    [ "${MODE_COMPTES:-}" != separes ] || { journaux="2770 root"; etc="751 root root"; }
    for c in "$SYS_PREFIXE/var/lib/elpis|755 root root" "$AUDIT_DIR_SYS|$journaux $GROUPE_JOURNAL" \
             "$APPLOG_DIR_SYS|$journaux $GROUPE_JOURNAL" "$SYS_PREFIXE/etc/elpis|$etc" "$AUDIT_KEY_SYS|440 root ${GRP_CLE:-?}"; do
        chemin="${c%%|*}"; attendu="${c#*|}"
        vu="$(stat -c '%a %U %G' -- "$chemin" 2>/dev/null)" || vu="absent"
        if [ "$(id -u)" -ne 0 ]; then attendu="${attendu%% *}"; vu="${vu%% *}"; fi
        [ "$vu" = "$attendu" ] || { warn "$chemin : $vu (attendu $attendu)."; echec=1; }
    done
    if [ ! -f "$AUDIT_KEY_SYS" ] || [ -L "$AUDIT_KEY_SYS" ] || [ "$(tr -d ' \t\r\n' < "$AUDIT_KEY_SYS" | wc -c)" -lt 32 ]; then
        warn "Clé $AUDIT_KEY_SYS absente, illisible ou trop courte (32 octets au moins)."; echec=1
    fi
    return "$echec"
}

# Journal de sécurité hors du dépôt (AUDIT_SETUP COMPTE [ANCIENS_COMPTES] [DÉPLACER]) : groupes, dossiers 2750 au compte (mode séparé : 2770 à root, COMPTE n'y fait que déplacer), clé, droits réappliqués, logs/audit déplacé si DÉPLACER=1, contrôle final ; non nul au moindre échec.
audit_setup() {
    local compte="$1" ancien="${2:-}" deplacer="${3:-1}" nouveau=0 echec=0 dossiers=0 d mode=2750 proprio="$1"
    [ "${MODE_COMPTES:-}" != separes ] || { mode=2770; proprio=root; }
    if [ "$(id -u)" -eq 0 ]; then
        if ! getent group "$GROUPE_JOURNAL" >/dev/null; then
            if groupadd --system "$GROUPE_JOURNAL"; then info "Groupe $GROUPE_JOURNAL créé (lecture des journaux par rsyslog)."; else echec=1; fi
        fi
        if id syslog >/dev/null 2>&1 && ! id -nG syslog | tr ' ' '\n' | grep -qx "$GROUPE_JOURNAL"; then
            if usermod -aG "$GROUPE_JOURNAL" syslog; then nouveau=1; else echec=1; fi
        fi
    fi
    [ -z "$SYS_PREFIXE" ] || mkdir -p "$SYS_PREFIXE/var/lib" "$SYS_PREFIXE/var/log" "$SYS_PREFIXE/etc" || echec=1
    if dossier_sur "$SYS_PREFIXE/var/lib/elpis" 0755 root root; then
        for d in "$AUDIT_DIR_SYS" "$APPLOG_DIR_SYS"; do
            if dossier_sur "$d" "$mode" "$proprio" "$GROUPE_JOURNAL" "$ancien"; then dossiers=$((dossiers + 1)); else echec=1; fi
        done
    else
        echec=1
    fi
    if [ "${MODE_COMPTES:-}" = separes ]; then
        GRP_CLE="$GROUPE_JOURNAL"
        if dossier_sur "$SYS_PREFIXE/etc/elpis" 0751 root root; then cle_audit || echec=1; else echec=1; fi
    elif groupe_de_cle "$compte" && dossier_sur "$SYS_PREFIXE/etc/elpis" 0750 root "$GRP_CLE"; then cle_audit || echec=1; else echec=1; fi
    if [ "$dossiers" -eq 2 ]; then
        if [ "$deplacer" = 1 ]; then audit_deplacer "$compte" || echec=1; else audit_droits_fichiers "$compte" || echec=1; fi
    fi
    if [ "$nouveau" -eq 1 ] && command -v systemctl >/dev/null 2>&1; then systemctl try-restart rsyslog >/dev/null 2>&1 || true; fi
    audit_controle "$compte" || echec=1
    return "$echec"
}

# Clé du coffre : fichier ordinaire, jamais un lien ; 32 octets aléatoires en base64, créée si absente ou vide, jamais remplacée ; validée par le cœur (vault check-key, même règle que les services) ; 0440 root:GRP_CLE à chaque passage.
cle_coffre() {
    local cle="$VAULT_KEY_SYS" verdict
    if [ -L "$cle" ] || { [ -e "$cle" ] && [ ! -f "$cle" ]; }; then
        warn "$cle : lien symbolique ou fichier spécial : refusé (à vérifier)."; return 1
    fi
    if [ -s "$cle" ]; then
        verdict="$(core_cmd vault check-key < "$cle" 2>&1)" \
            || { warn "$cle : ${verdict:-clé refusée par le cœur} : laissée intacte, à vérifier."; return 1; }
        info "Clé du coffre déjà en place, gardée : $cle ($verdict, jamais remplacée)."
    else
        ( umask 0337 && head -c 32 /dev/urandom | base64 > "$cle" ) || return 1
        verdict="$(core_cmd vault check-key < "$cle" 2>&1)" \
            || { rm -f -- "$cle"; warn "Clé du coffre générée refusée (${verdict:-?}) : relancez sudo ./elpis vault setup."; return 1; }
        info "Clé du coffre créée : $cle ($verdict ; à sauvegarder hors de la machine, à part des sauvegardes d'Elpis)."
    fi
    cle_regroupee "$cle" "$GRP_CLE"
}

# Clé du coffre hors de la base (vault setup) : groupe de la clé, dossier /etc/elpis 0750 (mode séparé : 0751, clé à main et à la console), clé 0440 ; contrôle final, conseils pour la clé de repli.
vault_setup() {
    local vu attendu
    compte_setup vault
    NODE="$(node_bin)"
    need_exploitation
    [ -z "$SYS_PREFIXE" ] || mkdir -p "$SYS_PREFIXE/etc" || die "Arborescence $SYS_PREFIXE/etc impossible à créer."
    if [ "$MODE_COMPTES" = separes ]; then
        GRP_CLE="$GROUPE_CLE"
        dossier_sur "$SYS_PREFIXE/etc/elpis" 0751 root root || die "Dossier $SYS_PREFIXE/etc/elpis refusé (voir ci-dessus)."
    else
        groupe_de_cle "$COMPTE_SETUP" || die "Groupe de la clé non préparé (voir ci-dessus)."
        dossier_sur "$SYS_PREFIXE/etc/elpis" 0750 root "$GRP_CLE" || die "Dossier $SYS_PREFIXE/etc/elpis refusé (voir ci-dessus)."
    fi
    cle_coffre || die "Clé du coffre non posée : voir ci-dessus, puis relancez sudo ./elpis vault setup."
    attendu="440 root $GRP_CLE"
    vu="$(stat -c '%a %U %G' -- "$VAULT_KEY_SYS" 2>/dev/null)" || vu="absent"
    if [ "$(id -u)" -ne 0 ]; then attendu="${attendu%% *}"; vu="${vu%% *}"; fi
    [ "$vu" = "$attendu" ] || die "$VAULT_KEY_SYS : $vu (attendu $attendu)."
    ok "Clé du coffre en place : $VAULT_KEY_SYS ($([ "$MODE_COMPTES" = separes ] && echo "main et la console" || echo "compte $COMPTE_SETUP"), groupe $GRP_CLE)."
    info "Les services la lisent au démarrage : sudo systemctl restart ${UNIT_PREFIX}.target (ou ./elpis restart)."
    if [ -e "$ROOT/user_db/.vault.key" ]; then
        info "Clé de repli trouvée (user_db/.vault.key) : après le redémarrage, ./elpis vault rekey --from user_db/.vault.key, puis supprimez-la."
    fi
}

# Image de la sandbox attendue par le code : présente, sinon chargée depuis
# son archive (deploy/docker/sandbox/elpis-sandbox-<version>.tar.gz), sinon
# construite (réseau requis). Sans elle, les conteneurs existants gardent
# leur ancienne image, sans agent : fichiers, éditeur et git inutilisables.
ensure_sandbox_image() {
    command -v docker >/dev/null 2>&1 || { warn "docker absent : image de sandbox non vérifiée."; return 0; }
    local dir="$ROOT/deploy/docker/sandbox" img arch
    img="$(bash "$dir/build_offline.sh" --print-image 2>/dev/null)" || return 0
    if docker image inspect "$img" >/dev/null 2>&1; then
        ok "Image de sandbox $img présente."
        return 0
    fi
    arch="$dir/elpis-sandbox-${img##*:}.tar.gz"
    if [ -f "$arch" ]; then
        info "Image de sandbox $img : chargement de $(basename "$arch")…"
        bash "$dir/load_image.sh" "$arch" && return 0
    fi
    info "Image de sandbox $img absente : construction (réseau requis, plusieurs minutes)…"
    bash "$dir/build_offline.sh" && return 0
    return 1
}

cmd_upgrade() {
    local backup=1 req="$ROOT/requirements-rag.txt"
    case "${1:-}" in --no-backup) backup=0 ;; "") ;; *) die "Usage : ./elpis upgrade [--no-backup]" ;; esac
    load_runtime
    git -C "$ROOT" diff --quiet HEAD -- \
        || die "Modifications locales dans le dépôt (git status) : mise à jour annulée."
    if [ "$backup" -eq 1 ]; then
        info "Sauvegarde complète…"
        local rc=0
        # Un compte par service : la sauvegarde passe par root (sudo), le reste de la mise à jour reste à l'opérateur.
        if [ "$(mode_installe)" = separes ] && [ "$(id -u)" -ne 0 ]; then sudo "$ROOT/elpis" backup full || rc=$?; else cmd_backup full || rc=$?; fi
        # 3 : sauvegarde faite, mais sans le /work d'au moins un compte
        # (sandbox illisible) : la base y est, la mise à jour continue.
        if [ "$rc" -eq 3 ]; then
            warn "Sauvegarde incomplète (/work d'au moins un compte) : la mise à jour continue."
        elif [ "$rc" -ne 0 ]; then
            die "Sauvegarde échouée : mise à jour annulée (--no-backup pour passer outre)."
        fi
    fi
    local before; before="$(git -C "$ROOT" rev-parse --short HEAD)"
    info "Code (git pull --ff-only)…"
    git -C "$ROOT" pull --ff-only || die "git pull --ff-only a échoué : rien n'a été modifié."
    . "$ROOT/deploy/node/node.env"
    info "Code : $before → $(git -C "$ROOT" rev-parse --short HEAD)"
    # Extras AGPL déjà installés : ils restent à jour.
    "$PY" -c 'import fitz' >/dev/null 2>&1 && req="$ROOT/requirements-agpl-optional.txt"
    info "Dépendances Python…"
    "$PY" -m pip install -q -r "$req" || die "Échec pip : relancez ./elpis upgrade --no-backup une fois corrigé."
    info "Node.js, core et hôte d'outils…"
    # Archive officielle de Node.js téléchargée une fois pour le runtime et le npm de la construction (dossier global, supprimé à la sortie).
    CACHE_NODE="$(mktemp -d "$ROOT/.node-cache.XXXXXX")"
    trap 'rm -rf "$CACHE_NODE"' EXIT
    if [ -z "${ELPIS_NODE:-}" ]; then
        ELPIS_NODE_CACHE="$CACHE_NODE" "$ROOT/deploy/node/installer.sh" node \
            || die "Node.js du core non installé : relancez ./elpis upgrade --no-backup une fois corrigé."
        NODE="$(node_bin)"
    fi
    node_ok || die "Node.js du core absent ou trop ancien (24.x, $NODE_MIN au moins) : voir ELPIS_NODE."
    ELPIS_NODE_CACHE="$CACHE_NODE" "$ROOT/deploy/node/installer.sh" bundles \
        || die "Construction du core ou de l'hôte d'outils échouée : l'ancien bundle reste en place ; relancez ./elpis upgrade --no-backup une fois corrigé."
    ELPIS_NODE_CACHE="$CACHE_NODE" "$ROOT/deploy/node/installer.sh" web \
        || die "Construction du frontend échouée : relancez ./elpis upgrade --no-backup une fois corrigé."
    if [ -d "$ROOT/browser-service/node_modules" ]; then
        ELPIS_NODE_CACHE="$CACHE_NODE" "$ROOT/deploy/node/installer.sh" navigateur \
            || die "Construction du service navigateur échouée : l'ancien bundle reste en place ; relancez ./elpis upgrade --no-backup une fois corrigé."
    fi
    info "Image de la sandbox…"
    ensure_sandbox_image || die "Image de sandbox indisponible : chargez son archive \
(deploy/docker/sandbox/load_image.sh <archive>) ou construisez-la (./install.sh --sandbox build), \
puis ./elpis restart. Sans elle, fichiers, éditeur et git des sandboxes ne marchent pas."
    migrer_mcp
    info "Redémarrage (les migrations de la base s'appliquent au démarrage)…"
    if systemd_installed; then
        info "Unités systemd inchangées : sudo ./elpis service install quand le CHANGELOG le demande."
        sudo systemctl restart "${UNIT_PREFIX}.target" || die "Redémarrage systemd échoué."
        { wait_port "$MAIN_PORT" 120 && wait_port "$ADMIN_PORT" 60; } \
            || die "L'application ne répond pas après la mise à jour : ./elpis logs main"
    else
        cmd_stop
        cmd_start || die "L'application ne répond pas après la mise à jour (voir ci-dessus) : ./elpis logs main"
    fi
    local base
    base="$(core_cmd migrations 2>/dev/null)" || die "Base après la mise à jour : ${base:-injoignable} (./elpis db info, ./elpis logs main)"
    case "$base" in
        "à jour"*) ok "Base : $base" ;;
        *) die "Migrations non appliquées après le redémarrage : $base (./elpis logs main)" ;;
    esac
    ok "Mise à jour appliquée ; diagnostic :"
    cmd_doctor || true
}

# =============================================================================
case "${1:-}" in
    configure) shift; cmd_configure "$@" ;;
    start)     shift; cmd_start "$@" ;;
    stop)      cmd_stop ;;
    restart)   load_runtime; need_core; cmd_migrations; cmd_stop; cmd_start ;;
    status)    cmd_status ;;
    logs)      shift; cmd_logs "$@" ;;
    service)   shift; cmd_service "$@" ;;
    doctor)    cmd_doctor ;;
    backup)    shift; cmd_backup "$@" ;;
    upgrade)   shift; cmd_upgrade "$@" ;;
    db)        shift; cmd_db "$@" ;;
    audit)     shift; cmd_audit "$@" ;;
    vault)     shift; cmd_vault "$@" ;;
    secret)    shift; cmd_secret "$@" ;;
    auth)      shift; cmd_auth "$@" ;;
    -h|--help|help|"") usage ;;
    *) usage; exit 2 ;;
esac
