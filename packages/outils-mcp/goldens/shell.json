    {
      "name": "execute_shell",
      "title": "Execute Shell",
      "description": "Execute an arbitrary shell command inside your sandbox container.\n\nThe command is passed verbatim to ``bash -c`` \u2014 all shell features are\navailable: pipes, redirections, heredocs, ``$VAR``, ``$(...)``, backticks,\n``for``/``if``/``&&``/``||``. Quotes and special characters need NO extra\nescaping beyond normal shell syntax.\n\n``ok:false`` with a ``returncode`` means YOUR COMMAND exited non-zero (the\ntool itself worked) \u2014 read stdout/stderr and fix the command, do not retry\nit unchanged.\n\nIMPORTANT: this tool is for terminal operations (git, builds, tests, package\nmanagers, processes). Do NOT use it for file operations \u2014 use the dedicated\ntools instead: read_file (not cat/head/tail), edit_file (not sed -i),\nwrite_file (not echo >), list_files (not find/grep -r). They are cheaper,\nsafer and their output is formatted for you.\n\nIf the output is truncated, the FULL output is saved automatically to a\nsandbox file (``saved_to`` in the result) \u2014 read it with\n``read_file(saved_to, grep='...')`` or ``tail``; do not re-run the command\njust to see more.\n\n``strict=true`` runs the command under ``set -euo pipefail``: a failing pipeline stage, command or unset variable fails it.\n\n``on_timeout=\"detach_and_wake\"`` (ignored with ``background=true``) runs the command as a background job and waits for it up to ``timeout_sec``: if it ends in time you get the normal result (stdout and stderr merged, ``merged_output: true``); otherwise it is NOT killed, the result has ``detached: true`` and a ``job_id``, and you are woken when it exits. The default ``\"kill\"`` stops the command at the timeout.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "cwd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "timeout_sec": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "stdin": {
            "default": "",
            "type": "string"
          },
          "stdin_b64": {
            "default": "",
            "type": "string"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "type": "object"
          },
          "save_stdout": {
            "default": "",
            "type": "string"
          },
          "background": {
            "default": false,
            "type": "boolean"
          },
          "strict": {
            "default": false,
            "type": "boolean"
          },
          "on_timeout": {
            "default": "kill",
            "description": "kill (default): stop the command at timeout_sec. detach_and_wake: run it as a background job; if it outlives timeout_sec it keeps running and wakes you when it exits.",
            "enum": [
              "kill",
              "detach_and_wake"
            ],
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "description": "Result of execute_shell.",
                "properties": {
                  "ok": {
                    "default": true,
                    "type": "boolean"
                  },
                  "cmd": {
                    "description": "The shell command that was executed (passed to `bash -c`).",
                    "type": "string"
                  },
                  "cwd": {
                    "description": "Working directory used (container path).",
                    "type": "string"
                  },
                  "returncode": {
                    "description": "Process exit code (0 = success, 124 = timeout).",
                    "type": "integer"
                  },
                  "stdout": {
                    "description": "Captured stdout, truncated to max_output.",
                    "type": "string"
                  },
                  "stderr": {
                    "description": "Captured stderr, truncated to max_output.",
                    "type": "string"
                  },
                  "truncated": {
                    "default": false,
                    "description": "True iff stdout OR stderr was truncated.",
                    "type": "boolean"
                  },
                  "duration_ms": {
                    "description": "Wall-clock duration in milliseconds.",
                    "type": "integer"
                  },
