  "outils": [
    {
      "name": "skill_save",
      "title": "Skill Save",
      "description": "Save a reusable procedure as a PERSONAL skill for future reuse.\n\nWHEN: you just worked out HOW to accomplish a non-trivial, generalizable\nprocedure on some software (deploy, reset, build, configure \u2026) that is likely\nto come up again. NOT for one-off answers, facts, or trivial single commands.\n\nThe skill is saved to YOUR protected personal skill store \u2014 host-side,\nOUTSIDE the /work sandbox (any ``skills/`` folder visible in the sandbox is\nonly a disposable mirror) \u2014 and becomes routable for YOUR future sessions\nonly: next time a similar request arrives, the backend injects this procedure\nautomatically. It is NOT shared with other users (an agent saving a skill\nmust not be able to inject content into someone else's prompt \u2014 see audit\nCRIT-1). An admin can later promote a personal skill to the curated, shared\nlibrary from the skills admin UI.\n\nExample:\n    skill_save(\n        name=\"reset-qdrant\",\n        description=\"R\u00e9initialiser la base vectorielle Qdrant \u00e0 z\u00e9ro\",\n        body=\"## \u00c9tapes\\n1. Arr\u00eater le service\u2026\\n2. \u2026\",\n        tags=[\"qdrant\", \"vectordb\", \"reset\"])\n\nA personal skill may override a curated one of the same name (user > global).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Short kebab-case identifier, e.g. 'deploy-jenkins'. Slugified for the filename.",
            "type": "string"
          },
          "description": {
            "description": "One keyword-rich sentence \u2014 this is what the router matches future requests against. Be specific.",
            "type": "string"
          },
          "body": {
            "description": "The procedure itself, in markdown. Concrete steps, exact commands, real paths. Self-contained.",
            "type": "string"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional extra keywords for matching (e.g. ['jenkins', 'ci', 'deploy'])."
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional applicative domain \u2014 files the skill under skills/learned/<domain>/ (e.g. 'jenkins', 'qdrant'). Mirrors how curated skills are grouped by app."
          }
        },
        "required": [
          "name",
          "description",
          "body"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "description": "Result of skill_save \u2014 a PERSONAL skill written to the caller's sandbox.",
                "properties": {
                  "ok": {
                    "const": true,
                    "default": true,
                    "type": "boolean"
                  },
                  "name": {
                    "description": "Slugified skill name (filename stem).",
                    "type": "string"
                  },
                  "path": {
                    "description": "Absolute host path of the saved skill file.",
                    "type": "string"
                  },
                  "source": {
                    "default": "user",
                    "description": "Storage scope of the saved skill \u2014 'user' (personal sandbox) for skill_save.",
                    "enum": [
                      "user",
                      "learned",
                      "global"
                    ],
                    "type": "string"
                  },
                  "domain": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Applicative domain subfolder (e.g. 'jenkins'), '' if at the scope root."
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Echoed description."
                  },
                  "tags": {
                    "anyOf": [
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Echoed tags."
                  },
                  "note": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Human-readable hint (e.g. how to promote)."
                  }
                },
                "required": [
                  "name",
                  "path"
                ],
                "type": "object"
              },
              {
                "additionalProperties": true,
                "description": "Typed shape of the error envelope produced by ``_toolkit.err()``.\n\nMirrors the error contract the chat frontend parses :\n  * ``ok`` is the discriminator (False = failure),\n  * ``error`` is a stable machine code (snake_case),\n  * ``message`` is the human-readable text,\n  * ``fix`` is an optional hint how to recover.\n\nTools declare their return type as ``Union[<SuccessModel>,\nErrEnvelope]`` so FastMCP generates a discriminated union schema\nthe LLM can pattern-match on the ``ok`` field. The runtime\nwire format is unchanged \u2014 both branches serialise to the same\nJSON dict the frontend already reads.\n\n``extra='allow'`` because ``err()`` lets each call site attach\ncontext (``cmd``, ``path``, ``expected``, ``actual``, \u2026) \u2014 these\nare kept for the LLM but aren't part of the strict schema.",
                "properties": {
                  "ok": {
                    "const": false,
                    "default": false,
                    "type": "boolean"
                  },
                  "error": {
                    "description": "Stable machine code (e.g. 'not_found', 'too_large').",
                    "type": "string"
                  },
                  "message": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Human-readable error message."
                  },
                  "fix": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Suggested recovery action."
                  },
                  "next_action": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Concrete next tool/arg to try."
                  },
                  "retryable": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "True iff a retry might succeed (transient error)."
                  }
                },
                "required": [
                  "error"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
